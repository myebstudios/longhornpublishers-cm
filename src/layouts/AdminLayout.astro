---
import '../styles/admin.css';
import AdminIcon from '../components/admin/AdminIcon.astro';
import { adminPages } from '../lib/admin-navigation';
interface Props { title: string; section?: 'dashboard' | 'settings' | 'homepage' | 'about' | 'services' | 'why' | 'catalogue' | 'subjects' | 'news' | 'contact' | 'legal'; }
const { title, section = 'dashboard' } = Astro.props;
const groups = ['Workspace', 'Website', 'Content', 'Settings'];
---
<!doctype html>
<html lang="en">
<head>
 <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
 <title>{title} — Longhorn Admin</title><link rel="icon" href="/favicon.svg" />
 <style is:inline>html[data-auth="pending"] body{visibility:hidden}</style>
 <script is:inline>document.documentElement.setAttribute('data-auth','pending')</script>
</head>
<body class="admin-app">
 <a class="admin-skip" href="#admin-main">Skip to content</a>
 <aside class="sidebar" id="adminSidebar" aria-label="Content workspace">
  <div class="sidebar-brand"><a class="brand" href="/admin/" aria-label="Longhorn Admin Home"><img src="/img/longhorn-logo.png" alt="Longhorn Publishers Cameroon" width="136" height="36" /></a><button class="icon-button" id="sidebarToggle" aria-label="Collapse navigation" type="button"><AdminIcon name="collapse" /></button></div>
  <p class="workspace-label nav-label">Content Administration</p>
  <button class="search-pages" type="button" data-open-search aria-label="Search pages…"><AdminIcon name="search" /><span class="nav-label">Search pages…</span><kbd class="nav-label" aria-hidden="true">⌘ K</kbd></button>
  <nav aria-label="Admin navigation">
   {groups.map(group => <section class="nav-group"><p class="nav-label nav-group-label">{group}</p><ul>{adminPages.filter(p => p.group === group).map(p => <li><a href={p.href} class:list={{active: p.section === section}} aria-current={p.section === section ? 'page' : undefined} title={p.label}><AdminIcon name={p.icon} /><span class="nav-label">{p.label}</span></a></li>)}</ul></section>)}
  </nav>
  <p id="adminNavCue" class="admin-nav-cue" aria-hidden="true"></p>
  <div class="sidebar-foot">
   <div class="account"><span class="avatar" aria-hidden="true">AD</span><span class="nav-label" id="adminUser">Checking session…</span></div>
   <a href="/admin/site-settings/" title="Site settings" class:list={{active: section === 'settings'}} aria-current={section === 'settings' ? 'page' : undefined}><AdminIcon name="settings" /><span class="nav-label">Site settings</span></a>
   <button id="logoutButton" title="Sign out" type="button"><AdminIcon name="log-out" /><span class="nav-label">Sign out</span></button>
   {import.meta.env.DEV && <small class="nav-label">Local development</small>}
  </div>
 </aside>
 <div class="app-main">
  <header class="topbar"><button type="button" class="icon-button mobile-menu" id="menuButton" aria-label="Open menu"><AdminIcon name="menu" /></button><p class="crumb">Content management / {title}</p><a href="/en/" target="_blank" rel="noopener noreferrer" class="view-site-link" aria-label="Open Site (opens in a new tab)"><AdminIcon name="globe" /><span>Open Site</span><AdminIcon name="external-link" /></a></header>
  <main id="admin-main" class="page-content" tabindex="-1">
   <slot />
   <div id="localAdminNotice" class="local-admin-notice" role="status" hidden><AdminIcon name="info" /><div><strong>Local development mode.</strong> Netlify Identity does not run locally; test admin sign-in and protected writes on a Netlify deploy preview. The local database and public CMS APIs remain active.</div><button type="button" class="icon-button" id="dismissDevNotice" aria-label="Dismiss local development notice"><AdminIcon name="close" /></button></div>
  </main>
 </div>
 <dialog id="adminNavDrawer" class="admin-drawer" aria-label="Admin menu"><button class="icon-button" id="closeDrawer" type="button" aria-label="Close menu"><AdminIcon name="close" /></button><div id="drawerContent"></div></dialog>
 <dialog id="adminSearchDialog" class="admin-search-dialog" aria-labelledby="adminSearchTitle"><div class="toolbar"><h2 id="adminSearchTitle">Search admin pages</h2><button class="icon-button" type="button" id="closeSearch" aria-label="Close search"><AdminIcon name="close" /></button></div><label for="adminPageQuery">Search pages</label><input id="adminPageQuery" type="search" autocomplete="off" placeholder="Type a page name or section…" /><div id="adminSearchResults" aria-live="polite"></div></dialog>
  <script>
    import { getUser, logout } from '@netlify/identity';
    const target = document.querySelector('#adminUser');
    const release = () => document.documentElement.removeAttribute('data-auth');
    if (import.meta.env.DEV) {
      if (target) target.textContent = 'Local Identity unavailable';
      try { if (!sessionStorage.getItem('lh-admin-dev-notice-dismissed')) document.querySelector('#localAdminNotice')?.removeAttribute('hidden'); } catch { document.querySelector('#localAdminNotice')?.removeAttribute('hidden'); }
      release();
    } else {
      try {
        const user = await getUser();
        if (!user?.roles?.includes('admin')) {
          window.location.replace('/admin/login/');
        } else {
          if (target) target.textContent = user.email ?? 'Administrator';
          release();
        }
      } catch {
        if (target) target.textContent = 'Session unavailable';
        release();
      }
    }
    document.querySelector('#logoutButton')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      button.disabled = true; button.textContent = 'Signing out…';
      try { await logout(); } finally { window.location.replace('/admin/login/'); }
    });
  </script>


 <script>
  import '../lib/admin-shell';
  import '../lib/admin-presentation';
 </script>
</body>
</html>
