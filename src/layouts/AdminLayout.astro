---
interface Props { title: string; section?: 'dashboard' | 'catalogue' | 'subjects' | 'news'; }
const { title, section = 'dashboard' } = Astro.props;
const items = [
  ['dashboard', 'Overview', '/admin/', '◈'],
  ['catalogue', 'Catalogue', '/admin/catalogue/', '▤'],
  ['subjects', 'Subjects', '/admin/subjects/', '❖'],
  ['news', 'News & updates', '/admin/news/', '✦'],
] as const;
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{title} — Longhorn Admin</title><link rel="icon" href="/favicon.svg" />
<!-- Auth gate (Docs/ui_ux_audit.md §12): the role check below is async, so without
     this the full admin chrome paints before an unauthenticated visitor is
     redirected. The attribute is set from script rather than authored on <html>
     so that a JS-disabled browser is not left with a permanently blank page —
     /admin/* is already gated server-side by the Role condition in netlify.toml. -->
<style is:inline>html[data-auth="pending"] body{visibility:hidden}</style>
<script is:inline>document.documentElement.setAttribute('data-auth','pending')</script>
</head>
<body><aside class="sidebar"><a class="brand" href="/admin/"><span class="brand-mark">L</span><span>LONGHORN<small>Publishers Cameroon</small></span></a><p class="workspace-label">Content workspace</p><nav aria-label="Admin navigation">{items.map(([id, label, href, icon]) => <a class:list={{ active: section === id }} href={href}><span aria-hidden="true">{icon}</span>{label}</a>)}</nav><div class="sidebar-foot"><span class="secure-dot"></span>Admin-only area</div></aside><main class="app-main"><header class="topbar"><div><p class="eyebrow">Longhorn Publishers Cameroon</p><p class="crumb">Content management / {title}</p></div><div class="user-chip"><span class="avatar">LP</span><span id="adminUser">Checking session…</span></div></header><div class="page-content"><slot /></div></main>
<script>
  import { getUser } from '@netlify/identity';
  const target = document.querySelector('#adminUser');
  // Keep the page hidden until we know the visitor is an admin. Releasing the
  // gate only on the authorised path means a redirect never flashes content.
  const release = () => document.documentElement.removeAttribute('data-auth');
  try {
    const user = await getUser();
    if (!user?.roles?.includes('admin')) {
      window.location.replace('/admin/login/');
    } else {
      if (target) target.textContent = user.email ?? 'Administrator';
      release();
    }
  } catch {
    // Session lookup failed (offline, Identity unreachable). Show the page
    // rather than trapping the user behind a blank screen; the API calls this
    // page makes are authorised server-side and will surface their own errors.
    if (target) target.textContent = 'Session unavailable';
    release();
  }
</script>
<style is:global>
:root {
  --burgundy: #5C1A2B;
  --burgundy-deep: #3B0F1B;
  --burgundy-soft: #7A2C3F;
  --green: #6FBF3F;
  --green-deep: #2F7A2A;
  --green-pale: #EAF7E2;
  --mustard: #E9A63B;
  --cream: #FBF6EE;
  --cream-deep: #F3EADD;
  --ink: #1A1216;
  --ink-soft: #5A4C52;
  --muted: #5A4C52;
  --wine: var(--burgundy);
  --wine-dark: var(--burgundy-deep);
  --gold: var(--green);
  --paper: #FFFFFF;
  --line: rgba(26, 18, 22, .12);
  --soft: var(--cream-deep);
  --danger: #B3261E;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--cream); color: var(--ink); font: 15px/1.5 Inter, ui-sans-serif, system-ui, sans-serif; }
.sidebar {
  position: fixed; inset: 0 auto 0 0; width: 258px;
  background: linear-gradient(160deg, var(--burgundy-deep), var(--burgundy) 62%, var(--burgundy-soft));
  color: #fff; padding: 28px 18px; display: flex; flex-direction: column; z-index: 2;
}
.brand { display: flex; align-items: center; gap: 11px; color: #fff; text-decoration: none; font: 700 14px/1.05 Poppins, system-ui; letter-spacing: .08em; }
.brand small { display: block; margin-top: 5px; font: 500 10px/1 Inter, system-ui; letter-spacing: .04em; color: #efced8; }
.brand-mark { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 12px; color: var(--burgundy-deep); background: var(--green); font: 700 21px Georgia; }
.workspace-label { margin: 42px 10px 10px; color: #e9bdcc; font-size: 10px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
.sidebar nav { display: grid; gap: 5px; }
.sidebar nav a { display: flex; gap: 12px; align-items: center; padding: 11px 12px; border-radius: 10px; color: #f4dce3; text-decoration: none; font-weight: 650; transition: .2s; }
.sidebar nav a span { width: 20px; text-align: center; color: #e9bdcc; }
.sidebar nav a:hover, .sidebar nav a.active { background: #ffffff19; color: #fff; }
.sidebar nav a.active { box-shadow: inset 3px 0 var(--green); }
.sidebar-foot { margin-top: auto; border-top: 1px solid #ffffff26; padding: 18px 10px 0; color: #e9bdcc; font-size: 12px; }
.secure-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--green); margin-right: 7px; }
.app-main { margin-left: 258px; min-height: 100vh; }
.topbar { min-height: 89px; padding: 17px clamp(24px, 5vw, 68px); display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); background: #ffffffb8; backdrop-filter: blur(10px); }
.eyebrow { margin: 0; color: var(--burgundy); font-size: 10px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
.crumb { margin: 3px 0 0; color: var(--muted); font-size: 13px; }
.user-chip { display: flex; align-items: center; gap: 9px; border: 1px solid var(--line); background: #fff; padding: 6px 11px 6px 6px; border-radius: 999px; color: #4d5361; font-size: 13px; max-width: 290px; }
.avatar { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--green-pale); color: var(--burgundy-deep); font-size: 10px; font-weight: 800; }
.page-content { max-width: 1380px; padding: 48px clamp(24px, 5vw, 68px) 72px; }
.page-content > h1 { font: 700 clamp(30px, 4vw, 44px)/1.08 Poppins, system-ui; margin: 0; color: var(--ink); letter-spacing: -.04em; }
.page-content > h1 + p { max-width: 650px; margin: 10px 0 32px; color: var(--muted); font-size: 16px; }
.card { background: var(--paper); border: 1px solid var(--line); border-radius: 18px; padding: 26px; box-shadow: 0 8px 28px #3c29310a; margin-top: 20px; }
.card h2 { margin: 0; color: var(--ink); font: 700 19px/1.25 Poppins, system-ui; letter-spacing: -.02em; }
.card h2 + p { color: var(--muted); margin: 6px 0 0; }
.button { border: 0; border-radius: 9px; background: var(--burgundy); color: #fff; padding: 11px 16px; font: 700 13px Inter, system-ui; cursor: pointer; box-shadow: 0 5px 12px rgba(92, 26, 43, 0.18); }
.button:hover { background: var(--burgundy-soft); }
.button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible, a:focus-visible { outline: 3px solid var(--green-deep); outline-offset: 2px; }
#status { font-weight: 650; }
#status.status--ok { color: var(--green-deep); }
#status.status--err { color: var(--danger); }
#status.status--ok::before { content: '\2713\00a0\00a0'; }
#status.status--err::before { content: '\26A0\00a0\00a0'; }
.items { margin-top: 10px; }
@media (max-width: 860px) {
  .sidebar { position: static; width: auto; height: auto; padding: 16px 20px; display: block; }
  .workspace-label, .sidebar-foot { display: none; }
  .sidebar nav { display: flex; gap: 7px; overflow: auto; margin-top: 17px; }
  .sidebar nav a { white-space: nowrap; padding: 8px 11px; }
  .app-main { margin-left: 0; }
  .topbar { min-height: 72px; padding: 12px 20px; }
  .user-chip { max-width: 150px; }
  .user-chip #adminUser { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .page-content { padding: 32px 20px 50px; }
  .card { padding: 20px; border-radius: 14px; }
}
</style></body></html>
