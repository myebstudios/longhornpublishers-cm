---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale, RouteKey } from '../i18n';
import { useTranslations, path } from '../i18n';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** null for pages that belong to no localized route (e.g. 404) — skips canonical/hreflang and marks noindex. */
  routeKey: RouteKey | null;
}

const { title, description, locale, routeKey } = Astro.props;
const t = useTranslations(locale);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': new URL('/#organization', Astro.site).href,
      name: 'Longhorn Publishers Cameroon Ltd',
      url: Astro.site?.href,
      logo: new URL('/favicon.svg', Astro.site).href,
      parentOrganization: { '@type': 'Organization', name: 'Longhorn Publishers PLC' },
    },
    {
      '@type': 'ProfessionalService',
      '@id': new URL('/#local-business', Astro.site).href,
      name: 'Longhorn Publishers Cameroon Ltd',
      url: Astro.site?.href,
      telephone: ['+237 672 49 10 93', '+237 657 51 92 03'],
      email: 'info@longhornpublishers-cm.com',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Total École de police, Tsinga',
        addressLocality: 'Yaoundé',
        addressCountry: 'CM',
      },
      areaServed: ['Cameroon', 'Democratic Republic of the Congo'],
      makesOffer: ['Editing', 'Proofreading', 'Translation', 'Designing', 'Illustration', 'Printing'].map((name) => ({
        '@type': 'Offer', itemOffered: { '@type': 'Service', name },
      })),
    },
  ],
};
---

<!DOCTYPE html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {routeKey ? (
      <Fragment>
        <link rel="canonical" href={new URL(path(routeKey, locale), Astro.site)} />
        <link rel="alternate" hreflang="en" href={new URL(path(routeKey, 'en'), Astro.site)} />
        <link rel="alternate" hreflang="fr" href={new URL(path(routeKey, 'fr'), Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(path(routeKey, 'en'), Astro.site)} />
      </Fragment>
    ) : (
      <meta name="robots" content="noindex" />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script>
      const authHash = window.location.hash;
      if (/(?:^#|&)invite_token=/.test(authHash) || /(?:^#|&)recovery_token=/.test(authHash)) {
        window.location.replace(`/admin/login/${authHash}`);
      }
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Inter:wght@400;500;600&family=Fraunces:ital,opsz,wght@1,9..144,300;1,9..144,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t.nav.skip}</a>

    <Header locale={locale} currentRouteKey={routeKey} />

    <main id="main-content">
      <slot />
    </main>

    <Footer locale={locale} />

    <script>
      function initHeader() {
        const header = document.getElementById('siteHeader');
        const toggle = document.getElementById('navToggle');
        const nav = document.getElementById('primaryNav');

        if (header) {
          const onScroll = () => header.classList.toggle('is-solid', window.scrollY > 24);
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        }

        if (toggle && nav) {
          const navLinks = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a'));
          const closeNav = (restoreFocus = false) => {
            toggle.setAttribute('aria-expanded', 'false');
            nav.classList.remove('is-open');
            if (restoreFocus) toggle.focus();
          };

          toggle.addEventListener('click', () => {
            const open = toggle.getAttribute('aria-expanded') === 'true';
            if (open) {
              closeNav();
            } else {
              toggle.setAttribute('aria-expanded', 'true');
              nav.classList.add('is-open');
              navLinks[0]?.focus();
            }
          });

          navLinks.forEach(link => link.addEventListener('click', () => closeNav()));
          document.addEventListener('keydown', event => {
            if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
              closeNav(true);
            }
          });
        }
      }

      function initReveal() {
        const items = document.querySelectorAll('.reveal');
        // Content is visible without JavaScript. Only opt into the initial
        // hidden state once the enhancement has successfully started.
        if (!items.length) return;
        document.documentElement.classList.add('has-reveal');
        if (!('IntersectionObserver' in window)) {
          items.forEach(i => i.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -60px' });
        items.forEach(i => io.observe(i));
      }

      function initCarousels() {
        document.querySelectorAll('.carousel').forEach(car => {
          const view = car.querySelector('.carousel__viewport');
          const prev = car.querySelector('[data-dir="prev"]') as HTMLButtonElement | null;
          const next = car.querySelector('[data-dir="next"]') as HTMLButtonElement | null;
          if (!view || !prev || !next) return;

          const step = () => {
            const first = view.querySelector('.carousel__track > *');
            return first ? first.getBoundingClientRect().width + 24 : view.clientWidth * 0.8;
          };
          const sync = () => {
            const max = view.scrollWidth - view.clientWidth - 2;
            prev.disabled = view.scrollLeft <= 2;
            next.disabled = view.scrollLeft >= max;
          };
          prev.addEventListener('click', () => view.scrollBy({ left: -step(), behavior: 'smooth' }));
          next.addEventListener('click', () => view.scrollBy({ left: step(), behavior: 'smooth' }));
          view.addEventListener('scroll', sync, { passive: true });
          window.addEventListener('resize', sync);
          sync();
        });
      }

      function initFilters() {
        document.querySelectorAll('[data-filter-scope]').forEach(scope => {
          const targets = scope.querySelectorAll('[data-tags]');
          const groups = scope.querySelectorAll('.filter-group');
          const countEl = scope.querySelector('[data-filter-count]');

          const apply = () => {
            const active: string[] = [];
            groups.forEach(g => {
              const on = g.querySelector('.chip.is-active') as HTMLElement | null;
              if (on && on.dataset.value && on.dataset.value !== 'all') {
                active.push(on.dataset.value);
              }
            });
            let shown = 0;
            targets.forEach(t => {
              const el = t as HTMLElement;
              const tags = (el.dataset.tags || '').split(' ');
              const match = active.every(a => tags.includes(a));
              el.classList.toggle('is-hidden', !match);
              if (match) shown++;
            });
            if (countEl) countEl.textContent = String(shown);
          };

          scope.querySelectorAll('.chip').forEach(chip => {
            chip.addEventListener('click', () => {
              const parent = chip.closest('.filter-group');
              if (parent) {
                parent.querySelectorAll('.chip').forEach(c => c.classList.remove('is-active'));
              }
              chip.classList.add('is-active');
              apply();
            });
          });
          apply();
        });
      }

      function initNetlifyForms() {
        const requestedTitle = new URLSearchParams(window.location.search).get('title');
        if (requestedTitle) {
          const message = document.querySelector<HTMLTextAreaElement>('form[name="contact"] textarea[name="message"]');
          if (message && !message.value) {
            message.value = document.documentElement.lang === 'fr'
              ? `Je souhaite en savoir plus sur le titre : ${requestedTitle}.`
              : `I would like to know more about this title: ${requestedTitle}.`;
          }
        }

        document.querySelectorAll('form[data-netlify="true"]').forEach(form => {
          form.addEventListener('submit', async event => {
            event.preventDefault();
            const htmlForm = form as HTMLFormElement;
            const status = htmlForm.querySelector('.form__status');
            const submit = htmlForm.querySelector('[type="submit"]') as HTMLButtonElement | null;
            if (submit) submit.disabled = true;
            try {
              const response = await fetch('/__forms.html', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams(new FormData(htmlForm) as unknown as Record<string, string>).toString(),
              });
              if (!response.ok) throw new Error('Submission failed');
              htmlForm.reset();
              if (status) {
                status.textContent = htmlForm.dataset.success
                  ?? (document.documentElement.lang === 'fr'
                    ? 'Merci — votre message a bien été envoyé.'
                    : 'Thank you — your message has been sent.');
                status.className = 'form__status form__status--ok';
              }
            } catch {
              if (status) {
                status.textContent = htmlForm.dataset.error
                  ?? (document.documentElement.lang === 'fr'
                    ? 'Échec de l’envoi. Veuillez réessayer.'
                    : 'Submission failed. Please try again.');
                status.className = 'form__status form__status--err';
              }
            } finally {
              if (submit) submit.disabled = false;
            }
          });
        });
      }

      document.addEventListener('DOMContentLoaded', () => {
        initHeader();
        initReveal();
        initCarousels();
        initFilters();
        initNetlifyForms();
      });
    </script>
  </body>
</html>
