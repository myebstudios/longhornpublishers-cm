---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale, RouteKey } from '../i18n';
import { useTranslations, path } from '../i18n';
import { OG_HEIGHT, OG_WIDTH, ogImagePath } from '../lib/images';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  routeKey: RouteKey | null;
  alternates?: Record<Locale, string>;
  image?: string;
  type?: 'website' | 'article';
}

const { title, description, locale, routeKey, alternates, image, type } = Astro.props;
const localePath = (target: Locale) =>
  alternates?.[target] ?? (routeKey ? path(routeKey, target) : '/');
const t = useTranslations(locale);
const canonicalUrl = new URL(localePath(locale), Astro.site);
const ogImageUrl = new URL(ogImagePath(image ?? 'lh-share-card.jpg'), Astro.site).href;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': new URL('/#organization', Astro.site).href,
      name: 'Longhorn Publishers Cameroon Ltd',
      url: Astro.site?.href,
      logo: new URL('/favicon.svg', Astro.site).href,
      parentOrganization: { '@type': 'Organization', name: 'Longhorn Publishers PLC' },
    },
    {
      '@type': 'ProfessionalService',
      '@id': new URL('/#local-business', Astro.site).href,
      name: 'Longhorn Publishers Cameroon Ltd',
      url: Astro.site?.href,
      telephone: ['+237 672 49 10 93', '+237 657 51 92 03'],
      email: 'longhorncameroon@longhornpublishers.com',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Total École de police, Tsinga',
        addressLocality: 'Yaoundé',
        addressCountry: 'CM',
      },
      areaServed: ['Cameroon', 'Democratic Republic of the Congo'],
      makesOffer: ['Editing', 'Proofreading', 'Translation', 'Designing', 'Illustration', 'Printing'].map((name) => ({
        '@type': 'Offer', itemOffered: { '@type': 'Service', name },
      })),
    },
  ],
};
---

<!DOCTYPE html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5C1A2B" />
    {routeKey ? (
      <Fragment>
        <link rel="canonical" href={canonicalUrl} />
        <link rel="alternate" hreflang="en" href={new URL(localePath('en'), Astro.site)} />
        <link rel="alternate" hreflang="fr" href={new URL(localePath('fr'), Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(localePath('en'), Astro.site)} />
      </Fragment>
    ) : (
      <meta name="robots" content="noindex" />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script>
      const authHash = window.location.hash;
      if (/(?:^#|&)invite_token=/.test(authHash) || /(?:^#|&)recovery_token=/.test(authHash)) {
        window.location.replace(`/admin/login/${authHash}`);
      }
    </script>

    <!-- Localized Open Graph / Social Sharing -->
    <meta property="og:site_name" content="Longhorn Publishers Cameroon" />
    <meta property="og:type" content={type || 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {routeKey && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:locale" content={locale === 'fr' ? 'fr_CM' : 'en_CM'} />
    {routeKey && <meta property="og:locale:alternate" content={locale === 'fr' ? 'en_CM' : 'fr_CM'} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={description} />

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={description} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Inter:wght@400;500;600&family=Fraunces:ital,opsz,wght@1,9..144,300;1,9..144,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t.nav.skip}</a>

    <Header locale={locale} currentRouteKey={routeKey} alternates={alternates} />

    <main id="main-content">
      <slot />
    </main>

    <Footer locale={locale} />

    <script>
      function initHeader() {
        const header = document.getElementById('siteHeader');
        const toggle = document.getElementById('navToggle');
        const nav = document.getElementById('primaryNav');

        if (header) {
          const onScroll = () => header.classList.toggle('is-solid', window.scrollY > 24);
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        }

        if (toggle && nav) {
          const backdrop = document.getElementById('navBackdrop');
          const navLinks = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a'));
          const closeNav = (restoreFocus = false) => {
            toggle.setAttribute('aria-expanded', 'false');
            nav.classList.remove('is-open');
            document.body.classList.remove('nav-open');
            if (restoreFocus) toggle.focus();
          };

          const openNav = () => {
            toggle.setAttribute('aria-expanded', 'true');
            nav.classList.add('is-open');
            document.body.classList.add('nav-open');
            navLinks[0]?.focus();
          };

          toggle.addEventListener('click', () => {
            const open = toggle.getAttribute('aria-expanded') === 'true';
            if (open) {
              closeNav();
            } else {
              openNav();
            }
          });

          if (backdrop) {
            backdrop.addEventListener('click', () => closeNav());
          }

          navLinks.forEach(link => link.addEventListener('click', () => closeNav()));

          document.addEventListener('keydown', event => {
            if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
              closeNav(true);
            }
          });

          document.addEventListener('click', event => {
            if (toggle.getAttribute('aria-expanded') === 'true') {
              const target = event.target as Node;
              if (header && !header.contains(target)) {
                closeNav();
              }
            }
          });

          const mq = window.matchMedia('(min-width: 1081px)');
          const handleBreakpoint = (e: MediaQueryListEvent | MediaQueryList) => {
            if (e.matches && toggle.getAttribute('aria-expanded') === 'true') {
              closeNav();
            }
          };
          mq.addEventListener('change', handleBreakpoint);
        }
      }

      function initReveal() {
        const items = document.querySelectorAll('.reveal');
        // Content is visible without JavaScript. Only opt into the initial
        // hidden state once the enhancement has successfully started.
        if (!items.length) return;
        document.documentElement.classList.add('has-reveal');
        if (!('IntersectionObserver' in window)) {
          items.forEach(i => i.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -60px' });
        items.forEach(i => io.observe(i));
      }

      function initCarousels() {
        document.querySelectorAll('.carousel').forEach(car => {
          const view = car.querySelector('.carousel__viewport') as HTMLElement | null;
          const prev = car.querySelector('[data-dir="prev"]') as HTMLButtonElement | null;
          const next = car.querySelector('[data-dir="next"]') as HTMLButtonElement | null;
          if (!view || !prev || !next) return;

          const step = () => {
            const first = view.querySelector('.carousel__track > *');
            return first ? first.getBoundingClientRect().width + 24 : view.clientWidth * 0.8;
          };

          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const getBehavior = (): ScrollBehavior => (prefersReducedMotion ? 'auto' : 'smooth');

          const sync = () => {
            const max = view.scrollWidth - view.clientWidth - 4;
            const atStart = view.scrollLeft <= 2;
            const atEnd = view.scrollLeft >= max;
            prev.setAttribute('aria-disabled', String(atStart));
            next.setAttribute('aria-disabled', String(atEnd));
          };

          let autoSlideTimer: ReturnType<typeof setInterval> | null = null;
          let isInteracting = false;
          let resumeTimeout: ReturnType<typeof setTimeout> | null = null;

          const startAutoSlide = () => {
            if (autoSlideTimer || prefersReducedMotion) return;
            autoSlideTimer = setInterval(() => {
              if (isInteracting || document.hidden) return;
              const max = view.scrollWidth - view.clientWidth - 4;
              const atEnd = view.scrollLeft >= max;
              if (atEnd) {
                view.scrollTo({ left: 0, behavior: getBehavior() });
              } else {
                view.scrollBy({ left: step(), behavior: getBehavior() });
              }
            }, 4500);
          };

          const stopAutoSlide = () => {
            if (autoSlideTimer) {
              clearInterval(autoSlideTimer);
              autoSlideTimer = null;
            }
          };

          const pauseInteraction = () => {
            isInteracting = true;
            if (resumeTimeout) clearTimeout(resumeTimeout);
            stopAutoSlide();
          };

          const resumeInteraction = () => {
            isInteracting = false;
            startAutoSlide();
          };

          const delayedResume = () => {
            isInteracting = false;
            if (resumeTimeout) clearTimeout(resumeTimeout);
            resumeTimeout = setTimeout(() => {
              startAutoSlide();
            }, 3000);
          };

          prev.addEventListener('click', () => {
            pauseInteraction();
            if (prev.getAttribute('aria-disabled') === 'true') {
              delayedResume();
              return;
            }
            view.scrollBy({ left: -step(), behavior: getBehavior() });
            delayedResume();
          });

          next.addEventListener('click', () => {
            pauseInteraction();
            if (next.getAttribute('aria-disabled') === 'true') {
              delayedResume();
              return;
            }
            view.scrollBy({ left: step(), behavior: getBehavior() });
            delayedResume();
          });

          car.addEventListener('mouseenter', pauseInteraction);
          car.addEventListener('mouseleave', resumeInteraction);
          car.addEventListener('focusin', pauseInteraction);
          car.addEventListener('focusout', resumeInteraction);
          car.addEventListener('pointerdown', pauseInteraction);
          car.addEventListener('pointerup', delayedResume);
          car.addEventListener('touchstart', pauseInteraction, { passive: true });
          car.addEventListener('touchend', delayedResume);

          document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
              stopAutoSlide();
            } else if (!isInteracting) {
              startAutoSlide();
            }
          });

          view.addEventListener('keydown', (event: KeyboardEvent) => {
            if (event.key === 'ArrowLeft') {
              event.preventDefault();
              pauseInteraction();
              if (prev.getAttribute('aria-disabled') !== 'true') {
                view.scrollBy({ left: -step(), behavior: getBehavior() });
              }
              delayedResume();
            } else if (event.key === 'ArrowRight') {
              event.preventDefault();
              pauseInteraction();
              if (next.getAttribute('aria-disabled') !== 'true') {
                view.scrollBy({ left: step(), behavior: getBehavior() });
              }
              delayedResume();
            }
          });

          view.addEventListener('scroll', sync, { passive: true });
          window.addEventListener('resize', sync);
          sync();

          startAutoSlide();
        });
      }

      function initFilters() {
        document.querySelectorAll('[data-filter-scope]').forEach(scope => {
          const targets = scope.querySelectorAll('[data-tags]');
          const groups = scope.querySelectorAll('.filter-group');
          const countEl = scope.querySelector('[data-filter-count]');
          const emptyStateEl = scope.querySelector('[data-filter-empty]') as HTMLElement | null;
          const resetBtn = scope.querySelector('[data-filter-reset]') as HTMLButtonElement | null;

          const apply = () => {
            const active: string[] = [];
            groups.forEach(g => {
              const on = g.querySelector('.chip.is-active') as HTMLElement | null;
              if (on && on.dataset.value && on.dataset.value !== 'all') {
                active.push(on.dataset.value);
              }
            });
            let shown = 0;
            targets.forEach(t => {
              const el = t as HTMLElement;
              const tags = (el.dataset.tags || '').split(' ');
              const match = active.every(a => tags.includes(a));
              el.classList.toggle('is-hidden', !match);
              if (match) {
                el.removeAttribute('hidden');
                el.setAttribute('aria-hidden', 'false');
                shown++;
              } else {
                el.setAttribute('hidden', '');
                el.setAttribute('aria-hidden', 'true');
              }
            });
            if (countEl) countEl.textContent = String(shown);
            if (emptyStateEl) {
              const isZero = shown === 0;
              emptyStateEl.classList.toggle('is-hidden', !isZero);
              if (isZero) {
                emptyStateEl.removeAttribute('hidden');
                emptyStateEl.setAttribute('aria-hidden', 'false');
              } else {
                emptyStateEl.setAttribute('hidden', '');
                emptyStateEl.setAttribute('aria-hidden', 'true');
              }
            }
          };

          const selectChip = (chip: HTMLButtonElement) => {
            const parent = chip.closest('.filter-group');
            if (parent) {
              parent.querySelectorAll<HTMLButtonElement>('.chip').forEach(c => {
                c.classList.remove('is-active');
                c.setAttribute('aria-checked', 'false');
                c.setAttribute('aria-pressed', 'false');
                c.setAttribute('tabindex', '-1');
              });
            }
            chip.classList.add('is-active');
            chip.setAttribute('aria-checked', 'true');
            chip.setAttribute('aria-pressed', 'true');
            chip.setAttribute('tabindex', '0');
            apply();
          };

          groups.forEach(group => {
            const chips = Array.from(group.querySelectorAll<HTMLButtonElement>('.chip'));
            chips.forEach((chip) => {
              chip.addEventListener('click', () => selectChip(chip));
            });

            group.addEventListener('keydown', (event: Event) => {
              const e = event as KeyboardEvent;
              if (['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp'].includes(e.key)) {
                const currentFocus = document.activeElement as HTMLButtonElement | null;
                if (!currentFocus || !chips.includes(currentFocus)) return;
                e.preventDefault();
                const index = chips.indexOf(currentFocus);
                let nextIndex = index;
                if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
                  nextIndex = (index + 1) % chips.length;
                } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
                  nextIndex = (index - 1 + chips.length) % chips.length;
                }
                const nextChip = chips[nextIndex];
                nextChip.focus();
                selectChip(nextChip);
              }
            });
          });

          if (resetBtn) {
            resetBtn.addEventListener('click', () => {
              groups.forEach(group => {
                const allChip = group.querySelector<HTMLButtonElement>('.chip[data-value="all"]');
                if (allChip) selectChip(allChip);
              });
            });
          }

          apply();
        });
      }

      function initCoverTilt() {
        const canTilt = window.matchMedia('(hover: hover) and (pointer: fine)').matches
          && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!canTilt) return;

        document.querySelectorAll<HTMLElement>('[data-cover-tilt]').forEach(card => {
          let frame: number | null = null;
          let pointerX = 0;
          let pointerY = 0;

          const updateTilt = () => {
            frame = null;
            const rect = card.getBoundingClientRect();
            const x = Math.max(0, Math.min(1, (pointerX - rect.left) / rect.width));
            const y = Math.max(0, Math.min(1, (pointerY - rect.top) / rect.height));
            card.style.setProperty('--cover-rotate-x', `${(0.5 - y) * 8}deg`);
            card.style.setProperty('--cover-rotate-y', `${(x - 0.5) * 10}deg`);
          };

          const resetTilt = () => {
            if (frame !== null) cancelAnimationFrame(frame);
            frame = null;
            card.classList.remove('is-tilting');
            card.style.removeProperty('--cover-rotate-x');
            card.style.removeProperty('--cover-rotate-y');
          };

          card.addEventListener('pointermove', event => {
            if (event.pointerType !== 'mouse') return;
            pointerX = event.clientX;
            pointerY = event.clientY;
            card.classList.add('is-tilting');
            if (frame === null) frame = requestAnimationFrame(updateTilt);
          });
          card.addEventListener('pointerleave', resetTilt);
        });
      }

      function initNetlifyForms() {
        const requestedTitle = new URLSearchParams(window.location.search).get('title');
        if (requestedTitle) {
          const message = document.querySelector<HTMLTextAreaElement>('form[name="contact"] textarea[name="message"]');
          if (message && !message.value) {
            message.value = document.documentElement.lang === 'fr'
              ? `Je souhaite en savoir plus sur le titre : ${requestedTitle}.`
              : `I would like to know more about this title: ${requestedTitle}.`;
          }
        }

        document.querySelectorAll('form[data-netlify="true"]').forEach(form => {
          form.addEventListener('submit', async event => {
            event.preventDefault();
            const htmlForm = form as HTMLFormElement;
            const status = htmlForm.querySelector('.form__status');
            const submit = htmlForm.querySelector('[type="submit"]') as HTMLButtonElement | null;
            if (submit) submit.disabled = true;
            try {
              const response = await fetch('/__forms.html', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams(new FormData(htmlForm) as unknown as Record<string, string>).toString(),
              });
              if (!response.ok) throw new Error('Submission failed');
              htmlForm.reset();
              if (status) {
                status.textContent = htmlForm.dataset.success
                  ?? (document.documentElement.lang === 'fr'
                    ? 'Merci — votre message a bien été envoyé.'
                    : 'Thank you — your message has been sent.');
                status.className = 'form__status form__status--ok';
              }
            } catch {
              if (status) {
                status.textContent = htmlForm.dataset.error
                  ?? (document.documentElement.lang === 'fr'
                    ? 'Échec de l’envoi. Veuillez réessayer.'
                    : 'Submission failed. Please try again.');
                status.className = 'form__status form__status--err';
              }
            } finally {
              if (submit) submit.disabled = false;
            }
          });
        });
      }

      document.addEventListener('DOMContentLoaded', () => {
        initHeader();
        initReveal();
        initCarousels();
        initFilters();
        initCoverTilt();
        initNetlifyForms();
      });
    </script>
  </body>
</html>
