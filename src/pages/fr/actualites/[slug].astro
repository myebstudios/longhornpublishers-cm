---
export const prerender = false;
import NewsArticlePage from '../../../components/pages/NewsArticle.astro';
import { getPublishedNewsDetail } from '../../../lib/news';

/** French articles, under the localized parent segment from ROUTES.news.fr. */


if (!Astro.params.slug) return Astro.rewrite('/404-runtime');
const article = (await getPublishedNewsDetail()).find((row) => row.slug === Astro.params.slug);
if (!article) return Astro.rewrite('/404-runtime');
---
<NewsArticlePage locale="fr" article={article} />
