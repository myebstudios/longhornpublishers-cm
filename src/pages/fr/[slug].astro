---
import Layout from '../../layouts/Layout.astro';
import PrototypePage from '../../components/PrototypePage.astro';
import { ROUTES, useTranslations, type RouteKey } from '../../i18n';
type PageProps = { routeKey: Exclude<RouteKey, 'home'>; file: 'about' | 'services' | 'catalogue' | 'why-choose-us' | 'contact' | 'news' };
export function getStaticPaths() {
  const pages: PageProps[] = [
    { routeKey: 'about', file: 'about' }, { routeKey: 'services', file: 'services' },
    { routeKey: 'catalogue', file: 'catalogue' }, { routeKey: 'why', file: 'why-choose-us' },
    { routeKey: 'contact', file: 'contact' }, { routeKey: 'news', file: 'news' },
  ];
  return pages.map((page) => ({ params: { slug: ROUTES[page.routeKey].fr }, props: page }));
}
const { routeKey, file } = Astro.props as PageProps;
const t = useTranslations('fr'); const meta = t.meta[routeKey];
---
<Layout title={meta.title} description={meta.description} locale="fr" routeKey={routeKey}><PrototypePage file={file} locale="fr" /></Layout>
