---
import About from '../../components/pages/About.astro';
import Services from '../../components/pages/Services.astro';
import Catalogue from '../../components/pages/Catalogue.astro';
import Why from '../../components/pages/Why.astro';
import Contact from '../../components/pages/Contact.astro';
import News from '../../components/pages/News.astro';
import { ROUTES, type RouteKey } from '../../i18n';

/**
 * French pages live at localized slugs (/fr/a-propos/, /fr/services-edition/ ...),
 * so they cannot share the [lang] route. They render the identical page
 * components as the English routes — only the locale prop differs.
 */
type PageKey = Exclude<RouteKey, 'home'>;

export function getStaticPaths() {
  const keys: PageKey[] = ['about', 'services', 'catalogue', 'why', 'contact', 'news'];
  return keys.map((routeKey) => ({ params: { slug: ROUTES[routeKey].fr }, props: { routeKey } }));
}

const { routeKey } = Astro.props as { routeKey: PageKey };

const PAGES = {
  about: About, services: Services, catalogue: Catalogue,
  why: Why, contact: Contact, news: News,
} as const;

const Page = PAGES[routeKey];
---
<Page locale="fr" />
