---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import AdminSaveBar from '../../components/admin/AdminSaveBar.astro';

import AdminEditorDialog from '../../components/admin/AdminEditorDialog.astro';
---
<AdminLayout title="Site Settings" section="settings">
<AdminPageHeader heading="Site Settings" subtitle="Manage corporate identity, official contact details, footer text, social links, and SEO defaults."></AdminPageHeader>
<section id="adminCanvas" aria-busy="true"><p role="status">Loading saved content…</p></section>
<AdminEditorDialog>
<form hidden id="settingsForm">
      <h2>Identity</h2>
      <div class="two">
        <label>Company name — English<input name="company_name_en" required lang="en" /></label>
        <label>Company name — French<input name="company_name_fr" required lang="fr" /></label>
        <label>Tagline — English<textarea name="tagline_en" lang="en"></textarea></label>
        <label>Tagline — French<textarea name="tagline_fr" lang="fr"></textarea></label>
      </div>

      <h2>Contact</h2>
<label>Office address<textarea name="address"></textarea></label>
      <div class="two">
        <label>Public email<input name="email" type="email" /></label>
        <label>Primary phone<input name="phone_1" /></label>
        <label>Secondary phone<input name="phone_2" /></label>
      </div>

      <h2>Footer and newsletter</h2>
      <div class="two">
        <label>Footer tagline — English<textarea name="footer_tagline_en" lang="en"></textarea></label>
        <label>Footer tagline — French<textarea name="footer_tagline_fr" lang="fr"></textarea></label>
        <label>Newsletter prompt — English<input name="newsletter_copy_en" lang="en" /></label>
        <label>Newsletter prompt — French<input name="newsletter_copy_fr" lang="fr" /></label>
        <label>Parent company URL<input name="parent_company_url" type="url" /></label>
      </div>

      <div class="toolbar"><h2>Social links</h2><button class="button secondary" type="button" id="addSocial">+ Add link</button></div>
      <div id="socialLinks" class="repeat-list"></div>

      <h2>SEO defaults</h2>
      <div class="two">
        <label>Default title<input name="seo_default_title" maxlength="160" /></label>
        <label>Default description<textarea name="seo_default_description" maxlength="320"></textarea></label>
        <label>Open Graph image
          <input name="og_image_id" type="hidden" />
          <input id="ogImageFile" type="file" accept="image/jpeg,image/png,image/webp" />
          <button class="button secondary" type="button" id="ogImageClear">Remove image</button><small>JPEG, PNG or WebP, up to 8 MB.</small><span id="ogImageStatus" role="status" aria-live="polite"></span>
        </label>
        <div class="media-preview"><img id="ogImagePreview" alt="Open Graph preview" hidden /></div>
      </div>

      <AdminSaveBar><button class="button" type="submit">Save site settings</button></AdminSaveBar>
      <p id="status" role="status" aria-live="polite"></p>
    </form>
</AdminEditorDialog>
</AdminLayout>
<script>
import { startAdminV2 } from '../../lib/admin-v2';
void startAdminV2('settings');
</script>
