---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import AdminSaveBar from '../../components/admin/AdminSaveBar.astro';

import AdminEditorDialog from '../../components/admin/AdminEditorDialog.astro';
---
<AdminLayout title="Legal pages" section="legal">
<AdminPageHeader heading="Legal Pages" subtitle="Manage complete bilingual legal texts for Privacy Policy and Terms of Use. Start a line with ## to make a section heading."></AdminPageHeader>
<section id="adminCanvas" aria-busy="true"><p role="status">Loading saved content…</p></section>
<AdminEditorDialog>
<form hidden data-page="privacy_policy"><h2>Privacy Policy</h2><label>Body — English<textarea name="body_en" required lang="en"></textarea></label><label>Body — French<textarea name="body_fr" required lang="fr"></textarea></label><label>Last updated — stated date<input name="content_updated_at" type="date" /><small>Shown on the page as month and year. Set this only when the substance changes; leave it blank to keep the approved wording.</small></label><label class="check"><input name="published" type="checkbox" /> Published — visible on the public site</label><AdminSaveBar><button class="button" type="submit">Save Privacy Policy</button></AdminSaveBar><p data-status role="status" aria-live="polite"></p></form><form hidden data-page="terms_of_use"><h2>Terms of Use</h2><label>Body — English<textarea name="body_en" required lang="en"></textarea></label><label>Body — French<textarea name="body_fr" required lang="fr"></textarea></label><label>Last updated — stated date<input name="content_updated_at" type="date" /><small>Shown on the page as month and year. Set this only when the substance changes; leave it blank to keep the approved wording.</small></label><label class="check"><input name="published" type="checkbox" /> Published — visible on the public site</label><AdminSaveBar><button class="button" type="submit">Save Terms of Use</button></AdminSaveBar><p data-status role="status" aria-live="polite"></p></form>
</AdminEditorDialog>
</AdminLayout>
<script>
import { startAdminV2 } from '../../lib/admin-v2';
void startAdminV2('legal');
</script>
