---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Legal pages" section="legal">
  <div class="admin-page-head"><div><h1>Legal Pages</h1><p>Manage complete bilingual bodies for the Privacy Policy and Terms of Use. Start a line with <code>##</code> to make a section heading.</p></div></div>
  <div class="two legal-editors">
    <section class="card editor-card"><form data-page="privacy_policy"><h2>Privacy Policy</h2><label>Body — English<textarea name="body_en" required></textarea></label><label>Body — French<textarea name="body_fr" required></textarea></label><label>Last updated — stated date<input name="content_updated_at" type="date" /><small>Shown on the page as month and year. Set this only when the substance changes; leave it blank to keep the approved wording.</small></label><label class="check"><input name="published" type="checkbox" /> Published — visible on the public site</label><div class="form-actions"><button class="button" type="submit">Save Privacy Policy</button></div><p data-status role="status" aria-live="polite"></p></form></section>
    <section class="card editor-card"><form data-page="terms_of_use"><h2>Terms of Use</h2><label>Body — English<textarea name="body_en" required></textarea></label><label>Body — French<textarea name="body_fr" required></textarea></label><label>Last updated — stated date<input name="content_updated_at" type="date" /><small>Shown on the page as month and year. Set this only when the substance changes; leave it blank to keep the approved wording.</small></label><label class="check"><input name="published" type="checkbox" /> Published — visible on the public site</label><div class="form-actions"><button class="button" type="submit">Save Terms of Use</button></div><p data-status role="status" aria-live="polite"></p></form></section>
  </div>
</AdminLayout>

<script>
  import { guardUnsavedChanges, request, sendJson } from '../../lib/admin-client';
  const forms = [...document.querySelectorAll<HTMLFormElement>('form[data-page]')];
  // Each legal page is its own form and saves independently, so each gets its own baseline.
  const guards = new Map(forms.map((form) => [form, guardUnsavedChanges(form)]));
  const setStatus = (form: HTMLFormElement, message: string, tone: 'ok' | 'err' = 'ok') => { const target = form.querySelector('[data-status]')!; target.textContent = message; target.className = message ? `status status--${tone}` : ''; };
  async function load() {
    const res = await request<Array<Record<string, any>>>('/api/legal-pages-admin', {}, 'Unable to load legal pages.');
    if (!res.ok) { forms.forEach((form) => setStatus(form, res.error!, 'err')); return; }
    forms.forEach((form) => { const row = res.data?.find((item) => item.page === form.dataset.page); if (!row) return setStatus(form, 'No database row yet. Enter both languages to create it.'); (form.elements.namedItem('body_en') as HTMLTextAreaElement).value = row.body_en; (form.elements.namedItem('body_fr') as HTMLTextAreaElement).value = row.body_fr; (form.elements.namedItem('content_updated_at') as HTMLInputElement).value = row.content_updated_at ? String(row.content_updated_at).slice(0, 10) : ''; (form.elements.namedItem('published') as HTMLInputElement).checked = Boolean(row.published); setStatus(form, 'Content loaded.'); guards.get(form)!.markClean(); });
  }
  forms.forEach((form) => form.addEventListener('submit', async (event) => {
    event.preventDefault(); const button = form.querySelector('button') as HTMLButtonElement; button.disabled = true; setStatus(form, 'Saving…'); const data = new FormData(form);
    const published = (form.elements.namedItem('published') as HTMLInputElement).checked;
    const res = await sendJson('/api/legal-pages-admin', 'PUT', { page: form.dataset.page, body_en: data.get('body_en'), body_fr: data.get('body_fr'), content_updated_at: data.get('content_updated_at'), published }, 'Unable to save legal page.');
    setStatus(form, res.ok ? (published ? 'Legal page published. A public rebuild was requested.' : 'Draft saved. Not visible on the public site.') : res.error!, res.ok ? 'ok' : 'err'); if (res.ok) guards.get(form)!.markClean(); button.disabled = false;
  }));
  load();
</script>

<style>
  .legal-editors textarea { min-height:26rem; }
  @media (max-width: 980px) { .legal-editors { grid-template-columns:1fr; } }
</style>
