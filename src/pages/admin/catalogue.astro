---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Catalogue" section="catalogue">
  <h1>Catalogue</h1><p>Manage bilingual titles as drafts, then publish only after editorial review.</p>
  <section class="card"><div class="toolbar"><h2 id="editorTitle">New title</h2><button class="button secondary" type="button" id="reset">New title</button></div>
    <form id="editor"><input type="hidden" name="id" /><div class="two"><label>English title<input name="title_en" required /></label><label>French title<input name="title_fr" required /></label><label>Slug<input name="slug" required pattern="[a-z0-9-]+" /></label><label>Level<select name="level" required><option value="primary">Primary</option><option value="secondary">Secondary</option></select></label><label>English description<textarea name="description_en" required></textarea></label><label>French description<textarea name="description_fr" required></textarea></label><label>English curriculum alignment<textarea name="curriculum_alignment_en"></textarea></label><label>French curriculum alignment<textarea name="curriculum_alignment_fr"></textarea></label></div><div class="checks"><label><input name="language_en" type="checkbox" checked /> English edition</label><label><input name="language_fr" type="checkbox" checked /> French edition</label><label><input name="featured" type="checkbox" /> Featured title</label><label><input name="published" type="checkbox" /> Publish now</label></div><button class="button">Save draft</button><p id="status" role="status" aria-live="polite"></p></form></section>
  <section class="card"><h2>Titles</h2><p id="empty">Loading catalogue…</p><div id="items" class="items"></div></section>
</AdminLayout>
<script>
  type CmsRecord = { [key: string]: any };
  const form = document.querySelector('#editor') as HTMLFormElement; const items = document.querySelector('#items')!; const empty = document.querySelector('#empty')!; const status = document.querySelector('#status')!; const title = document.querySelector('#editorTitle')!;
  const setStatus = (message: string, tone: 'ok' | 'err' = 'ok') => { status.textContent = message; status.className = message ? `status status--${tone}` : ''; };
  const reset = () => { form.reset(); (form.elements.namedItem('id') as HTMLInputElement).value = ''; title.textContent = 'New title'; setStatus(''); };
  const values = () => { const data = new FormData(form); return { id: data.get('id'), title_en: data.get('title_en'), title_fr: data.get('title_fr'), slug: data.get('slug'), level: data.get('level'), description_en: data.get('description_en'), description_fr: data.get('description_fr'), curriculum_alignment_en: data.get('curriculum_alignment_en'), curriculum_alignment_fr: data.get('curriculum_alignment_fr'), languages: ['language_en','language_fr'].filter(key => data.get(key)).map(key => key.replace('language_', '')), featured: Boolean(data.get('featured')), published: Boolean(data.get('published')) }; };
  const edit = (entry: CmsRecord) => { for (const [key, value] of Object.entries(entry)) { const input = form.elements.namedItem(key) as HTMLInputElement | HTMLTextAreaElement | null; if (input && typeof value === 'string') input.value = value; } (form.elements.namedItem('id') as HTMLInputElement).value = entry.id; (form.elements.namedItem('language_en') as HTMLInputElement).checked = entry.languages?.includes('en'); (form.elements.namedItem('language_fr') as HTMLInputElement).checked = entry.languages?.includes('fr'); (form.elements.namedItem('featured') as HTMLInputElement).checked = entry.featured; (form.elements.namedItem('published') as HTMLInputElement).checked = entry.published; title.textContent = `Editing: ${entry.title_en}`; window.scrollTo({ top: 0, behavior: 'smooth' }); };
  async function load() { try { const response = await fetch('/api/catalogue-admin'); if (!response.ok) throw new Error('Unable to load catalogue.'); const rows: CmsRecord[] = await response.json(); items.replaceChildren(); empty.textContent = rows.length ? '' : 'No titles yet. Start with a bilingual draft.'; rows.forEach(entry => { const article = document.createElement('article'); article.className = 'item'; const heading = document.createElement('strong'); heading.textContent = entry.title_en; const meta = document.createElement('span'); meta.textContent = `${entry.level} · ${entry.published ? 'Published' : 'Draft'}`; const editButton = document.createElement('button'); editButton.type = 'button'; editButton.textContent = 'Edit'; editButton.onclick = () => edit(entry); const deleteButton = document.createElement('button'); deleteButton.type = 'button'; deleteButton.className = 'danger'; deleteButton.textContent = 'Delete'; deleteButton.onclick = async () => { if (!confirm(`Delete “${entry.title_en}”?`)) return; const result = await fetch(`/api/catalogue-admin?id=${encodeURIComponent(entry.id)}`, { method: 'DELETE' }); if (!result.ok) return setStatus('Unable to delete title.', 'err'); reset(); await load(); }; article.append(heading, meta, editButton, deleteButton); items.append(article); }); } catch (error) { empty.textContent = error instanceof Error ? error.message : 'Unable to load catalogue.'; } }
  form.addEventListener('submit', async event => { event.preventDefault(); const record = values(); const response = await fetch(`/api/catalogue-admin${record.id ? `?id=${encodeURIComponent(record.id)}` : ''}`, { method: record.id ? 'PUT' : 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(record) }); const result = await response.json(); if (!response.ok) return setStatus(result.error || 'Unable to save title.', 'err'); setStatus(record.published ? 'Title published.' : 'Draft saved.'); reset(); await load(); }); document.querySelector('#reset')?.addEventListener('click', reset); load();
</script>
<style>.toolbar{display:flex;justify-content:space-between;align-items:center;gap:1rem}.two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.two label{display:grid;gap:.35rem;font-weight:600}.two input,.two textarea,.two select{font:inherit;padding:.65rem;border:1px solid #cdbebe;border-radius:.45rem}.two textarea{min-height:5rem;resize:vertical}.checks{display:flex;flex-wrap:wrap;gap:1rem;margin:1rem 0}.checks label{font-weight:600}.secondary{background:#695b5b}.items{display:grid;gap:.75rem}.item{display:grid;grid-template-columns:1fr auto auto auto;align-items:center;gap:.75rem;border-top:1px solid #eadede;padding:.85rem 0}.item span{color:#695b5b}.item button{border:0;border-radius:.4rem;padding:.45rem .65rem;cursor:pointer}.danger{color:#8b1e31;background:#fbe8eb}@media(max-width:720px){.two{grid-template-columns:1fr}.item{grid-template-columns:1fr auto auto}.item span{grid-column:1/-1;grid-row:2}}</style>
