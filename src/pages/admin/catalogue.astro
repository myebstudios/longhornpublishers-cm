---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import AdminSaveBar from '../../components/admin/AdminSaveBar.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';

import AdminEditorDialog from '../../components/admin/AdminEditorDialog.astro';
---
<AdminLayout title="Catalogue" section="catalogue">
<AdminPageHeader heading="Educational Catalogue" subtitle="Manage publication titles, curriculum level assignments, ministerial classification status, and book cover artwork."><button class="button" type="button" id="openEditorBtn">+ Create title</button></AdminPageHeader>
<section id="adminCanvas" aria-busy="true"><p role="status">Loading saved content…</p></section>
<AdminEditorDialog legacyEditor>
<form hidden id="editor">
      <input type="hidden" name="id" />
      <fieldset class="two"><legend>Content</legend>
        <label>English title<input name="title_en" required placeholder="e.g. Primary Mathematics Book 4" lang="en" /></label>
        <label>French title<input name="title_fr" required placeholder="e.g. Mathématiques Élémentaires 4" lang="fr" /></label>
        <label>URL name<input name="slug" required pattern="[a-z0-9-]+" placeholder="primary-mathematics-book-4" /></label>
        <label>Product code or ISBN<input name="product_code" required maxlength="64" autocomplete="off" placeholder="e.g. 978-1-4028-9462-6" /></label>
        <label>Level
          <select name="level" required>
            <option value="primary">Primary</option>
            <option value="secondary">Secondary</option>
          </select>
        </label>
        <label>Subject
          <select name="subject_id">
            <option value="">— No subject —</option>
          </select>
        </label>
        <label>English description<textarea name="description_en" required placeholder="Comprehensive curriculum coverage..." lang="en"></textarea></label>
        <label>French description<textarea name="description_fr" required placeholder="Couverture complète du programme..." lang="fr"></textarea></label>
        <label>English curriculum alignment<textarea name="curriculum_alignment_en" placeholder="MINEDUB official syllabus compliant..." lang="en"></textarea></label>
        <label>French curriculum alignment<textarea name="curriculum_alignment_fr" placeholder="Conforme au programme officiel du MINEDUB..." lang="fr"></textarea></label>
      </fieldset>

      <fieldset class="classification">
        <legend>Classification and evidence</legend>
        <label>Classification
          <select name="classification" aria-describedby="classificationHint">
            <option value="unclassified">Unclassified — not shown publicly</option>
            <option value="other_developed">Other developed title — text only, no cover</option>
            <option value="national_book_list_verified">National Book List — verified</option>
          </select>
        </label>
        <p id="classificationHint" class="cover__hint">Choose “National Book List” only with evidence for this exact title, edition and product code. Evidence fields are private and never shown on the site.</p>
        <label>Evidence reference (private)<input name="booklist_evidence_ref" maxlength="500" placeholder="e.g. MINEDUB list 2026–2027, p. 12, line 4" /></label>
        <label>Verified by (private)<input name="booklist_verified_by" maxlength="120" /></label>
        <label>Verification date<input name="booklist_verified_at" type="date" /></label>
        <label class="check"><input name="cover_rights_approved" type="checkbox" /> Cover and publication rights approved — show the cover publicly (National Book List titles only)</label>
      </fieldset>

      <fieldset class="cover">
        <legend>Cover</legend>
        <input type="hidden" name="cover_image_id" />
        <div class="cover__row">
          <div class="cover__preview">
            <img id="coverPreview" alt="Book cover preview" hidden />
            <p id="coverEmpty" class="cover__empty">No cover image</p>
          </div>
          <div class="cover__controls">
            <label for="coverFile" id="coverFileLabel" class="button secondary" tabindex="0" role="button">Choose cover image</label>
            <input id="coverFile" type="file" accept="image/jpeg,image/png,image/webp" aria-describedby="coverHint coverStatus" class="accessible-file" />
            <p id="coverHint" class="cover__hint">JPEG, PNG or WebP, up to 8&nbsp;MB. Portrait (3:4) reproduces best.</p>
            <button class="button danger" type="button" id="coverClear" hidden>Remove cover image</button>
            <p id="coverStatus" class="cover__status" role="status" aria-live="polite"></p>
          </div>
        </div>
      </fieldset>

      <fieldset class="checks"><legend>Publication</legend>
        <!-- Unchecked by default: an edition is a publishing claim, so it must be
             asserted deliberately rather than inherited from a form default. The
             public card badges these, so a stray default is a visible false claim. -->
        <label><input name="language_en" type="checkbox" lang="en" /> English edition</label>
        <label><input name="language_fr" type="checkbox" lang="fr" /> French edition</label>
        <label><input name="featured" type="checkbox" aria-describedby="catalogueFeaturedHint" /> Catalogue featured</label>
        <label><input name="published" type="checkbox" /> Published</label>
      </fieldset>
<small id="catalogueFeaturedHint">Catalogue featured is separate from the selected titles on Homepage.</small>

      <AdminSaveBar>
        <button class="button" type="submit">Save title</button>
        <button class="button secondary" type="button" id="cancelEditorBtn">Cancel</button>
      </AdminSaveBar>
      <p id="status" role="status" aria-live="polite"></p>
    </form>
</AdminEditorDialog>
</AdminLayout>
<script>
import { startAdminV2 } from '../../lib/admin-v2';
void startAdminV2('catalogue');
</script>
