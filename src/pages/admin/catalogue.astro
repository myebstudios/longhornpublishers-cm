---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Catalogue" section="catalogue">
  <h1>Catalogue</h1><p>Manage bilingual titles as drafts, then publish only after editorial review.</p>
  <section class="card"><div class="toolbar"><h2 id="editorTitle">New title</h2><button class="button secondary" type="button" id="reset">New title</button></div>
    <form id="editor"><input type="hidden" name="id" /><div class="two"><label>English title<input name="title_en" required /></label><label>French title<input name="title_fr" required /></label><label>Slug<input name="slug" required pattern="[a-z0-9-]+" /></label><label>Level<select name="level" required><option value="primary">Primary</option><option value="secondary">Secondary</option></select></label><label>Subject<select name="subject_id"><option value="">— No subject —</option></select></label><label>English description<textarea name="description_en" required></textarea></label><label>French description<textarea name="description_fr" required></textarea></label><label>English curriculum alignment<textarea name="curriculum_alignment_en"></textarea></label><label>French curriculum alignment<textarea name="curriculum_alignment_fr"></textarea></label></div>
      <fieldset class="cover">
        <legend>Cover image</legend>
        <input type="hidden" name="cover_image_id" />
        <div class="cover__row">
          <div class="cover__preview">
            <img id="coverPreview" alt="" hidden />
            <p id="coverEmpty" class="cover__empty">No cover image</p>
          </div>
          <div class="cover__controls">
            <label for="coverFile" id="coverFileLabel">Choose a cover image</label>
            <input id="coverFile" type="file" accept="image/jpeg,image/png,image/webp" aria-describedby="coverHint coverStatus" />
            <p id="coverHint" class="cover__hint">JPEG, PNG or WebP, up to 8&nbsp;MB. Portrait (3:4) reproduces best.</p>
            <button class="button secondary" type="button" id="coverClear" hidden>Remove cover image</button>
            <p id="coverStatus" class="cover__status" role="status" aria-live="polite"></p>
          </div>
        </div>
      </fieldset>
      <div class="checks"><label><input name="language_en" type="checkbox" checked /> English edition</label><label><input name="language_fr" type="checkbox" checked /> French edition</label><label><input name="featured" type="checkbox" /> Featured title</label><label><input name="published" type="checkbox" /> Publish now</label></div><button class="button">Save draft</button><p id="status" role="status" aria-live="polite"></p></form></section>
  <section class="card"><h2>Titles</h2><p id="empty">Loading catalogue…</p><div id="items" class="items"></div></section>
</AdminLayout>
<script>
  import {
    confirmAction, coverFileError, coverViewState, emptyToNull, request, sendJson,
  } from '../../lib/admin-client';

  type CmsRecord = { [key: string]: any };

  const form = document.querySelector('#editor') as HTMLFormElement;
  const submit = form.querySelector('button:not([type="button"])') as HTMLButtonElement;
  const items = document.querySelector('#items')!;
  const empty = document.querySelector('#empty')!;
  const status = document.querySelector('#status')!;
  const title = document.querySelector('#editorTitle')!;

  const setStatus = (message: string, tone: 'ok' | 'err' = 'ok') => {
    status.textContent = message;
    status.className = message ? `status status--${tone}` : '';
  };

  /** Serialised form state as of the last load/save, for the unsaved-work guard. */
  let pristine = '';
  const snapshot = () => new URLSearchParams(new FormData(form) as any).toString();
  const isDirty = () => snapshot() !== pristine;
  const confirmDiscard = async () =>
    !isDirty() || (await confirmAction('This form has unsaved changes. Discard them?'));

  const reset = async (force = false) => {
    if (!force && !(await confirmDiscard())) return false;
    form.reset();
    (form.elements.namedItem('id') as HTMLInputElement).value = '';
    releasePreviewUrl();
    coverField.value = '';
    renderCover(null);
    setCoverStatus('');
    title.textContent = 'New title';
    setStatus('');
    pristine = snapshot();
    return true;
  };

  const values = () => {
    const data = new FormData(form);
    return emptyToNull({
      id: data.get('id'),
      title_en: data.get('title_en'),
      title_fr: data.get('title_fr'),
      slug: data.get('slug'),
      level: data.get('level'),
      subject_id: data.get('subject_id') || null,
      cover_image_id: data.get('cover_image_id') || null,
      description_en: data.get('description_en'),
      description_fr: data.get('description_fr'),
      curriculum_alignment_en: data.get('curriculum_alignment_en'),
      curriculum_alignment_fr: data.get('curriculum_alignment_fr'),
      languages: ['language_en', 'language_fr'].filter(key => data.get(key)).map(key => key.replace('language_', '')),
      featured: Boolean(data.get('featured')),
      published: Boolean(data.get('published')),
    } as CmsRecord, ['curriculum_alignment_en', 'curriculum_alignment_fr']);
  };

  // --- Cover image -------------------------------------------------------
  // The rules live in admin-client so they can be unit-tested without a DOM;
  // everything here just applies the resulting state.
  const coverField = form.elements.namedItem('cover_image_id') as HTMLInputElement;
  const coverFile = document.querySelector('#coverFile') as HTMLInputElement;
  const coverFileLabel = document.querySelector('#coverFileLabel')!;
  const coverPreview = document.querySelector('#coverPreview') as HTMLImageElement;
  const coverEmpty = document.querySelector('#coverEmpty')!;
  const coverClear = document.querySelector('#coverClear') as HTMLButtonElement;
  const coverStatus = document.querySelector('#coverStatus')!;

  /** Object URL for a just-picked file, revoked when it stops being shown. */
  let previewObjectUrl: string | null = null;
  const releasePreviewUrl = () => {
    if (previewObjectUrl) { URL.revokeObjectURL(previewObjectUrl); previewObjectUrl = null; }
  };

  const setCoverStatus = (message: string, tone: 'ok' | 'err' = 'ok') => {
    coverStatus.textContent = message;
    coverStatus.className = message ? `cover__status status--${tone}` : 'cover__status';
  };

  /**
   * Reflect the current cover in the UI.
   *
   * `src` is passed for a freshly picked file (an object URL, shown before the
   * upload finishes); otherwise the stored id is read back through /api/media,
   * which serves unpublished drafts to signed-in admins.
   */
  const renderCover = (id: string | null, src?: string) => {
    const view = coverViewState(id, src);
    if (view.imageSrc) coverPreview.src = view.imageSrc;
    else coverPreview.removeAttribute('src');
    // The preview duplicates the adjacent text, so it is decorative; the file
    // name and status message carry the information.
    coverPreview.alt = '';
    coverPreview.hidden = !view.showImage;
    (coverEmpty as HTMLElement).hidden = !view.showEmpty;
    coverClear.hidden = !view.showClear;
    coverFileLabel.textContent = view.fileLabel;
  };

  coverFile.addEventListener('change', async () => {
    const file = coverFile.files?.[0];
    if (!file) return;

    const invalid = coverFileError(file);
    if (invalid) {
      setCoverStatus(invalid, 'err');
      coverFile.value = '';
      return;
    }

    // Show the picked file immediately; uploading it may take a moment.
    releasePreviewUrl();
    previewObjectUrl = URL.createObjectURL(file);
    renderCover(null, previewObjectUrl);

    coverFile.disabled = true;
    submit.disabled = true;
    setCoverStatus(`Uploading ${file.name}…`);
    try {
      const body = new FormData();
      body.append('file', file);
      const result = await request<{ id: string }>(
        '/api/media', { method: 'POST', body }, 'Unable to upload that image.',
      );
      if (!result.ok || !result.data?.id) {
        // Roll the preview back to whatever was saved before this attempt, so
        // the form never shows an image the record does not actually have.
        releasePreviewUrl();
        renderCover(coverField.value || null);
        setCoverStatus(result.error ?? 'Unable to upload that image.', 'err');
        return;
      }
      coverField.value = result.data.id;
      setCoverStatus(`${file.name} uploaded. Save the title to attach it.`);
    } finally {
      coverFile.disabled = false;
      submit.disabled = false;
      coverFile.value = '';
    }
  });

  coverClear.addEventListener('click', () => {
    releasePreviewUrl();
    coverField.value = '';
    renderCover(null);
    setCoverStatus('Cover image removed. Save the title to apply it.');
    // Keyboard users land on a control that just vanished, so move focus
    // somewhere predictable rather than letting it fall back to <body>.
    coverFile.focus();
  });

  const edit = async (entry: CmsRecord) => {
    if (!(await confirmDiscard())) return;
    for (const [key, value] of Object.entries(entry)) {
      const input = form.elements.namedItem(key) as HTMLInputElement | HTMLTextAreaElement | null;
      if (input && typeof value === 'string') input.value = value;
    }
    (form.elements.namedItem('id') as HTMLInputElement).value = entry.id;
    // `languages` arrives as a JSON array, or as its string form from some
    // driver/column combinations — normalise before testing membership.
    const languages: string[] = Array.isArray(entry.languages)
      ? entry.languages
      : typeof entry.languages === 'string'
        ? (() => { try { return JSON.parse(entry.languages); } catch { return []; } })()
        : [];
    (form.elements.namedItem('language_en') as HTMLInputElement).checked = languages.includes('en');
    (form.elements.namedItem('language_fr') as HTMLInputElement).checked = languages.includes('fr');
    // Set explicitly: the loop above only assigns string values, so a title
    // whose subject was cleared would otherwise keep the previous selection.
    const subjectSelect = form.elements.namedItem('subject_id') as HTMLSelectElement | null;
    if (subjectSelect) subjectSelect.value = entry.subject_id ?? '';
    releasePreviewUrl();
    coverField.value = entry.cover_image_id ?? '';
    renderCover(entry.cover_image_id ?? null);
    setCoverStatus('');
    (form.elements.namedItem('featured') as HTMLInputElement).checked = Boolean(entry.featured);
    (form.elements.namedItem('published') as HTMLInputElement).checked = Boolean(entry.published);
    title.textContent = `Editing: ${entry.title_en}`;
    setStatus('');
    pristine = snapshot();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  /**
   * Fill the subject dropdown from the taxonomy.
   *
   * Runs before the title list so that edit() can select an existing
   * subject_id — setting a <select> value before its options exist silently
   * leaves it blank, which would look like the title has no subject.
   */
  async function loadSubjects() {
    const select = form.elements.namedItem('subject_id') as HTMLSelectElement | null;
    if (!select) return;
    const result = await request<CmsRecord[]>('/api/subjects-admin', {}, 'Unable to load subjects.');
    if (!result.ok) {
      setStatus(`${result.error} Titles can still be saved without a subject.`, 'err');
      return;
    }
    const rows = result.data ?? [];
    for (const subject of rows) {
      const option = document.createElement('option');
      option.value = subject.id;
      option.textContent = subject.name_fr ? `${subject.name_en} / ${subject.name_fr}` : subject.name_en;
      select.append(option);
    }
    if (!rows.length) {
      const option = select.querySelector('option');
      if (option) option.textContent = '— No subjects defined yet —';
    }
  }

  async function load() {
    const result = await request<CmsRecord[]>('/api/catalogue-admin', {}, 'Unable to load catalogue.');
    if (!result.ok) { empty.textContent = result.error!; return; }

    const rows = result.data ?? [];
    items.replaceChildren();
    empty.textContent = rows.length ? '' : 'No titles yet. Start with a bilingual draft.';

    rows.forEach(entry => {
      const article = document.createElement('article');
      article.className = 'item';

      const heading = document.createElement('strong');
      heading.textContent = entry.title_en;
      // Both languages are listed: a French-first editor needs to recognise
      // their own work without opening each record.
      const alternate = document.createElement('small');
      alternate.className = 'alt';
      alternate.textContent = entry.title_fr ?? '—';
      heading.append(alternate);

      const meta = document.createElement('span');
      meta.textContent = `${entry.level} · ${entry.published ? 'Published' : 'Draft'}`;

      // Repeated controls are labelled with the title so a screen reader does
      // not announce a column of identical "Edit"/"Delete" buttons.
      const editButton = document.createElement('button');
      editButton.type = 'button';
      editButton.textContent = 'Edit';
      editButton.setAttribute('aria-label', `Edit ${entry.title_en}`);
      editButton.onclick = () => edit(entry);

      const deleteButton = document.createElement('button');
      deleteButton.type = 'button';
      deleteButton.className = 'danger';
      deleteButton.textContent = 'Delete';
      deleteButton.setAttribute('aria-label', `Delete ${entry.title_en}`);
      deleteButton.onclick = async () => {
        if (!(await confirmAction(`Delete “${entry.title_en}”?`))) return;
        deleteButton.disabled = true;
        const result = await request(
          `/api/catalogue-admin?id=${encodeURIComponent(entry.id)}`,
          { method: 'DELETE' },
          'Unable to delete title.',
        );
        if (!result.ok) { deleteButton.disabled = false; setStatus(result.error!, 'err'); return; }
        // Editing the record that was just deleted would post to a dead id.
        if ((form.elements.namedItem('id') as HTMLInputElement).value === String(entry.id)) reset(true);
        setStatus('Title deleted.');
        await load();
      };

      article.append(heading, meta, editButton, deleteButton);
      items.append(article);
    });
  }

  form.addEventListener('submit', async event => {
    event.preventDefault();
    // Guards against a double-click creating two records for one POST.
    if (submit.disabled) return;
    submit.disabled = true;
    setStatus('Saving…');
    try {
      const record = values();
      const result = await sendJson(
        `/api/catalogue-admin${record.id ? `?id=${encodeURIComponent(String(record.id))}` : ''}`,
        record.id ? 'PUT' : 'POST',
        record,
        'Unable to save title.',
      );
      if (!result.ok) { setStatus(result.error!, 'err'); return; }
      setStatus(record.published ? 'Title published.' : 'Draft saved.');
      reset(true);
      await load();
    } finally {
      submit.disabled = false;
    }
  });

  document.querySelector('#reset')?.addEventListener('click', () => reset());

  // Warn on tab close / navigation while a draft has unsaved edits.
  window.addEventListener('beforeunload', event => {
    if (isDirty()) event.preventDefault();
  });

  pristine = snapshot();
  loadSubjects().then(() => { pristine = snapshot(); return load(); });
</script>
<style>.toolbar{display:flex;justify-content:space-between;align-items:center;gap:1rem}.two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.two label{display:grid;gap:.35rem;font-weight:600}.two input,.two textarea,.two select{font:inherit;padding:.65rem;border:1px solid #cdbebe;border-radius:.45rem}.two textarea{min-height:5rem;resize:vertical}.cover{border:1px solid #cdbebe;border-radius:.6rem;padding:1rem 1.15rem 1.15rem;margin:1.25rem 0}.cover legend{font-weight:600;padding:0 .35rem}.cover__row{display:flex;gap:1.25rem;align-items:flex-start;flex-wrap:wrap}.cover__preview{flex:0 0 120px;width:120px;aspect-ratio:3/4;border:1px dashed #cdbebe;border-radius:.45rem;display:grid;place-items:center;overflow:hidden;background:#faf6f6}.cover__preview img{width:100%;height:100%;object-fit:cover}.cover__empty{margin:0;padding:.5rem;text-align:center;color:#7a6a6a;font-size:.85em}.cover__controls{flex:1 1 16rem;display:grid;gap:.5rem;justify-items:start}.cover__controls label{font-weight:600}.cover__hint{margin:0;color:#7a6a6a;font-size:.85em}.cover__status{margin:0;min-height:1.3em;font-weight:650}.cover__status.status--err{color:#8b1e31}#coverFile{font:inherit}#coverFile:focus-visible{outline:3px solid #2F7A2A;outline-offset:2px}#coverFile:disabled{opacity:.6;cursor:progress}.checks{display:flex;flex-wrap:wrap;gap:1rem;margin:1rem 0}.checks label{font-weight:600}.secondary{background:#695b5b}.items{display:grid;gap:.75rem}.item{display:grid;grid-template-columns:1fr auto auto auto;align-items:center;gap:.75rem;border-top:1px solid #eadede;padding:.85rem 0}.item span{color:#695b5b}.item strong{display:grid;gap:.15rem}.item .alt{font-weight:400;color:#7a6a6a;font-size:.85em}.item button[disabled]{opacity:.55;cursor:progress}.item button{border:0;border-radius:.4rem;padding:.45rem .65rem;cursor:pointer}.danger{color:#8b1e31;background:#fbe8eb}@media(max-width:720px){.two{grid-template-columns:1fr}.item{grid-template-columns:1fr auto auto}.item span{grid-column:1/-1;grid-row:2}}</style>
