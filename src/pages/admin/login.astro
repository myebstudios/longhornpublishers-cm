<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Longhorn Admin sign in</title><link rel="icon" href="/favicon.svg" /></head><body><main><a href="/en/" class="brand">Longhorn <span>Admin</span></a><h1>Welcome back</h1><p>Use an invitation-approved administrator account.</p><form id="login"><label>Email<input name="email" type="email" autocomplete="email" required /></label><label>Password<input name="password" type="password" autocomplete="current-password" required minlength="8" /></label><button>Sign in</button><p id="status" role="status" aria-live="polite"></p></form></main><script>
import { AuthError, getUser, handleAuthCallback, login } from '@netlify/identity';
const status = document.querySelector('#status');
try { await handleAuthCallback(); const user = await getUser(); if (user?.roles?.includes('admin')) location.href = '/admin/'; } catch { if (status) status.textContent = 'Finish accepting your invitation, then sign in.'; }
document.querySelector('#login')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget as HTMLFormElement; const submit = form.querySelector('button') as HTMLButtonElement; submit.disabled = true; if (status) status.textContent = 'Signing in…'; try { const user = await login(String(new FormData(form).get('email')), String(new FormData(form).get('password'))); if (!user.roles?.includes('admin')) throw new Error('This account does not have administrator access.'); location.href = '/admin/'; } catch (error) { if (status) status.textContent = error instanceof AuthError && error.status === 401 ? 'Invalid email or password.' : error instanceof Error ? error.message : 'Unable to sign in.'; } finally { submit.disabled = false; } });
</script><style>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#f7f1e8;color:#241d1d;font:16px Inter,system-ui}main{width:min(420px,calc(100% - 3rem));background:#fff;padding:2.25rem;border-radius:1.2rem;box-shadow:0 20px 50px #40101b1a}.brand{font:700 1.2rem Poppins,system-ui;color:#651d32;text-decoration:none}.brand span{color:#b47a15}h1{font:700 2.25rem Poppins,system-ui;margin:2rem 0 .25rem;color:#651d32}p{color:#695b5b}form{display:grid;gap:1rem;margin-top:1.75rem}label{display:grid;gap:.35rem;font-weight:600}input{padding:.8rem;border:1px solid #cdbebe;border-radius:.45rem;font:inherit}button{margin-top:.5rem;background:#651d32;color:#fff;border:0;border-radius:.45rem;padding:.85rem;font:600 1rem Poppins,system-ui;cursor:pointer}button:disabled{opacity:.6}#status{min-height:1.4rem;margin:0}</style></body></html>
