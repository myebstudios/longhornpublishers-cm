<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Longhorn Admin sign in</title><link rel="icon" href="/favicon.svg" /></head><body><main><a href="/en/" class="brand"><span class="mark">L</span><span>LONGHORN<small>Publishers Cameroon</small></span></a><p class="eyebrow">Content workspace</p><h1 id="title">Welcome back</h1><p id="intro">Sign in to manage Longhorn’s bilingual catalogue and editorial content.</p><form id="activate" hidden><label>Create password<input name="password" type="password" autocomplete="new-password" required minlength="8" /></label><label>Confirm password<input name="confirmation" type="password" autocomplete="new-password" required minlength="8" /></label><button>Activate administrator account <span>→</span></button></form><form id="login"><label>Email address<input name="email" type="email" autocomplete="email" required placeholder="you@company.com" /></label><label>Password<input name="password" type="password" autocomplete="current-password" required minlength="8" placeholder="••••••••" /></label><button>Sign in <span>→</span></button></form><p id="status" role="status" aria-live="polite"></p></main><aside><div><span class="quote-mark">“</span><h2>Every great book starts with a clear story.</h2><p>The Longhorn content desk keeps every English and French version ready for publication.</p></div><small>Longhorn Publishers Cameroon</small></aside><script>
import { acceptInvite, AuthError, getUser, handleAuthCallback, login } from '@netlify/identity';
const status = document.querySelector('#status');
const activationForm = document.querySelector('#activate') as HTMLFormElement | null;
const loginForm = document.querySelector('#login') as HTMLFormElement | null;
const title = document.querySelector('#title');
const intro = document.querySelector('#intro');
try {
  const invitationToken = new URLSearchParams(window.location.hash.substring(1)).get('invite_token');
  const callback = await handleAuthCallback();
  const token = callback?.type === 'invite' ? callback.token : invitationToken;
  if (token && activationForm && loginForm) {
    title!.textContent = 'Activate administrator account';
    intro!.textContent = 'Create a password to finish accepting your invitation.';
    activationForm.hidden = false;
    loginForm.hidden = true;
    activationForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      const submit = form.querySelector('button') as HTMLButtonElement;
      const data = new FormData(form);
      const password = String(data.get('password'));
      if (password !== String(data.get('confirmation'))) {
        if (status) status.textContent = 'Passwords do not match.';
        return;
      }
      submit.disabled = true;
      if (status) status.textContent = 'Activating account…';
      try {
        const user = await acceptInvite(token, password);
        if (!user.roles?.includes('admin')) throw new Error('This account does not have administrator access.');
        location.href = '/admin/';
      } catch (error) {
        if (status) status.textContent = error instanceof Error ? error.message : 'Unable to activate this invitation.';
      } finally { submit.disabled = false; }
    });
  } else {
    const user = await getUser();
    if (user?.roles?.includes('admin')) location.href = '/admin/';
  }
} catch {
  // Only an actual invitation can be "invalid or expired". A failed plain
  // session lookup must not accuse an ordinary visitor of a bad invite link.
  const hadToken = /(?:^#|&)(?:invite_token|recovery_token)=/.test(window.location.hash);
  if (status) status.textContent = hadToken
    ? 'This invitation link is invalid or has expired. Request a new invitation.'
    : 'Could not check your session. Enter your credentials to sign in.';
}
document.querySelector('#login')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget as HTMLFormElement; const submit = form.querySelector('button') as HTMLButtonElement; submit.disabled = true; if (status) status.textContent = 'Signing in…'; try { const user = await login(String(new FormData(form).get('email')), String(new FormData(form).get('password'))); if (!user.roles?.includes('admin')) throw new Error('This account does not have administrator access.'); location.href = '/admin/'; } catch (error) { if (status) status.textContent = error instanceof AuthError && error.status === 401 ? 'Invalid email or password.' : error instanceof Error ? error.message : 'Unable to sign in.'; } finally { submit.disabled = false; } });
</script><style>body{margin:0;min-height:100vh;display:grid;grid-template-columns:minmax(0,1fr) minmax(360px,42%);background:#f8f6f2;color:#202436;font:15px/1.5 Inter,system-ui,sans-serif}main{width:min(440px,calc(100% - 4rem));align-self:center;justify-self:center;padding:42px 0}.brand{display:flex;align-items:center;gap:10px;color:#641d36;text-decoration:none;font:800 14px/1 Poppins,system-ui;letter-spacing:.08em}.brand small{display:block;margin-top:6px;color:#8b6a74;font:500 10px Inter,system-ui;letter-spacing:.04em}.mark{display:grid;place-items:center;width:38px;height:38px;border-radius:11px;background:#d6a64b;color:#641d36;font:700 21px Georgia}.eyebrow{margin:48px 0 9px;color:#8b6a74;font-size:10px;font-weight:800;letter-spacing:.16em;text-transform:uppercase}h1{font:700 42px/1.08 Poppins,system-ui;letter-spacing:-.04em;margin:0;color:#202436}#intro{margin:10px 0 0;max-width:370px;color:#6c7180;font-size:16px}form{display:grid;gap:17px;margin-top:34px}form[hidden]{display:none}label{display:grid;gap:7px;color:#3c4150;font-size:13px;font-weight:750}input{padding:13px 14px;border:1px solid #ded8d0;border-radius:9px;background:#fff;font:inherit;color:#202436}input:focus{outline:3px solid #e1b95e80;border-color:#b88932}button{margin-top:7px;background:#641d36;color:#fff;border:0;border-radius:9px;padding:13px 16px;font:700 14px Inter,system-ui;cursor:pointer;box-shadow:0 7px 16px #641d3633;text-align:left}button span{float:right;font-size:18px;line-height:14px}button:disabled{opacity:.6}#status{min-height:1.4rem;margin:16px 0 0;color:#a93248;font-weight:650}aside{display:flex;flex-direction:column;justify-content:space-between;padding:56px;background:linear-gradient(145deg,#481126,#741f41 65%,#9b3b5a);color:#fff}aside>div{max-width:420px;margin:auto 0}.quote-mark{color:#d6a64b;font:100px/0 Georgia}aside h2{font:600 clamp(30px,4vw,50px)/1.08 Poppins,system-ui;letter-spacing:-.04em;margin:20px 0}aside p{max-width:360px;color:#f1dbe2;font-size:16px}aside small{color:#e4bfcf;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}@media(max-width:760px){body{display:block}main{width:min(440px,calc(100% - 40px));padding:35px 0 50px}aside{display:none}.eyebrow{margin-top:38px}h1{font-size:36px}}</style></body></html>
