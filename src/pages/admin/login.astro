---
import '../../styles/admin.css';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import logo from '../../../Assets/Longhorn CM logo.svg';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Longhorn Admin sign in</title>
  <link rel="icon" href="/favicon.svg" />
</head>
<body class="admin-login">
  <div class="admin-login-layout">
  <aside class="admin-login-brand" aria-hidden="true">
    <img class="admin-login-brand__photo" src="/img/lh-editorial-team-wide.jpg" alt="" decoding="async" />
    <img class="admin-login-brand__logo" src={logo.src} alt="" width="150" height="58" />
    <div class="admin-login-brand__copy">
      <p class="admin-login-brand__eyebrow">Content workspace</p>
      <p class="admin-login-brand__title">Expanding minds, one publication at a time.</p>
      <p class="admin-login-brand__text">Manage the catalogue, pages and inquiries for Longhorn Publishers Cameroon, in English and French.</p>
    </div>
  </aside>
  <main>
    <header class="admin-login-header">
    <a href="/en/" class="brand"><img src="/img/longhorn-logo.png" alt="Longhorn Publishers Cameroon" width="136" height="36" /></a>
    <p class="eyebrow">Content workspace</p>
    <h1 id="title">Welcome back</h1>
    <p id="intro">Sign in to manage Longhorn’s bilingual catalogue and editorial content.</p>

    </header>

    <form id="activate" hidden>
      <p class="required-hint">Fields marked Required must be completed.</p>
      <label>
        <span>Create password <span class="required-marker">Required</span></span>
        <input name="password" type="password" autocomplete="new-password" required minlength="8" />
      </label>
      <label>
        <span>Confirm password <span class="required-marker">Required</span></span>
        <input name="confirmation" type="password" autocomplete="new-password" required minlength="8" />
      </label>
      <button type="submit">Activate administrator account <AdminIcon name="arrow" /></button>
    </form>

    <form id="login">
      <p class="required-hint">Fields marked Required must be completed.</p>
      <label>
        <span>Email address <span class="required-marker">Required</span></span>
        <input name="email" type="email" autocomplete="email" required placeholder="you@company.com" />
      </label>
      <label>
        <span>Password <span class="required-marker">Required</span></span>
        <input name="password" type="password" autocomplete="current-password" required minlength="8" />
      </label>
      <button type="submit">Sign in <AdminIcon name="arrow" /></button>
      <button class="text-button" type="button" id="showRecovery">Forgot your password?</button>
    </form>

    <form id="recoveryRequest" hidden>
      <p class="required-hint">Fields marked Required must be completed.</p>
      <label>
        <span>Administrator email <span class="required-marker">Required</span></span>
        <input name="email" type="email" autocomplete="email" required placeholder="you@company.com" />
      </label>
      <button type="submit">Send recovery link <AdminIcon name="arrow" /></button>
      <button class="text-button" type="button" data-back-login>Back to sign in</button>
    </form>

    <form id="resetPassword" hidden>
      <p class="required-hint">Fields marked Required must be completed.</p>
      <label>
        <span>New password <span class="required-marker">Required</span></span>
        <input name="password" type="password" autocomplete="new-password" required minlength="8" />
      </label>
      <label>
        <span>Confirm new password <span class="required-marker">Required</span></span>
        <input name="confirmation" type="password" autocomplete="new-password" required minlength="8" />
      </label>
      <button type="submit">Set new password <AdminIcon name="arrow" /></button>
    </form>

    <p id="status" role="status" aria-live="polite"></p>
  </main>
  </div>



  <script>
    import { acceptInvite, AuthError, getUser, handleAuthCallback, login, requestPasswordRecovery, updateUser } from '@netlify/identity';
    import { administratorAccessMessage, loginFailureMessage, loginStatus, loginFieldError, clearLoginErrors, beginLoginSubmission, endLoginSubmission } from '../../lib/admin-login-presentation';
    // The browser-side session (GoTrue localStorage) can outlive the 1-hour
    // nf_jwt token. Trusting it alone sent people to /admin/, where the server's
    // role rule bounced them back here: an endless reload loop. Only continue
    // when the server itself accepts the session; otherwise drop the stale one
    // and show the sign-in form. The timestamp guard caps redirects regardless.
    const REDIRECT_GUARD = 'lh-admin-login-redirect';
    function clearStaleSession() {
      try { localStorage.removeItem('gotrue.user'); } catch {}
      document.cookie = 'nf_jwt=; path=/; secure; samesite=lax; expires=Thu, 01 Jan 1970 00:00:00 GMT';
    }
    async function serverAcceptsSession() {
      try {
        const response = await fetch('/admin/', { redirect: 'manual', cache: 'no-store', credentials: 'same-origin' });
        return response.type !== 'opaqueredirect' && response.ok;
      } catch {
        return false;
      }
    }
    async function continueToAdminIfServerAgrees() {
      let last = 0;
      try { last = Number(sessionStorage.getItem(REDIRECT_GUARD) || 0); } catch {}
      if (Date.now() - last < 10_000 || !(await serverAcceptsSession())) {
        clearStaleSession();
        return;
      }
      try { sessionStorage.setItem(REDIRECT_GUARD, String(Date.now())); } catch {}
      location.href = '/admin/';
    }
    const status = document.querySelector<HTMLElement>('#status');
    const field = (form: HTMLFormElement, name: string) => form.elements.namedItem(name) as HTMLInputElement;
    const activationForm = document.querySelector('#activate') as HTMLFormElement | null;
    const loginForm = document.querySelector('#login') as HTMLFormElement | null;
    const recoveryForm = document.querySelector('#recoveryRequest') as HTMLFormElement | null;
    const resetForm = document.querySelector('#resetPassword') as HTMLFormElement | null;
    const title = document.querySelector('#title');
    const intro = document.querySelector('#intro');

    // Which emailed link brought the admin here. Netlify Identity consumes the
    // URL hash on the first load, so a refresh loses it entirely — without this
    // the second attempt cannot tell a dead recovery link from a dead session
    // and falls back to the generic "Could not check your session" message.
    const AUTH_FLOW_KEY = 'lh-admin-auth-flow';
    const rememberFlow = (flow: 'recovery' | 'invite') => {
      try { sessionStorage.setItem(AUTH_FLOW_KEY, flow); } catch { /* private mode */ }
    };
    const recallFlow = (): string | null => {
      try { return sessionStorage.getItem(AUTH_FLOW_KEY); } catch { return null; }
    };
    const forgetFlow = () => {
      try { sessionStorage.removeItem(AUTH_FLOW_KEY); } catch { /* private mode */ }
    };

    const openRecoveryForm = () => {
      if (!loginForm || !recoveryForm) return;
      loginForm.hidden = true; recoveryForm.hidden = false;
      title!.textContent = 'Recover your account';
      intro!.textContent = 'Enter your administrator email and we will send a secure password reset link.';
      clearLoginErrors(loginForm); loginStatus(status, '');
      field(recoveryForm, 'email').focus();
    };

    if (import.meta.env.DEV) {
      title!.textContent = 'Admin sign-in requires a deploy preview';
      intro!.textContent = 'Netlify Identity does not run in the local development server. You can test the local database and public CMS APIs here; test administrator login, roles, and protected writes on a Netlify deploy preview.';
      if (loginForm) loginForm.hidden = true;
      if (status) {
        status.textContent = 'Local Identity is intentionally unavailable in dev mode.';
        status.className = 'status status--info';
      }
    } else {
      try {
        const authHash = window.location.hash;
        const invitationToken = new URLSearchParams(authHash.substring(1)).get('invite_token');
        // Recorded before the callback runs, because it clears the hash.
        if (/(?:^#|&)recovery_token=/.test(authHash)) rememberFlow('recovery');
        else if (invitationToken) rememberFlow('invite');
        const callback = await handleAuthCallback();
        const token = callback?.type === 'invite' ? callback.token : invitationToken;

        if (callback?.type === 'recovery' && resetForm && loginForm) {
          title!.textContent = 'Set a new password';
          intro!.textContent = 'Choose a new password for your administrator account.';
          loginForm.hidden = true;
          resetForm.hidden = false;
          field(resetForm, 'password').focus();
        } else if (token && activationForm && loginForm) {
          title!.textContent = 'Activate administrator account';
          intro!.textContent = 'Create a password to finish accepting your invitation.';
          activationForm.hidden = false;
          loginForm.hidden = true;
          field(activationForm, 'password').focus();
          activationForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            const form = event.currentTarget as HTMLFormElement;
            const submit = form.querySelector('button') as HTMLButtonElement;
            if (submit.getAttribute('aria-disabled') === 'true') return;
            clearLoginErrors(form);
            const data = new FormData(form);
            const password = String(data.get('password'));

            if (password !== String(data.get('confirmation'))) {
              loginFieldError(status, 'Passwords do not match.', [field(form, 'confirmation')], true);
              return;
            }

            if (!beginLoginSubmission(submit)) return;
            loginStatus(status, 'Activating account…');

            try {
              const user = await acceptInvite(token, password);
              if (!user.roles?.includes('admin')) throw new Error(administratorAccessMessage);
              forgetFlow();
              location.href = '/admin/';
            } catch (error) {
              loginStatus(status, loginFailureMessage('invite', false, error instanceof Error && error.message === administratorAccessMessage), true);
            } finally {
              endLoginSubmission(submit);
            }
          });
        } else {
          const user = await getUser();
          if (user?.roles?.includes('admin')) await continueToAdminIfServerAgrees();
        }
      } catch {
        // The hash survives only the first load, so fall back to the recorded
        // flow: a refreshed recovery link must not be answered with invitation
        // copy, and must not be answered with the generic session message.
        const hash = window.location.hash;
        const flow = /(?:^#|&)recovery_token=/.test(hash)
          ? 'recovery'
          : /(?:^#|&)invite_token=/.test(hash)
            ? 'invite'
            : recallFlow();

        if (flow === 'recovery') {
          // Route them back into the recovery form rather than leaving them on
          // a dead end — the only useful next step is a fresh link.
          openRecoveryForm();
          loginStatus(status, 'This password recovery link has expired or was already used. Request a new one below.', true);
        } else if (status) {
          loginStatus(status, flow === 'invite'
            ? 'This invitation link is invalid or has expired. Request a new invitation.'
            : 'Could not check your session. Enter your credentials to sign in.', true);
        }
        forgetFlow();
      }

      document.querySelector('#login')?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        const submit = form.querySelector('button') as HTMLButtonElement;
        if (!beginLoginSubmission(submit)) return;
        clearLoginErrors(form);
        loginStatus(status, 'Signing in…');

        try {
          const user = await login(
            String(new FormData(form).get('email')),
            String(new FormData(form).get('password'))
          );
          if (!user.roles?.includes('admin')) throw new Error(administratorAccessMessage);
          location.href = '/admin/';
        } catch (error) {
          const invalidCredentials = error instanceof AuthError && error.status === 401;
          const message = loginFailureMessage('login', invalidCredentials, error instanceof Error && error.message === administratorAccessMessage);
          if (invalidCredentials) loginFieldError(status, message, [field(form, 'email'), field(form, 'password')]);
          else loginStatus(status, message, true);
        } finally {
          endLoginSubmission(submit);
        }
      });

      document.querySelector('#showRecovery')?.addEventListener('click', () => {
        if (!loginForm || !recoveryForm) return;
        const email = loginForm.elements.namedItem('email') as HTMLInputElement;
        openRecoveryForm();
        (recoveryForm.elements.namedItem('email') as HTMLInputElement).value = email.value;
      });

      document.querySelector('[data-back-login]')?.addEventListener('click', () => {
        if (!loginForm || !recoveryForm) return;
        recoveryForm.hidden = true; loginForm.hidden = false;
        title!.textContent = 'Welcome back';
        intro!.textContent = 'Sign in to manage Longhorn’s bilingual catalogue and editorial content.';
        clearLoginErrors(recoveryForm); loginStatus(status, '');
        field(loginForm, 'email').focus();
      });

      recoveryForm?.addEventListener('submit', async (event) => {
        event.preventDefault(); const form = event.currentTarget as HTMLFormElement; const submit = form.querySelector('button[type="submit"]') as HTMLButtonElement;
        if (!beginLoginSubmission(submit)) return;
        clearLoginErrors(form);
        loginStatus(status, 'Requesting recovery link…');
        try {
          await requestPasswordRecovery(String(new FormData(form).get('email')));
          loginStatus(status, 'If that administrator account exists, a recovery link has been sent.');
        } catch {
          loginStatus(status, 'Unable to request account recovery. Try again shortly.', true);
        } finally { endLoginSubmission(submit); }
      });

      resetForm?.addEventListener('submit', async (event) => {
        event.preventDefault(); const form = event.currentTarget as HTMLFormElement; const submit = form.querySelector('button') as HTMLButtonElement; const data = new FormData(form);
        if (submit.getAttribute('aria-disabled') === 'true') return;
        clearLoginErrors(form);
        if (String(data.get('password')) !== String(data.get('confirmation'))) {
          loginFieldError(status, 'Passwords do not match.', [field(form, 'confirmation')], true); return;
        }
        if (!beginLoginSubmission(submit)) return;
        loginStatus(status, 'Setting new password…');
        try {
          const user = await updateUser({ password: String(data.get('password')) });
          if (!user.roles?.includes('admin')) throw new Error(administratorAccessMessage);
          forgetFlow();
          location.href = '/admin/';
        } catch (error) {
          loginStatus(status, loginFailureMessage('reset', false, error instanceof Error && error.message === administratorAccessMessage), true);
        } finally { endLoginSubmission(submit); }
      });
    }
  </script>


</body>
</html>
