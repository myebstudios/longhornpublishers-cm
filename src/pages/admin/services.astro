---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Services & process" section="services">
  <div class="admin-page-head"><div><h1>Publishing Services & Process</h1><p>Create, publish, and order bilingual service offerings and process steps.</p></div></div>
  <div class="admin-split">
    <section class="card editor-card">
      <div class="toolbar"><h2 id="serviceTitle">New service</h2><button class="button secondary" type="button" id="resetService">Clear</button></div>
      <form id="serviceForm">
        <input type="hidden" name="id" />
        <div class="two">
          <label>Name — English<input name="name_en" required /></label><label>Name — French<input name="name_fr" required /></label>
          <label>Category<select name="category"><option value="editorial">Editorial</option><option value="creative">Creative</option><option value="production">Production</option></select></label>
          <label>Icon key<input name="icon" maxlength="60" /></label>
          <label>Description — English<textarea name="description_en" required></textarea></label><label>Description — French<textarea name="description_fr" required></textarea></label>
          <label>Sort order<input name="sort_order" type="number" min="0" value="0" required /></label>
          <label class="check"><input name="published" type="checkbox" /> Published</label>
        </div>
        <div class="form-actions"><button class="button" type="submit">Save service</button></div>
      </form>
    </section>
    <section class="card editor-card">
      <div class="toolbar"><h2 id="processTitle">New process step</h2><button class="button secondary" type="button" id="resetProcess">Clear</button></div>
      <form id="processForm">
        <input type="hidden" name="id" />
        <label>Step number<input name="step_number" type="number" min="1" value="1" required /></label>
        <div class="two">
          <label>Title — English<input name="title_en" required /></label><label>Title — French<input name="title_fr" required /></label>
          <label>Description — English<textarea name="description_en" required></textarea></label><label>Description — French<textarea name="description_fr" required></textarea></label>
        </div>
        <div class="form-actions"><button class="button" type="submit">Save process step</button></div>
      </form>
    </section>
  </div>
  <section class="card"><h2>Services</h2><div id="services" class="ordered-list"></div></section>
  <section class="card"><h2>Process steps</h2><div id="process" class="ordered-list"></div></section>
  <p id="status" role="status" aria-live="polite"></p>
</AdminLayout>

<script>
  import { confirmAction, request, sendJson } from '../../lib/admin-client';
  type Row = Record<string, any>;
  const serviceForm = document.querySelector('#serviceForm') as HTMLFormElement;
  const processForm = document.querySelector('#processForm') as HTMLFormElement;
  const serviceList = document.querySelector('#services')!; const processList = document.querySelector('#process')!;
  const status = document.querySelector('#status')!; let services: Row[] = []; let process: Row[] = [];
  const setStatus = (message: string, tone: 'ok' | 'err' = 'ok') => { status.textContent = message; status.className = message ? `status status--${tone}` : ''; };
  const setFields = (form: HTMLFormElement, row: Row) => Object.entries(row).forEach(([key, value]) => { const field = form.elements.namedItem(key) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null; if (field && key !== 'published') field.value = String(value ?? ''); });
  const resetService = () => { serviceForm.reset(); (serviceForm.elements.namedItem('id') as HTMLInputElement).value = ''; (serviceForm.elements.namedItem('sort_order') as HTMLInputElement).value = String(services.length); document.querySelector('#serviceTitle')!.textContent = 'New service'; };
  const resetProcess = () => { processForm.reset(); (processForm.elements.namedItem('id') as HTMLInputElement).value = ''; (processForm.elements.namedItem('step_number') as HTMLInputElement).value = String(process.length + 1); document.querySelector('#processTitle')!.textContent = 'New process step'; };
  document.querySelector('#resetService')!.addEventListener('click', resetService); document.querySelector('#resetProcess')!.addEventListener('click', resetProcess);

  async function remove(kind: 'service' | 'process', row: Row) {
    if (!(await confirmAction(`Delete “${row.name_en ?? row.title_en}”?`))) return;
    const res = await request(`/api/services-admin?kind=${kind}&id=${encodeURIComponent(row.id)}`, { method: 'DELETE' }, 'Unable to delete item.');
    setStatus(res.ok ? 'Item deleted.' : res.error!, res.ok ? 'ok' : 'err'); if (res.ok) load();
  }
  async function move(kind: 'service' | 'process', rows: Row[], index: number, direction: number) {
    const next = index + direction; if (next < 0 || next >= rows.length) return;
    const ordered = [...rows]; [ordered[index], ordered[next]] = [ordered[next], ordered[index]];
    const res = await sendJson(`/api/services-admin?kind=${kind}`, 'PUT', { action: 'reorder', ids: ordered.map(row => row.id) }, 'Unable to reorder items.');
    setStatus(res.ok ? 'Order saved.' : res.error!, res.ok ? 'ok' : 'err'); if (res.ok) load();
  }
  function render() {
    serviceList.replaceChildren(); services.forEach((row, index) => serviceList.append(item(row.name_en, row.name_fr, row.published ? 'Published' : 'Draft', () => { setFields(serviceForm, row); (serviceForm.elements.namedItem('published') as HTMLInputElement).checked = Boolean(row.published); document.querySelector('#serviceTitle')!.textContent = `Editing: ${row.name_en}`; }, () => move('service', services, index, -1), () => move('service', services, index, 1), () => remove('service', row))));
    processList.replaceChildren(); process.forEach((row, index) => processList.append(item(`${row.step_number}. ${row.title_en}`, row.title_fr, 'Public', () => { setFields(processForm, row); document.querySelector('#processTitle')!.textContent = `Editing: ${row.title_en}`; }, () => move('process', process, index, -1), () => move('process', process, index, 1), () => remove('process', row))));
  }
  function item(primary: string, secondary: string, badge: string, edit: () => void, up: () => void, down: () => void, removeItem: () => void) {
    const article = document.createElement('article'); article.className = 'ordered-item';
    const copy = document.createElement('div'); const heading = document.createElement('h3'); heading.textContent = primary; const sub = document.createElement('p'); sub.textContent = secondary; copy.append(heading, sub);
    const state = document.createElement('span'); state.className = 'admin-badge'; state.textContent = badge;
    const actions = document.createElement('div'); actions.className = 'ordered-actions';
    for (const [label, action] of [['↑', up], ['↓', down], ['Edit', edit], ['Delete', removeItem]] as const) { const button = document.createElement('button'); button.type = 'button'; button.className = label === 'Delete' ? 'button danger' : 'button secondary'; button.textContent = label; button.addEventListener('click', action); actions.append(button); }
    article.append(copy, state, actions); return article;
  }
  async function load() {
    const res = await request<{ services: Row[]; process: Row[] }>('/api/services-admin', {}, 'Unable to load services.');
    if (!res.ok || !res.data) return setStatus(res.error!, 'err'); services = res.data.services; process = res.data.process; render(); resetService(); resetProcess();
  }
  serviceForm.addEventListener('submit', async (event) => {
    event.preventDefault(); const data = new FormData(serviceForm); const id = String(data.get('id') ?? '');
    const payload = Object.fromEntries(data.entries()) as Row; payload.published = (serviceForm.elements.namedItem('published') as HTMLInputElement).checked; payload.sort_order = Number(payload.sort_order);
    const res = await sendJson(`/api/services-admin?kind=service${id ? `&id=${encodeURIComponent(id)}` : ''}`, id ? 'PUT' : 'POST', payload, 'Unable to save service.'); setStatus(res.ok ? 'Service saved.' : res.error!, res.ok ? 'ok' : 'err'); if (res.ok) load();
  });
  processForm.addEventListener('submit', async (event) => {
    event.preventDefault(); const data = new FormData(processForm); const id = String(data.get('id') ?? ''); const payload = Object.fromEntries(data.entries()) as Row; payload.step_number = Number(payload.step_number);
    const res = await sendJson(`/api/services-admin?kind=process${id ? `&id=${encodeURIComponent(id)}` : ''}`, id ? 'PUT' : 'POST', payload, 'Unable to save process step.'); setStatus(res.ok ? 'Process step saved.' : res.error!, res.ok ? 'ok' : 'err'); if (res.ok) load();
  });
  load();
</script>

<style>
  .admin-split { display:grid; grid-template-columns:1fr 1fr; gap:24px; }
  .ordered-list { display:grid; gap:10px; margin-top:18px; }
  .ordered-item { display:grid; grid-template-columns:1fr auto auto; gap:16px; align-items:center; padding:14px; border:1px solid var(--line); border-radius:12px; }
  .ordered-item h3,.ordered-item p { margin:0; } .ordered-item p { color:var(--muted); }
  .ordered-actions { display:flex; gap:8px; flex-wrap:wrap; }
  @media (max-width: 980px) { .admin-split { grid-template-columns:1fr; } .ordered-item { grid-template-columns:1fr; } }
</style>
