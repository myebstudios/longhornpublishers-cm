---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import AdminSaveBar from '../../components/admin/AdminSaveBar.astro';

import AdminEditorDialog from '../../components/admin/AdminEditorDialog.astro';
---
<AdminLayout title="Services & process" section="services">
<AdminPageHeader heading="Publishing Services & Process" subtitle="Manage bilingual B2B service offerings and step-by-step author publishing workflows."></AdminPageHeader>
<section id="adminCanvas" aria-busy="true"><p role="status">Loading saved content…</p></section>
<AdminEditorDialog>
<form hidden id="serviceForm"><h2 id="serviceTitle">Service details</h2>
        <input type="hidden" name="id" />
        <div class="two">
          <label>Name — English<input name="name_en" required lang="en" /></label><label>Name — French<input name="name_fr" required lang="fr" /></label>
          <label>Slug<input name="slug" maxlength="80" pattern="[a-z0-9]+(-[a-z0-9]+)*" /><small>Keys the detail photograph and the on-page anchor, e.g. editing.</small></label>
          <label>Summary — English<input name="short_en" maxlength="500" lang="en" /><small>One line on the overview card. Separate from the detail body below.</small></label>
          <label>Summary — French<input name="short_fr" maxlength="500" lang="fr" /></label>
          <label>Category<select name="category"><option value="editorial">Editorial</option><option value="creative">Creative</option><option value="production">Production</option></select></label>
          <label>Icon key<input name="icon" maxlength="60" /></label>
          <label>Description — English<textarea name="description_en" required lang="en"></textarea></label><label>Description — French<textarea name="description_fr" required lang="fr"></textarea></label>
          <label>Sort order<input name="sort_order" type="number" min="0" value="0" required /></label>
          <label class="check"><input name="published" type="checkbox" /> Published</label>
        </div>
        <AdminSaveBar><button class="button" type="submit">Save service</button></AdminSaveBar>
      </form><form hidden id="processForm"><h2 id="processTitle">Process details</h2>
        <input type="hidden" name="id" />
        <label>Step number<input name="step_number" type="number" min="1" value="1" required /></label>
        <div class="two">
          <label>Title — English<input name="title_en" required lang="en" /></label><label>Title — French<input name="title_fr" required lang="fr" /></label>
          <label>Description — English<textarea name="description_en" required lang="en"></textarea></label><label>Description — French<textarea name="description_fr" required lang="fr"></textarea></label>
        </div>
        <label class="check"><input name="published" type="checkbox" /> Published — visible on the public site</label>
        <AdminSaveBar><button class="button" type="submit">Save process step</button></AdminSaveBar>
      </form>
</AdminEditorDialog>
</AdminLayout>
<script>
import { startAdminV2 } from '../../lib/admin-v2';
void startAdminV2('services');
</script>
