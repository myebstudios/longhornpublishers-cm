---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import AdminSaveBar from '../../components/admin/AdminSaveBar.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
---
<AdminLayout title="News & updates" section="news">
  <AdminPageHeader heading="News & Updates" subtitle="Draft and publish company news, educational announcements, and press releases."><button class="button" type="button" id="openEditorBtn">+ Create article</button></AdminPageHeader>

  <!-- Collapsible Editor Form Card -->


  <!-- Primary Article List & Search View -->
  <section class="card list-card">
    <div class="list-toolbar">
      <div class="search-box">
        <AdminIcon name="search" />
        <input type="search" id="searchFilter" placeholder="Search news articles by headline or slug..." aria-label="Search news articles" />
      </div>
      <div class="filter-controls">
        <select id="filterCategory" aria-label="Filter by article category">
          <option value="all">All categories</option>
          <option value="company_news">Company News</option>
          <option value="new_titles">New Titles</option>
          <option value="partnerships">Partnerships</option>
          <option value="events">Events</option>
        </select>
        <select id="filterStatus" aria-label="Filter by article status">
          <option value="all">All publication states</option>
          <option value="published">Published</option>
          <option value="draft">Drafts</option>
        </select>
      </div>
    </div>

    <div id="empty" class="empty-container"></div>
    <div class="record-head news-columns" aria-hidden="true"><span>Headline &amp; category</span><span>Publish date</span><span>Status</span><span>Actions</span></div><div id="items" class="news-list"></div>
  </section>
  <section class="card editor-card" id="editorCard">
    <div class="toolbar">
      <h2 id="editorTitle">New news article</h2>
      <button class="button secondary" type="button" id="closeEditorBtn">Close editor</button>
    </div>
    <form id="editor">
      <input type="hidden" name="id" />
      <fieldset class="two"><legend>Article details</legend>
        <label>English headline<input name="headline_en" required placeholder="e.g. Longhorn Expands Bilingual Distribution in Cameroon" lang="en" /></label>
        <label>French headline<input name="headline_fr" required placeholder="e.g. Longhorn Étend sa Distribution Bilingue au Cameroun" lang="fr" /></label>
        <label>Slug<input name="slug" required pattern="[a-z0-9-]+" placeholder="bilingual-distribution-cameroon" /></label>
        <label>Category
          <select name="category">
            <option value="company_news">Company news</option>
            <option value="new_titles">New titles</option>
            <option value="partnerships">Partnerships</option>
            <option value="events">Events</option>
          </select>
        </label>
        <label>Stated publication date<input name="publish_date" type="date" /><small>Historical or display date; does not schedule automated release.</small></label>
        <label class="check"><input name="published" type="checkbox" /> Published</label>
        <label>English excerpt<textarea name="excerpt_en" required placeholder="Brief article summary for news cards..." lang="en"></textarea></label>
        <label>French excerpt<textarea name="excerpt_fr" required placeholder="Résumé concis pour les cartes d'actualités..." lang="fr"></textarea></label>
      </fieldset>

      <label>English article body<textarea name="body_en" required placeholder="Full article content in English..." lang="en"></textarea></label>
      <label>French article body<textarea name="body_fr" required placeholder="Contenu complet en français..." lang="fr"></textarea></label>

      <AdminSaveBar>
        <button class="button" type="submit">Save article</button>
        <button class="button secondary" type="button" id="cancelEditorBtn">Cancel</button>
      </AdminSaveBar>
      <p id="status" role="status" aria-live="polite"></p>
    </form>
  </section>
</AdminLayout>

<script>
  import { adminIcon } from '../../lib/admin-icons';
  import { confirmAction, emptyToNull, errorCard, registerDirtyCheck, request, sendJson } from '../../lib/admin-client';

  type CmsRecord = { [key: string]: any };

  const form = document.querySelector('#editor') as HTMLFormElement;
  const submit = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const items = document.querySelector('#items')!;
  const empty = document.querySelector('#empty')!;
  const status = document.querySelector('#status')!;
  const title = document.querySelector('#editorTitle')!;

  const editorCard = document.querySelector('#editorCard') as HTMLElement;
  const openEditorBtn = document.querySelector('#openEditorBtn') as HTMLButtonElement;
  const closeEditorBtn = document.querySelector('#closeEditorBtn') as HTMLButtonElement;
  const cancelEditorBtn = document.querySelector('#cancelEditorBtn') as HTMLButtonElement;

  const setStatus = (message: string, tone: 'ok' | 'err' = 'ok') => {
    status.textContent = message;
    status.className = message ? `status status--${tone}` : '';
  };

  let pristine = '';
  const snapshot = () => new URLSearchParams(new FormData(form) as any).toString();
  const isDirty = () => snapshot() !== pristine;
  const confirmDiscard = async () =>
    !isDirty() || (await confirmAction('This form has unsaved changes. Discard them?'));

  const showEditor = (isNew = false) => {
    editorCard.removeAttribute('hidden');
    if (isNew) title.textContent = 'Create New Article';
    editorCard.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    const firstInput = form.querySelector('input[name="headline_en"]') as HTMLInputElement | null;
    if (firstInput) firstInput.focus();
  };

  const hideEditor = async () => {
    if (await confirmDiscard()) {
      await reset(true);
      editorCard.setAttribute('hidden', '');
      setStatus('');
    }
  };

  openEditorBtn.addEventListener('click', async () => {
    if (await reset(true)) showEditor(true);
  });

  closeEditorBtn.addEventListener('click', hideEditor);
  cancelEditorBtn.addEventListener('click', hideEditor);

  const reset = async (force = false) => {
    if (!force && !(await confirmDiscard())) return false;
    form.reset();
    (form.elements.namedItem('id') as HTMLInputElement).value = '';
    title.textContent = 'Create New Article';
    setStatus('');
    pristine = snapshot();
    return true;
  };

  const values = () => {
    const record = Object.fromEntries(new FormData(form).entries()) as CmsRecord;
    record.published = (form.elements.namedItem('published') as HTMLInputElement).checked;
    return emptyToNull(record, ['publish_date']);
  };

  const edit = async (entry: CmsRecord) => {
    if (!(await confirmDiscard())) return;
    for (const [key, value] of Object.entries(entry)) {
      const input = form.elements.namedItem(key) as HTMLInputElement | HTMLTextAreaElement | null;
      if (input && typeof value === 'string') {
        input.value = key === 'publish_date' && value ? value.slice(0, 10) : value;
      }
    }
    (form.elements.namedItem('id') as HTMLInputElement).value = entry.id;
    (form.elements.namedItem('published') as HTMLInputElement).checked = Boolean(entry.published);
    title.textContent = `Editing: ${entry.headline_en}`;
    setStatus('');
    pristine = snapshot();
    showEditor(false);
  };

  let allRows: CmsRecord[] = [];
  const searchFilter = document.querySelector('#searchFilter') as HTMLInputElement | null;
  const filterCategory = document.querySelector('#filterCategory') as HTMLSelectElement | null;
  const filterStatus = document.querySelector('#filterStatus') as HTMLSelectElement | null;

  function renderList() {
    const query = (searchFilter?.value || '').toLowerCase().trim();
    const cat = filterCategory?.value || 'all';
    const statusVal = filterStatus?.value || 'all';

    const filtered = allRows.filter(entry => {
      const matchQuery = !query ||
        String(entry.headline_en || '').toLowerCase().includes(query) ||
        String(entry.headline_fr || '').toLowerCase().includes(query) ||
        String(entry.slug || '').toLowerCase().includes(query);
      const matchCat = cat === 'all' || String(entry.category).toLowerCase() === cat;
      const matchStatus = statusVal === 'all' || (statusVal === 'published' ? entry.published : !entry.published);
      return matchQuery && matchCat && matchStatus;
    });

    items.replaceChildren();
    empty.replaceChildren();

    if (!filtered.length) {
      const card = document.createElement('div');
      card.className = 'admin-empty-state';

      const icon = document.createElement('div');
      icon.className = 'admin-empty-icon';
      icon.innerHTML = adminIcon('newspaper');

      const titleEl = document.createElement('h3');
      titleEl.className = 'admin-empty-title';
      titleEl.textContent = allRows.length ? 'No Matching Articles Found' : 'Editorial Desk is Empty';

      const text = document.createElement('p');
      text.className = 'admin-empty-text';
      text.textContent = allRows.length
        ? 'No news articles match your current search filters. Try clearing your category or status filters.'
        : 'Get started by creating your first bilingual news article, partnership announcement, or title release.';

      card.append(icon, titleEl, text);

      if (allRows.length) {
        const resetBtn = document.createElement('button');
        resetBtn.type = 'button';
        resetBtn.className = 'button secondary';
        resetBtn.textContent = 'Clear Filters';
        resetBtn.onclick = () => {
          if (searchFilter) searchFilter.value = '';
          if (filterCategory) filterCategory.value = 'all';
          if (filterStatus) filterStatus.value = 'all';
          renderList();
        };
        card.append(resetBtn);
      } else {
        const createBtn = document.createElement('button');
        createBtn.type = 'button';
        createBtn.className = 'button';
        createBtn.textContent = '+ Create First Article';
        createBtn.onclick = async () => {
          if (await reset(true)) showEditor(true);
        };
        card.append(createBtn);
      }

      empty.append(card);
      return;
    }

    filtered.forEach(entry => {
      const article = document.createElement('article');
      article.className = 'news-item-card';

      const heading = document.createElement('div');
      heading.className = 'title-info';
      const titleStrong = document.createElement('strong');
      titleStrong.textContent = entry.headline_en;
      const alternate = document.createElement('small');
      alternate.className = 'alt';
      alternate.textContent = entry.headline_fr ?? '—';
      heading.append(titleStrong, alternate);

      const meta = document.createElement('div');
      meta.className = 'item-meta';
      const catSpan = document.createElement('span');
      catSpan.className = 'admin-badge admin-badge--purple';
      catSpan.textContent = String(entry.category ?? '').replace('_', ' ').toUpperCase();
      const statusSpan = document.createElement('span');
      statusSpan.className = entry.published ? 'admin-badge admin-badge--published' : 'admin-badge admin-badge--draft';
      statusSpan.textContent = entry.published ? 'Published' : 'Draft';
      heading.dataset.label='Headline & category'; heading.append(catSpan);
      meta.dataset.label='Status'; meta.append(statusSpan);
      const date = document.createElement('div'); date.dataset.label='Publish date'; date.textContent=entry.publish_date ? String(entry.publish_date).slice(0,10) : 'Not stated';

      const actions = document.createElement('div');
      actions.className = 'item-actions'; actions.dataset.label='Actions';

      const editButton = document.createElement('button');
      editButton.type = 'button';
      editButton.className = 'button secondary';
      editButton.textContent = 'Edit';
      editButton.setAttribute('aria-label', `Edit ${entry.headline_en}`);
      editButton.onclick = () => edit(entry);

      const deleteButton = document.createElement('button');
      deleteButton.type = 'button';
      deleteButton.className = 'button danger';
      deleteButton.textContent = 'Delete';
      deleteButton.setAttribute('aria-label', `Delete ${entry.headline_en}`);
      deleteButton.onclick = async () => {
        if (!(await confirmAction(`Delete “${entry.headline_en}”?`))) return;
        deleteButton.disabled = true;
        const result = await request(
          `/api/news-admin?id=${encodeURIComponent(entry.id)}`,
          { method: 'DELETE' },
          'Unable to delete article.',
        );
        if (!result.ok) { deleteButton.disabled = false; setStatus(result.error!, 'err'); return; }
        if ((form.elements.namedItem('id') as HTMLInputElement).value === String(entry.id)) {
          await reset(true);
          editorCard.setAttribute('hidden', '');
        }
        setStatus('Article deleted.');
        await load();
      };

      actions.append(editButton, deleteButton);
      article.append(heading, date, meta, actions);
      items.append(article);
    });
  }

  async function load() {
    items.replaceChildren();
    empty.replaceChildren();

    // Render skeleton loading items
    for (let i = 0; i < 3; i++) {
      const skel = document.createElement('div');
      skel.className = 'admin-skeleton-card admin-skeleton';
      skel.style.height = '72px';
      items.append(skel);
    }

    const result = await request<CmsRecord[]>('/api/news-admin', {}, 'Unable to load articles.');
    if (!result.ok) {
      items.replaceChildren();
      empty.replaceChildren(errorCard('Editorial News Unavailable', result.error!));
      return;
    }
    allRows = result.data ?? [];
    renderList();
  }

  searchFilter?.addEventListener('input', renderList);
  filterCategory?.addEventListener('change', renderList);
  filterStatus?.addEventListener('change', renderList);

  form.addEventListener('submit', async event => {
    event.preventDefault();
    if (submit.disabled) return;
    submit.disabled = true;
    setStatus('Saving…');
    try {
      const record = values();
      const result = await sendJson(
        `/api/news-admin${record.id ? `?id=${encodeURIComponent(String(record.id))}` : ''}`,
        record.id ? 'PUT' : 'POST',
        record,
        'Unable to save article.',
      );
      if (!result.ok) { setStatus(result.error!, 'err'); return; }
      setStatus(record.published ? 'Article published.' : 'Draft saved.');
      await reset(true);
      editorCard.setAttribute('hidden', '');
      await load();
    } finally {
      submit.disabled = false;
    }
  });

  // These screens track their own baseline around load/reset, so they register
  // that check rather than taking a second one. registerDirtyCheck also installs
  // the shared beforeunload and in-app navigation interception.
  registerDirtyCheck(isDirty);

  pristine = snapshot();
  load();
</script>
