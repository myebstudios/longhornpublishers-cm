---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import AdminSaveBar from '../../components/admin/AdminSaveBar.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';

import AdminEditorDialog from '../../components/admin/AdminEditorDialog.astro';
---
<AdminLayout title="News & updates" section="news">
<AdminPageHeader heading="News & Updates" subtitle="Draft and publish company news, educational announcements, and press releases."><button class="button" type="button" id="openEditorBtn">+ Create article</button></AdminPageHeader>
<section id="adminCanvas" aria-busy="true"><p role="status">Loading saved content…</p></section>
<AdminEditorDialog legacyEditor>
<form hidden id="editor">
      <input type="hidden" name="id" />
      <fieldset class="two"><legend>Content</legend><label>English headline<input name="headline_en" required placeholder="e.g. Longhorn Expands Bilingual Distribution in Cameroon" lang="en" /></label><label>French headline<input name="headline_fr" required placeholder="e.g. Longhorn Étend sa Distribution Bilingue au Cameroun" lang="fr" /></label><label>English excerpt<textarea name="excerpt_en" required placeholder="Brief article summary for news cards..." lang="en"></textarea></label><label>French excerpt<textarea name="excerpt_fr" required placeholder="Résumé concis pour les cartes d'actualités..." lang="fr"></textarea></label><label>English article body<textarea name="body_en" required placeholder="Full article content in English..." lang="en"></textarea></label><label>French article body<textarea name="body_fr" required placeholder="Contenu complet en français..." lang="fr"></textarea></label></fieldset><fieldset><legend>Article image</legend><input type="hidden" name="hero_image_id" /><div class="media-field"><p id="newsImageEmpty">No image added</p><img id="newsImagePreview" alt="News image preview" width="640" height="360" hidden /><label>Choose or replace image<input id="newsImageFile" type="file" accept="image/jpeg,image/png,image/webp" /></label><button class="button secondary" id="newsImageClear" type="button">Remove image</button><small>JPEG, PNG or WebP, up to 8 MB. Landscape 16:9.</small><span id="newsImageStatus" role="status" aria-live="polite"></span></div></fieldset><fieldset class="two"><legend>Metadata</legend><label>Slug<input name="slug" required pattern="[a-z0-9-]+" placeholder="bilingual-distribution-cameroon" /></label><label>Category
          <select name="category">
            <option value="company_news">Company news</option>
            <option value="new_titles">New titles</option>
            <option value="partnerships">Partnerships</option>
            <option value="events">Events</option>
          </select>
        </label><label>Stated publication date<input name="publish_date" type="date" /><small>Historical or display date; does not schedule automated release.</small></label></fieldset><fieldset><legend>Publication</legend><label class="check"><input name="published" type="checkbox" /> Published</label></fieldset>
      <AdminSaveBar>
        <button class="button" type="submit">Save article</button>
        <button class="button secondary" type="button" id="cancelEditorBtn">Cancel</button>
      </AdminSaveBar>
      <p id="status" role="status" aria-live="polite"></p>
    </form>
</AdminEditorDialog>
</AdminLayout>
<script>
import { startAdminV2 } from '../../lib/admin-v2';
void startAdminV2('news');
</script>
