---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="News & updates" section="news">
  <h1>News & updates</h1><p>Prepare bilingual editorial drafts; publication remains accountable to the designated content owner.</p>
  <section class="card"><div class="toolbar"><h2 id="editorTitle">New article</h2><button class="button secondary" type="button" id="reset">New article</button></div><form id="editor"><input type="hidden" name="id" /><div class="two"><label>English headline<input name="headline_en" required /></label><label>French headline<input name="headline_fr" required /></label><label>Slug<input name="slug" required pattern="[a-z0-9-]+" /></label><label>Category<select name="category"><option value="company_news">Company news</option><option value="new_titles">New titles</option><option value="partnerships">Partnerships</option><option value="events">Events</option></select></label><label>Publish date<input name="publish_date" type="date" /></label><label class="check"><input name="published" type="checkbox" /> Publish now</label><label>English excerpt<textarea name="excerpt_en" required></textarea></label><label>French excerpt<textarea name="excerpt_fr" required></textarea></label></div><label>English article body<textarea name="body_en" required></textarea></label><label>French article body<textarea name="body_fr" required></textarea></label><button class="button">Save draft</button><p id="status" role="status" aria-live="polite"></p></form></section><section class="card"><h2>Articles</h2><p id="empty">Loading articles…</p><div id="items" class="items"></div></section>
</AdminLayout>
<script>
  type CmsRecord = { [key: string]: any }; const form = document.querySelector('#editor') as HTMLFormElement; const items = document.querySelector('#items')!; const empty = document.querySelector('#empty')!; const status = document.querySelector('#status')!; const title = document.querySelector('#editorTitle')!; const setStatus = (message:string, tone:'ok'|'err'='ok') => { status.textContent = message; status.className = message ? `status status--${tone}` : ''; };
  const reset = () => { form.reset(); (form.elements.namedItem('id') as HTMLInputElement).value=''; title.textContent='New article'; setStatus(''); };
  const data = () => Object.fromEntries(new FormData(form).entries()) as CmsRecord;
  const edit = (entry:CmsRecord) => { for (const [key,value] of Object.entries(entry)) { const input = form.elements.namedItem(key) as HTMLInputElement|HTMLTextAreaElement|null; if (input && typeof value === 'string') input.value = key === 'publish_date' && value ? value.slice(0,10) : value; } (form.elements.namedItem('id') as HTMLInputElement).value=entry.id; (form.elements.namedItem('published') as HTMLInputElement).checked=entry.published; title.textContent=`Editing: ${entry.headline_en}`; window.scrollTo({top:0,behavior:'smooth'}); };
  async function load() { try { const response=await fetch('/api/news-admin'); if(!response.ok) throw new Error('Unable to load articles.'); const rows:CmsRecord[]=await response.json(); items.replaceChildren(); empty.textContent=rows.length?'':'No articles yet. Create a bilingual draft.'; rows.forEach(entry=>{const article=document.createElement('article');article.className='item';const heading=document.createElement('strong');heading.textContent=entry.headline_en;const meta=document.createElement('span');meta.textContent=`${entry.category.replace('_',' ')} · ${entry.published?'Published':'Draft'}`;const editButton=document.createElement('button');editButton.textContent='Edit';editButton.type='button';editButton.onclick=()=>edit(entry);const deleteButton=document.createElement('button');deleteButton.textContent='Delete';deleteButton.className='danger';deleteButton.type='button';deleteButton.onclick=async()=>{if(!confirm(`Delete “${entry.headline_en}”?`))return;const result=await fetch(`/api/news-admin?id=${encodeURIComponent(entry.id)}`,{method:'DELETE'});if(!result.ok)return setStatus('Unable to delete article.', 'err');reset();await load();};article.append(heading,meta,editButton,deleteButton);items.append(article);});}catch(error){empty.textContent=error instanceof Error?error.message:'Unable to load articles.';}}
  form.addEventListener('submit',async event=>{event.preventDefault();const record=data();record.published=Boolean((form.elements.namedItem('published') as HTMLInputElement).checked);const response=await fetch(`/api/news-admin${record.id?`?id=${encodeURIComponent(record.id)}`:''}`,{method:record.id?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(record)});const result=await response.json();if(!response.ok)return setStatus(result.error||'Unable to save article.', 'err');setStatus(record.published?'Article published.':'Draft saved.');reset();await load();});document.querySelector('#reset')?.addEventListener('click',reset);load();
</script>
<style>.toolbar{display:flex;justify-content:space-between;align-items:center;gap:1rem}.two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}form{display:grid;gap:1rem}.two label,form>label{display:grid;gap:.35rem;font-weight:600}.two input,.two textarea,.two select,form>label textarea{font:inherit;padding:.65rem;border:1px solid #cdbebe;border-radius:.45rem}.two textarea,form>label textarea{min-height:5rem;resize:vertical}form>label textarea{min-height:10rem}.check{align-content:end}.secondary{background:#695b5b}.items{display:grid;gap:.75rem}.item{display:grid;grid-template-columns:1fr auto auto auto;align-items:center;gap:.75rem;border-top:1px solid #eadede;padding:.85rem 0}.item span{color:#695b5b}.item button{border:0;border-radius:.4rem;padding:.45rem .65rem;cursor:pointer}.danger{color:#8b1e31;background:#fbe8eb}@media(max-width:720px){.two{grid-template-columns:1fr}.item{grid-template-columns:1fr auto auto}.item span{grid-column:1/-1;grid-row:2}}</style>
