---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import AdminSaveBar from '../../components/admin/AdminSaveBar.astro';

import AdminEditorDialog from '../../components/admin/AdminEditorDialog.astro';
---
<AdminLayout title="About us" section="about">
<AdminPageHeader heading="About Us" subtitle="Manage company heritage, institutional vision, mission statements, and operational team capacity."></AdminPageHeader>
<section id="adminCanvas" aria-busy="true"><p role="status">Loading saved content…</p></section>
<AdminEditorDialog>
<form hidden id="aboutForm">
      <h2>Heritage</h2>
      <div class="two">
        <label>Heritage copy — English<textarea name="heritage_copy_en" required lang="en"></textarea></label>
        <label>Heritage copy — French<textarea name="heritage_copy_fr" required lang="fr"></textarea></label>
      </div>
      <h2>Identity</h2>
      <div class="two">
        <label>Purpose — English<textarea name="purpose_en" required lang="en"></textarea></label>
        <label>Purpose — French<textarea name="purpose_fr" required lang="fr"></textarea></label>
        <label>Vision — English<textarea name="vision_en" required lang="en"></textarea></label>
        <label>Vision — French<textarea name="vision_fr" required lang="fr"></textarea></label>
        <label>Mission — English<textarea name="mission_en" required lang="en"></textarea></label>
        <label>Mission — French<textarea name="mission_fr" required lang="fr"></textarea></label>
        <label>Values — English<textarea name="values_en" required lang="en"></textarea></label>
        <label>Values — French<textarea name="values_fr" required lang="fr"></textarea></label>
      </div>
      <div class="toolbar"><h2>Team capacity blocks</h2><button class="button secondary" type="button" id="addBlock">+ Add block</button></div>
      <div id="blocks" class="repeat-list"></div>
      <label class="check"><input name="published" type="checkbox" /> Published — visible on the public site</label>
      <AdminSaveBar><button class="button" type="submit">Save About page</button></AdminSaveBar>
      <p id="status" role="status" aria-live="polite"></p>
    </form>
</AdminEditorDialog>
</AdminLayout>
<script>
import { startAdminV2 } from '../../lib/admin-v2';
void startAdminV2('about');
</script>
