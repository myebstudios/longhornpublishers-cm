---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Contact" section="contact">
  <div class="admin-page-head"><div><h1>Contact</h1><p>Manage bilingual hero copy, project types, and the map pin.</p></div></div>
  <section class="card editor-card">
    <form id="contactForm">
      <div class="two">
        <label>Hero copy — English<textarea name="hero_copy_en" required></textarea></label>
        <label>Hero copy — French<textarea name="hero_copy_fr" required></textarea></label>
        <label>Map latitude<input name="map_lat" type="number" min="-90" max="90" step="any"></label>
        <label>Map longitude<input name="map_lng" type="number" min="-180" max="180" step="any"></label>
      </div>
      <div class="toolbar"><h2>Project type options</h2><button class="button secondary" type="button" id="addOption">+ Add option</button></div>
      <div id="options" class="repeat-list"></div>
      <div class="form-actions"><button class="button" type="submit">Save Contact page</button></div>
      <p id="status" role="status" aria-live="polite"></p>
    </form>
  </section>
</AdminLayout>

<script>
  import { request, sendJson } from '../../lib/admin-client';
  const form = document.querySelector('#contactForm') as HTMLFormElement;
  const options = document.querySelector('#options')!;
  const status = document.querySelector('#status')!;
  const submit = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const setStatus = (message: string, tone: 'ok' | 'err' = 'ok') => { status.textContent = message; status.className = message ? `status status--${tone}` : ''; };
  function addOption(en = '', fr = '') {
    const row = document.createElement('div'); row.className = 'repeat-row';
    row.innerHTML = '<label>English label<input data-en maxlength="160" required></label><label>French label<input data-fr maxlength="160" required></label><button class="button danger" type="button">Remove</button>';
    (row.querySelector('[data-en]') as HTMLInputElement).value = en; (row.querySelector('[data-fr]') as HTMLInputElement).value = fr;
    row.querySelector('button')!.addEventListener('click', () => row.remove()); options.append(row);
  }
  document.querySelector('#addOption')!.addEventListener('click', () => addOption());
  async function load() {
    const res = await request<Record<string, any> | null>('/api/contact-settings-admin', {}, 'Unable to load Contact settings.');
    if (!res.ok) return setStatus(res.error!, 'err');
    if (!res.data) return setStatus('No database row yet. Enter complete bilingual content to create it.');
    for (const name of ['hero_copy_en', 'hero_copy_fr', 'map_lat', 'map_lng']) (form.elements.namedItem(name) as HTMLInputElement).value = String(res.data[name] ?? '');
    options.replaceChildren(); (res.data.project_type_options ?? []).forEach((item: any) => addOption(item.label_en, item.label_fr)); setStatus('Contact settings loaded.');
  }
  form.addEventListener('submit', async (event) => {
    event.preventDefault(); submit.disabled = true; setStatus('Saving…'); const data = new FormData(form);
    const payload = { hero_copy_en: data.get('hero_copy_en'), hero_copy_fr: data.get('hero_copy_fr'), map_lat: data.get('map_lat'), map_lng: data.get('map_lng'), project_type_options: [...options.querySelectorAll<HTMLElement>('.repeat-row')].map((row) => ({ label_en: (row.querySelector('[data-en]') as HTMLInputElement).value, label_fr: (row.querySelector('[data-fr]') as HTMLInputElement).value })) };
    const res = await sendJson('/api/contact-settings-admin', 'PUT', payload, 'Unable to save Contact settings.');
    setStatus(res.ok ? 'Contact page saved. A public rebuild was requested.' : res.error!, res.ok ? 'ok' : 'err'); submit.disabled = false;
  });
  load();
</script>

<style>
  .repeat-list { display:grid; gap:12px; }
  .repeat-row { display:grid; grid-template-columns:1fr 1fr auto; gap:12px; align-items:end; padding:14px; border:1px solid var(--line); border-radius:12px; background:var(--cream); }
  @media (max-width: 760px) { .repeat-row { grid-template-columns:1fr; } }
</style>
