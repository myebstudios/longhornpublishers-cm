---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import AdminSaveBar from '../../components/admin/AdminSaveBar.astro';

import AdminEditorDialog from '../../components/admin/AdminEditorDialog.astro';
---
<AdminLayout title="Contact" section="contact">
<AdminPageHeader heading="Contact Page" subtitle="Manage contact hero introduction, inquiry project types, and map coordinates."></AdminPageHeader>
<section id="adminCanvas" aria-busy="true"><p role="status">Loading saved content…</p></section>
<AdminEditorDialog>
<form hidden id="contactForm"><p>Address, phone numbers, and public email are managed centrally in <a href="/admin/site-settings/">Site settings</a>.</p><h2>Introduction and coordinates</h2>
      <div class="two">
        <label>Hero copy — English<textarea name="hero_copy_en" required lang="en"></textarea></label>
        <label>Hero copy — French<textarea name="hero_copy_fr" required lang="fr"></textarea></label>
        <label>Map latitude<input name="map_lat" type="number" min="-90" max="90" step="any"></label>
        <label>Map longitude<input name="map_lng" type="number" min="-180" max="180" step="any"></label>
      </div>
      <div class="toolbar"><h2>Project type options</h2><button class="button secondary" type="button" id="addOption">+ Add option</button></div>
      <div id="options" class="repeat-list"></div>
      <label class="check"><input name="published" type="checkbox" /> Published — visible on the public site</label>
      <AdminSaveBar><button class="button" type="submit">Save Contact page</button></AdminSaveBar>
      <p id="status" role="status" aria-live="polite"></p>
    </form>
</AdminEditorDialog>
</AdminLayout>
<script>
import { startAdminV2 } from '../../lib/admin-v2';
void startAdminV2('contact');
</script>
