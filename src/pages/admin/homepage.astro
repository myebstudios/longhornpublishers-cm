  .hero-slide-card[open] { border-color:var(--burgundy); box-shadow:0 8px 24px rgba(59,15,27,.08); }
  .hero-slide-card summary { display:flex; align-items:center; gap:12px; min-height:64px; padding:12px 16px; cursor:pointer; background:var(--cream); }
  .hero-slide-card__number { min-width:64px; color:var(--burgundy); font-weight:750; }
  .hero-slide-card__titles { display:grid; flex:1; min-width:0; }
  .hero-slide-card__titles strong,.hero-slide-card__titles small { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .hero-slide-card__titles small { color:var(--muted); margin-top:3px; }
  .hero-slide-form { display:grid; gap:20px; padding:20px; }
  .hero-slide-form label { display:grid; gap:7px; font:600 13px var(--font-display); color:var(--ink); }
  .hero-slide-form :is(input[type="text"],input:not([type]),textarea),
  .carousel-settings input[type="number"] { width:100%; padding:11px 14px; border:1px solid var(--line); border-radius:10px; background:#fff; color:var(--ink); font:inherit; }
  .hero-slide-form textarea { min-height:96px; resize:vertical; }
  .hero-slide-form :is(input,textarea):focus,
  .carousel-settings input[type="number"]:focus { outline:3px solid var(--green-deep); outline-offset:2px; border-color:var(--green-deep); }
  .hero-slide-form .check,.carousel-settings .check { display:flex; grid-template-columns:auto 1fr; align-items:center; gap:9px; cursor:pointer; }
  .slide-copy-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px 20px; }
  .slide-image-field,.cta-fieldset { display:grid; gap:14px; margin:0; padding:16px; border:1px solid var(--line); border-radius:12px; }
  .slide-image-field { grid-template-columns:180px 1fr; }
  .slide-image-field legend,.cta-fieldset legend { padding-inline:6px; font-weight:750; color:var(--burgundy); }
  .slide-image-field__preview { width:180px; aspect-ratio:16/9; display:grid; place-items:center; overflow:hidden; border:1px dashed var(--line); border-radius:10px; background:var(--cream); }
  .slide-image-field__preview img { width:100%; height:100%; object-fit:cover; }
  .slide-image-field__preview p { margin:0; padding:12px; text-align:center; color:var(--muted); font-size:12px; }
  .slide-image-field__controls { display:grid; align-content:center; gap:8px; }
  .slide-image-field__controls input[type="file"] { display:block; margin-top:6px; }
  .slide-image-field__controls .button { justify-self:start; }
  .hero-slide-actions { display:flex; flex-wrap:wrap; gap:10px; align-items:center; }
  .hero-slide-actions .button { min-height:44px; }
  .translation-badge { display:inline-flex; padding:.25rem .7rem; border-radius:999px; font-size:11px; font-weight:750; white-space:nowrap; }
  .translation-badge--complete { background:var(--green-pale); color:var(--green-deep); }
  .translation-badge--missing { background:#FBE9EC; color:var(--danger); }
  .field-error { display:block; min-height:1.2em; margin-top:4px; color:var(--danger); font-weight:650; }
  [aria-invalid="true"] { border-color:var(--danger)!important; box-shadow:0 0 0 2px rgba(179,38,30,.12); }
