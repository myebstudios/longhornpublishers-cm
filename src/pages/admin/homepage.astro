  .carousel-settings .check { margin-top:8px; }
  .slide-status { margin:0; }
  @media (max-width: 760px) {
    .repeat-row,.slide-copy-grid,.slide-image-field,.carousel-settings { grid-template-columns:1fr; }
    .hero-manager__head,.hero-slide-card summary { align-items:stretch; flex-direction:column; }
    .hero-slide-card__number { min-width:0; }
    .slide-image-field__preview { width:100%; max-width:360px; }
    .hero-slide-actions .button { flex:1 1 140px; justify-content:center; }
  }
</style>
