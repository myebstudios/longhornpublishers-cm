---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import AdminSaveBar from '../../components/admin/AdminSaveBar.astro';

import AdminEditorDialog from '../../components/admin/AdminEditorDialog.astro';
---
<AdminLayout title="Homepage" section="homepage">
<AdminPageHeader heading="Homepage & Hero Slides" subtitle="Manage homepage hero carousel slides, brand overview copy, trust metrics, partner highlights, and featured catalogue titles."></AdminPageHeader>
<section id="adminCanvas" aria-busy="true"><p role="status">Loading saved content…</p></section>
<template id="heroSlideTemplate">
    <details class="hero-slide-card">
      <summary>
        <span class="hero-slide-card__number" data-slide-number></span>
        <span class="hero-slide-card__titles"><strong data-slide-title></strong><small data-slide-title-fr></small></span>
        <span class="admin-badge" data-slide-state></span>
        <span class="translation-badge" data-translation-state></span>
      </summary>
      <form class="hero-slide-form" novalidate>
        <input type="hidden" name="id" />
        <fieldset class="slide-image-field">
          <legend>Image</legend>
          <input type="hidden" name="image_id" data-field="image_id" />
          <div class="slide-image-field__preview">
            <img data-slide-image alt="Hero slide image preview" hidden />
            <p data-slide-image-empty>No image added</p>
          </div>
          <div class="slide-image-field__controls">
            <label>Choose or replace image<input data-slide-file type="file" accept="image/jpeg,image/png,image/webp" /></label>
            <button class="button danger" type="button" data-remove-image>Remove image</button>
            <small>JPEG, PNG or WebP, up to 8 MB. Wide landscape images work best.</small>
            <small class="field-error" data-error-for="image_id"></small>
            <span data-image-status role="status" aria-live="polite"></span>
          </div>
        </fieldset>

        <fieldset class="slide-copy-grid"><legend>Headline and copy</legend>
          <label>Eyebrow — English<input name="eyebrow_en" data-field="eyebrow_en" maxlength="160" lang="en" /><small class="field-error" data-error-for="eyebrow_en"></small></label>
          <label>Eyebrow — French<input name="eyebrow_fr" data-field="eyebrow_fr" maxlength="160" lang="fr" /><small class="field-error" data-error-for="eyebrow_fr"></small></label>
          <label>Headline — English<textarea name="headline_en" data-field="headline_en" data-required maxlength="300" lang="en"></textarea><small class="field-error" data-error-for="headline_en"></small></label>
          <label>Headline — French<textarea name="headline_fr" data-field="headline_fr" data-required maxlength="300" lang="fr"></textarea><small class="field-error" data-error-for="headline_fr"></small></label>
          <label>Headline accent — English<input name="headline_accent_en" data-field="headline_accent_en" maxlength="300" lang="en" /><small class="field-error" data-error-for="headline_accent_en"></small></label>
          <label>Headline accent — French<input name="headline_accent_fr" data-field="headline_accent_fr" maxlength="300" lang="fr" /><small class="field-error" data-error-for="headline_accent_fr"></small></label>
          <label>Subheadline — English<textarea name="subheadline_en" data-field="subheadline_en" data-required maxlength="1000" lang="en"></textarea><small class="field-error" data-error-for="subheadline_en"></small></label>
          <label>Subheadline — French<textarea name="subheadline_fr" data-field="subheadline_fr" data-required maxlength="1000" lang="fr"></textarea><small class="field-error" data-error-for="subheadline_fr"></small></label>
        </fieldset>

        <fieldset class="cta-fieldset">
          <legend>Primary call to action</legend>
          <div class="slide-copy-grid">
            <label>Label — English<input name="primary_cta_label_en" data-field="primary_cta_label_en" data-required maxlength="100" lang="en" /><small class="field-error" data-error-for="primary_cta_label_en"></small></label>
            <label>Label — French<input name="primary_cta_label_fr" data-field="primary_cta_label_fr" data-required maxlength="100" lang="fr" /><small class="field-error" data-error-for="primary_cta_label_fr"></small></label>
          </div>
          <label>Destination for both languages<input name="primary_cta_href" data-field="primary_cta_href" data-required maxlength="2000" placeholder="/contact" /><small>Internal paths are localized automatically for EN and FR.</small><small class="field-error" data-error-for="primary_cta_href"></small></label>
        </fieldset>

        <fieldset class="cta-fieldset">
          <legend>Secondary call to action <small>(optional)</small></legend>
          <div class="slide-copy-grid">
            <label>Label — English<input name="secondary_cta_label_en" data-field="secondary_cta_label_en" maxlength="100" lang="en" /><small class="field-error" data-error-for="secondary_cta_label_en"></small></label>
            <label>Label — French<input name="secondary_cta_label_fr" data-field="secondary_cta_label_fr" maxlength="100" lang="fr" /><small class="field-error" data-error-for="secondary_cta_label_fr"></small></label>
          </div>
          <label>Destination for both languages<input name="secondary_cta_href" data-field="secondary_cta_href" maxlength="2000" placeholder="/services" /><small class="field-error" data-error-for="secondary_cta_href"></small></label>
        </fieldset>

        <fieldset><legend>Enabled</legend><label class="check"><input name="enabled" data-field="enabled" type="checkbox" /> Enabled — show this slide on the public homepage</label>
        <small class="field-error" data-error-for="enabled"></small></fieldset>
        <div class="hero-slide-actions">
          <button class="button" type="submit" data-save-slide>Save slide</button>
          <button class="button secondary" type="button" data-move-up>Move up</button>
          <button class="button secondary" type="button" data-move-down>Move down</button>
          <button class="button danger" type="button" data-delete-slide>Delete slide</button>
        </div>
        <p class="slide-status" data-slide-status role="status" aria-live="polite"></p>
      </form>
    </details>
  </template>
<AdminEditorDialog>
<form hidden id="homepageForm">
      <h2>Carousel settings</h2>
      <div class="carousel-settings">
        <label class="check"><input name="hero_autoplay_enabled" type="checkbox" checked /> Autoplay enabled</label>
        <label>Time per slide (seconds)<input name="hero_autoplay_interval" type="number" min="3" max="30" step="any" value="6" aria-describedby="autoplayHint autoplayError" /><small id="autoplayHint">Between 3 and 30 seconds, in half-second increments. Recommended: 6 seconds. Existing custom intervals are preserved when unchanged.</small><small class="field-error" id="autoplayError"></small></label>
      </div>

      <h2>Fallback hero</h2>
      <p>Kept as a rollback path and used when no carousel slides are saved.</p>
      <div class="two">
        <label>Headline — English<textarea name="hero_headline_en" required lang="en"></textarea></label>
        <label>Headline — French<textarea name="hero_headline_fr" required lang="fr"></textarea></label>
        <label>Headline accent — English<input name="hero_headline_accent_en" maxlength="300" lang="en" /><small>Shown in the accent colour after the headline.</small></label>
        <label>Headline accent — French<input name="hero_headline_accent_fr" maxlength="300" lang="fr" /></label>
        <label>Eyebrow — English<input name="hero_eyebrow_en" maxlength="160" lang="en" /><small>Small line above the headline. Leave blank for none.</small></label>
        <label>Eyebrow — French<input name="hero_eyebrow_fr" maxlength="160" lang="fr" /></label>
        <label>Subheadline — English<textarea name="hero_subheadline_en" required lang="en"></textarea></label>
        <label>Subheadline — French<textarea name="hero_subheadline_fr" required lang="fr"></textarea></label>
        <label>CTA label — English<input name="hero_cta_label_en" required lang="en" /></label>
        <label>CTA label — French<input name="hero_cta_label_fr" required lang="fr" /></label>
      </div>
      <div class="media-field" data-media="hero_image_id">
        <label>Hero image<input name="hero_image_id" type="hidden" /><input data-file type="file" accept="image/jpeg,image/png,image/webp" /></label><button type="button" class="button secondary" data-clear-media>Remove image</button>
        <img data-preview alt="Hero preview" hidden /><span data-media-status></span>
      </div>

      <h2>Who we are</h2>
      <div class="two">
        <label>Copy — English<textarea name="who_we_are_copy_en" required lang="en"></textarea></label>
        <label>Copy — French<textarea name="who_we_are_copy_fr" required lang="fr"></textarea></label>
      </div>
      <div class="media-field" data-media="who_we_are_image_id">
        <label>Who we are image<input name="who_we_are_image_id" type="hidden" /><input data-file type="file" accept="image/jpeg,image/png,image/webp" /></label><button type="button" class="button secondary" data-clear-media>Remove image</button>
        <img data-preview alt="Who we are preview" hidden /><span data-media-status></span>
      </div>

      <div class="toolbar"><h2>Trust stats</h2><button class="button secondary" type="button" id="addStat">+ Add stat</button></div>
      <div id="trustStats" class="repeat-list"></div>

      <h2>One partner positioning</h2>
      <div class="two">
        <label>Copy — English<textarea name="one_partner_copy_en" required lang="en"></textarea></label>
        <label>Copy — French<textarea name="one_partner_copy_fr" required lang="fr"></textarea></label>
      </div>

      <h2>Featured catalogue</h2>
      <p>Select up to four published titles for the homepage showcase.</p>
      <div id="catalogueChoices" class="choice-list"></div>

      <label class="check"><input name="published" type="checkbox" /> Published — visible on the public site</label>
      <AdminSaveBar><button class="button" type="submit">Save homepage</button></AdminSaveBar>
      <p id="status" role="status" aria-live="polite"></p>
    </form>
</AdminEditorDialog>
</AdminLayout>
<script>
import { startAdminV2 } from '../../lib/admin-v2';
void startAdminV2('homepage');
</script>
