---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import AdminSaveBar from '../../components/admin/AdminSaveBar.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';

import AdminEditorDialog from '../../components/admin/AdminEditorDialog.astro';
---
<AdminLayout title="Subjects" section="subjects">
<AdminPageHeader heading="Curriculum Subjects" subtitle="Manage the academic subject taxonomy for Cameroon primary and secondary curricula."><button class="button" type="button" id="openEditorBtn">+ Create subject</button></AdminPageHeader>
<section id="adminCanvas" aria-busy="true"><p role="status">Loading saved content…</p></section>
<AdminEditorDialog legacyEditor>
<form hidden id="editor">
      <input type="hidden" name="id" />
      <fieldset class="two"><legend>Subject names</legend>
        <label>English subject name<input name="name_en" required placeholder="e.g. Mathematics" lang="en" /></label>
        <label>French subject name<input name="name_fr" required placeholder="e.g. Mathématiques" lang="fr" /></label>
      </fieldset>
      <AdminSaveBar>
        <button class="button" type="submit">Save subject</button>
        <button class="button secondary" type="button" id="cancelEditorBtn">Cancel</button>
      </AdminSaveBar>
      <p id="status" role="status" aria-live="polite"></p>
    </form>
</AdminEditorDialog>
</AdminLayout>
<script>
import { startAdminV2 } from '../../lib/admin-v2';
void startAdminV2('subjects');
</script>
