---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Overview">
  <div class="admin-page-head">
    <div>
      <h1>Content Management Desk</h1>
      <p>Manage bilingual publication titles, curriculum subjects, and company news with guaranteed EN/FR parity.</p>
    </div>
  </div>

  <section class="metrics" aria-label="Dashboard Statistics">
    <article class="metric-card">
      <div class="metric-head">
        <span class="metric-icon" aria-hidden="true">▤</span>
        <span class="admin-badge admin-badge--published" id="catalogueBadge">Live</span>
      </div>
      <p>Catalogue Titles</p>
      <strong id="metricCatalogue" class="metric-value admin-skeleton"></strong>
      <small id="metricCatalogueSub" class="metric-sub">Fetching publication titles…</small>
    </article>

    <article class="metric-card">
      <div class="metric-head">
        <span class="metric-icon gold" aria-hidden="true">✦</span>
        <span class="admin-badge admin-badge--draft" id="newsBadge">Editorial</span>
      </div>
      <p>News Articles</p>
      <strong id="metricNews" class="metric-value admin-skeleton"></strong>
      <small id="metricNewsSub" class="metric-sub">Fetching editorial drafts…</small>
    </article>

    <article class="metric-card">
      <div class="metric-head">
        <span class="metric-icon purple" aria-hidden="true">❖</span>
        <span class="admin-badge admin-badge--purple">Taxonomy</span>
      </div>
      <p>Curriculum Subjects</p>
      <strong id="metricSubjects" class="metric-value admin-skeleton"></strong>
      <small id="metricSubjectsSub" class="metric-sub">Fetching subjects…</small>
    </article>

    <article class="metric-card">
      <div class="metric-head">
        <span class="metric-icon green" aria-hidden="true">✓</span>
        <span class="admin-badge admin-badge--published">Active</span>
      </div>
      <p>Bilingual Parity</p>
      <strong class="metric-value">100%</strong>
      <small class="metric-sub">EN & FR required per record.</small>
    </article>
  </section>

  <section class="quick-grid" aria-label="Workspace Shortcuts">
    <div class="card quick-action">
      <span class="action-icon" aria-hidden="true">📚</span>
      <div>
        <p class="section-kicker">Catalogue Workspace</p>
        <h2>Educational Titles</h2>
        <p>Create bilingual title entries, assign subjects, and attach 3:4 portrait book cover art.</p>
      </div>
      <a class="button" href="/admin/catalogue/">Manage Catalogue <span>→</span></a>
    </div>

    <div class="card quick-action">
      <span class="action-icon" aria-hidden="true">📰</span>
      <div>
        <p class="section-kicker">Editorial Desk</p>
        <h2>News & Partnerships</h2>
        <p>Draft company news, new title announcements, and partnership press releases.</p>
      </div>
      <a class="button secondary" href="/admin/news/">Manage News <span>→</span></a>
    </div>
  </section>

  <section class="card workflow" aria-label="Publishing Process">
    <div class="workflow-header">
      <h2>Publishing Process & Quality Checklist</h2>
      <p>All content published from this workspace reflects directly across the Cameroonian & DRC public sites.</p>
    </div>
    <ol class="workflow-steps">
      <li>
        <span class="step-num">01</span>
        <div>
          <strong>Bilingual Draft</strong>
          <small>Provide both English and French titles, descriptions, and curriculum alignments.</small>
        </div>
      </li>
      <li>
        <span class="step-num">02</span>
        <div>
          <strong>Asset Review</strong>
          <small>Ensure cover image is 3:4 portrait (JPEG/PNG/WebP, up to 8 MB).</small>
        </div>
      </li>
      <li>
        <span class="step-num">03</span>
        <div>
          <strong>Instant Publish</strong>
          <small>Check "Publish Now" to make approved content immediately visible.</small>
        </div>
      </li>
    </ol>
  </section>
</AdminLayout>

<script>
  import { request } from '../../lib/admin-client';

  async function loadDashboardMetrics() {
    const catalogueEl = document.querySelector('#metricCatalogue');
    const catalogueSub = document.querySelector('#metricCatalogueSub');
    const newsEl = document.querySelector('#metricNews');
    const newsSub = document.querySelector('#metricNewsSub');
    const subjectsEl = document.querySelector('#metricSubjects');
    const subjectsSub = document.querySelector('#metricSubjectsSub');

    try {
      const [catRes, newsRes, subjRes] = await Promise.all([
        request<any[]>('/api/catalogue-admin', {}, 'Unable to fetch catalogue.'),
        request<any[]>('/api/news-admin', {}, 'Unable to fetch news.'),
        request<any[]>('/api/subjects-admin', {}, 'Unable to fetch subjects.'),
      ]);

      if (catalogueEl) catalogueEl.classList.remove('admin-skeleton');
      if (newsEl) newsEl.classList.remove('admin-skeleton');
      if (subjectsEl) subjectsEl.classList.remove('admin-skeleton');

      if (catRes.ok && catRes.data) {
        const published = catRes.data.filter(t => t.published).length;
        if (catalogueEl) catalogueEl.textContent = String(catRes.data.length);
        if (catalogueSub) catalogueSub.textContent = `${published} published · ${catRes.data.length - published} drafts`;
      } else {
        if (catalogueEl) catalogueEl.textContent = '0';
        if (catalogueSub) catalogueSub.textContent = 'Ready for initial titles.';
      }

      if (newsRes.ok && newsRes.data) {
        const published = newsRes.data.filter(a => a.published).length;
        if (newsEl) newsEl.textContent = String(newsRes.data.length);
        if (newsSub) newsSub.textContent = `${published} published articles`;
      } else {
        if (newsEl) newsEl.textContent = '0';
        if (newsSub) newsSub.textContent = 'Ready for editorial news.';
      }

      if (subjRes.ok && subjRes.data) {
        if (subjectsEl) subjectsEl.textContent = String(subjRes.data.length);
        if (subjectsSub) subjectsSub.textContent = 'Curriculum taxonomy active.';
      } else {
        if (subjectsEl) subjectsEl.textContent = '0';
        if (subjectsSub) subjectsSub.textContent = 'Define subjects to categorize titles.';
      }
    } catch {
      if (catalogueEl) { catalogueEl.classList.remove('admin-skeleton'); catalogueEl.textContent = '—'; }
      if (newsEl) { newsEl.classList.remove('admin-skeleton'); newsEl.textContent = '—'; }
      if (subjectsEl) { subjectsEl.classList.remove('admin-skeleton'); subjectsEl.textContent = '—'; }
    }
  }

  document.addEventListener('DOMContentLoaded', loadDashboardMetrics);
</script>

<style>
.metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
.metric-card {
  min-height: 180px; background: #fff; border: 1px solid var(--line);
  border-radius: 20px; padding: 22px; box-shadow: 0 8px 24px rgba(59, 15, 27, 0.04);
  display: flex; flex-direction: column; justify-content: space-between;
  transition: transform .25s ease, box-shadow .25s ease;
}
.metric-card:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(59, 15, 27, 0.08); }
.metric-head { display: flex; align-items: center; justify-content: space-between; }
.metric-card p { margin: 14px 0 2px; color: var(--muted); font-size: 13px; font-weight: 600; font-family: var(--font-display); }
.metric-value { display: block; font: 700 36px/1 var(--font-display); color: var(--ink); letter-spacing: -.04em; min-height: 36px; }
.metric-sub { display: block; margin-top: 8px; color: var(--muted); font-size: 12px; }

.metric-icon { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 12px; background: var(--green-pale); color: var(--green-deep); font-weight: 900; font-size: 16px; }
.metric-icon.gold { background: rgba(233,166,59,.18); color: #9A6608; }
.metric-icon.purple { background: rgba(110,75,158,.14); color: var(--purple); }
.metric-icon.green { background: var(--green-pale); color: var(--green-deep); }

.quick-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 4px; }
.quick-action {
  display: flex; flex-direction: column; justify-content: space-between; gap: 20px;
  background: linear-gradient(135deg, #ffffff, #fdfaf5); border: 1px solid var(--line);
}
.action-icon { font-size: 32px; }
.quick-action p { color: var(--muted); margin-top: 6px; }
.quick-action .button { align-self: flex-start; margin-top: 12px; }
.section-kicker { margin: 0 !important; color: var(--burgundy) !important; font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; font-family: var(--font-display); }

.workflow-header { margin-bottom: 24px; }
.workflow-steps { display: grid; grid-template-columns: repeat(3, 1fr); list-style: none; margin: 0; padding: 0; gap: 20px; }
.workflow-steps li { display: flex; gap: 14px; align-items: flex-start; padding: 18px; border-radius: 14px; background: var(--cream); border: 1px solid var(--line); }
.step-num { font: 800 18px var(--font-display); color: var(--green-deep); background: var(--green-pale); padding: 4px 10px; border-radius: 8px; }
.workflow-steps strong { display: block; font-family: var(--font-display); color: var(--ink); font-size: 15px; }
.workflow-steps small { display: block; margin-top: 4px; color: var(--muted); font-size: 13px; line-height: 1.4; }

@media (max-width: 1100px) {
  .metrics { grid-template-columns: repeat(2, 1fr); }
  .quick-grid { grid-template-columns: 1fr; }
}
@media (max-width: 700px) {
  .metrics, .workflow-steps { grid-template-columns: 1fr; }
}
</style>
