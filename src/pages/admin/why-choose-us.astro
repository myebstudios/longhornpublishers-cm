---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import AdminSaveBar from '../../components/admin/AdminSaveBar.astro';

import AdminEditorDialog from '../../components/admin/AdminEditorDialog.astro';
---
<AdminLayout title="Why choose us" section="why">
<AdminPageHeader heading="Why Choose Us" subtitle="Manage local presence narrative in Yaoundé and quality assurance commitments."></AdminPageHeader>
<section id="adminCanvas" aria-busy="true"><p role="status">Loading saved content…</p></section>
<AdminEditorDialog>
<form hidden id="whyForm">
      <h2>Local presence</h2>
      <div class="two">
        <label>Copy — English<textarea name="local_presence_copy_en" required lang="en"></textarea></label>
        <label>Copy — French<textarea name="local_presence_copy_fr" required lang="fr"></textarea></label>
      </div>
      <div class="toolbar"><h2>Quality commitments</h2><button class="button secondary" type="button" id="addItem">+ Add item</button></div>
      <div id="items" class="repeat-list"></div>
      <label class="check"><input name="published" type="checkbox" /> Published — visible on the public site</label>
      <AdminSaveBar><button class="button" type="submit">Save Why Choose Us</button></AdminSaveBar>
      <p id="status" role="status" aria-live="polite"></p>
    </form>
</AdminEditorDialog>
</AdminLayout>
<script>
import { startAdminV2 } from '../../lib/admin-v2';
void startAdminV2('why');
</script>
