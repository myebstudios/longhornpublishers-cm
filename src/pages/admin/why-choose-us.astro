---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Why choose us" section="why">
  <div class="admin-page-head"><div><h1>Why Choose Us</h1><p>Manage bilingual local-presence copy and quality commitments.</p></div></div>
  <section class="card editor-card">
    <form id="whyForm">
      <h2>Local presence</h2>
      <div class="two">
        <label>Copy — English<textarea name="local_presence_copy_en" required></textarea></label>
        <label>Copy — French<textarea name="local_presence_copy_fr" required></textarea></label>
      </div>
      <div class="toolbar"><h2>Quality commitments</h2><button class="button secondary" type="button" id="addItem">+ Add item</button></div>
      <div id="items" class="repeat-list"></div>
      <label class="check"><input name="published" type="checkbox" /> Published — visible on the public site</label>
      <div class="form-actions"><button class="button" type="submit">Save Why Choose Us</button></div>
      <p id="status" role="status" aria-live="polite"></p>
    </form>
  </section>
</AdminLayout>

<script>
  import { guardUnsavedChanges, request, sendJson } from '../../lib/admin-client';
  const form = document.querySelector('#whyForm') as HTMLFormElement;
  const items = document.querySelector('#items')!;
  const status = document.querySelector('#status')!;
  const guard = guardUnsavedChanges(form, items);
  const submit = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const setStatus = (message: string, tone: 'ok' | 'err' = 'ok') => { status.textContent = message; status.className = message ? `status status--${tone}` : ''; };
  const splitTags = (value: string) => value.split(',').map((tag) => tag.trim()).filter(Boolean);
  function addItem(icon = '', titleEn = '', titleFr = '', descriptionEn = '', descriptionFr = '', item: any = {}) {
    const row = document.createElement('div'); row.className = 'repeat-row';
    row.innerHTML = '<label>Icon key<input data-icon maxlength="60"></label><label>English title<input data-title-en maxlength="160"></label><label>French title<input data-title-fr maxlength="160"></label><label>English description<textarea data-description-en></textarea></label><label>French description<textarea data-description-fr></textarea></label><label>English eyebrow<input data-eyebrow-en maxlength="160"></label><label>French eyebrow<input data-eyebrow-fr maxlength="160"></label><label>English heading lead<input data-lead-en maxlength="160"></label><label>French heading lead<input data-lead-fr maxlength="160"></label><label>English heading accent<input data-accent-en maxlength="160"></label><label>French heading accent<input data-accent-fr maxlength="160"></label><label>English tags<input data-tags-en placeholder="Comma separated"></label><label>French tags<input data-tags-fr placeholder="Separes par des virgules"></label><button class="button danger" type="button">Remove</button>';
    for (const [key, field] of [['eyebrow_en','eyebrow-en'],['eyebrow_fr','eyebrow-fr'],['title_lead_en','lead-en'],['title_lead_fr','lead-fr'],['title_accent_en','accent-en'],['title_accent_fr','accent-fr']] as const) {
      (row.querySelector(`[data-${field}]`) as HTMLInputElement).value = item?.[key] ?? '';
    }
    (row.querySelector('[data-tags-en]') as HTMLInputElement).value = (item?.tags_en ?? []).join(', ');
    (row.querySelector('[data-tags-fr]') as HTMLInputElement).value = (item?.tags_fr ?? []).join(', ');
    (row.querySelector('[data-icon]') as HTMLInputElement).value = icon;
    (row.querySelector('[data-title-en]') as HTMLInputElement).value = titleEn;
    (row.querySelector('[data-title-fr]') as HTMLInputElement).value = titleFr;
    (row.querySelector('[data-description-en]') as HTMLTextAreaElement).value = descriptionEn;
    (row.querySelector('[data-description-fr]') as HTMLTextAreaElement).value = descriptionFr;
    row.querySelector('button')!.addEventListener('click', () => row.remove()); items.append(row);
  }
  document.querySelector('#addItem')!.addEventListener('click', () => addItem());
  async function load() {
    const res = await request<Record<string, any> | null>('/api/why-choose-us-admin', {}, 'Unable to load Why Choose Us content.');
    if (!res.ok) return setStatus(res.error!, 'err');
    if (!res.data) return setStatus('No database row yet. Enter complete bilingual content to create it.');
    (form.elements.namedItem('local_presence_copy_en') as HTMLTextAreaElement).value = res.data.local_presence_copy_en ?? '';
    (form.elements.namedItem('local_presence_copy_fr') as HTMLTextAreaElement).value = res.data.local_presence_copy_fr ?? '';
    (form.elements.namedItem('published') as HTMLInputElement).checked = Boolean(res.data.published);
    items.replaceChildren(); (res.data.quality_commitment_items ?? []).forEach((item: any) => addItem(item.icon, item.title_en, item.title_fr, item.description_en, item.description_fr, item));
    setStatus('Why Choose Us content loaded.'); guard.markClean();
  }
  form.addEventListener('submit', async (event) => {
    event.preventDefault(); submit.disabled = true; setStatus('Saving…');
    const data = new FormData(form);
    const payload = {
      local_presence_copy_en: data.get('local_presence_copy_en'),
      local_presence_copy_fr: data.get('local_presence_copy_fr'),
      quality_commitment_items: [...items.querySelectorAll<HTMLElement>('.repeat-row')].map((row) => ({
        icon: (row.querySelector('[data-icon]') as HTMLInputElement).value,
        title_en: (row.querySelector('[data-title-en]') as HTMLInputElement).value,
        title_fr: (row.querySelector('[data-title-fr]') as HTMLInputElement).value,
        description_en: (row.querySelector('[data-description-en]') as HTMLTextAreaElement).value,
        description_fr: (row.querySelector('[data-description-fr]') as HTMLTextAreaElement).value,
        eyebrow_en: (row.querySelector('[data-eyebrow-en]') as HTMLInputElement).value,
        eyebrow_fr: (row.querySelector('[data-eyebrow-fr]') as HTMLInputElement).value,
        title_lead_en: (row.querySelector('[data-lead-en]') as HTMLInputElement).value,
        title_lead_fr: (row.querySelector('[data-lead-fr]') as HTMLInputElement).value,
        title_accent_en: (row.querySelector('[data-accent-en]') as HTMLInputElement).value,
        title_accent_fr: (row.querySelector('[data-accent-fr]') as HTMLInputElement).value,
        tags_en: splitTags((row.querySelector('[data-tags-en]') as HTMLInputElement).value),
        tags_fr: splitTags((row.querySelector('[data-tags-fr]') as HTMLInputElement).value),
      })),
      published: (form.elements.namedItem('published') as HTMLInputElement).checked,
    };
    const res = await sendJson('/api/why-choose-us-admin', 'PUT', payload, 'Unable to save Why Choose Us content.');
    setStatus(res.ok ? (payload.published ? 'Why Choose Us published. A public rebuild was requested.' : 'Draft saved. Not visible on the public site.') : res.error!, res.ok ? 'ok' : 'err'); if (res.ok) guard.markClean(); submit.disabled = false;
  });
  load();
</script>

<style>
  .repeat-list { display:grid; gap:12px; }
  .repeat-row { display:grid; grid-template-columns:.5fr 1fr 1fr 1.4fr 1.4fr auto; gap:12px; align-items:end; padding:14px; border:1px solid var(--line); border-radius:12px; background:var(--cream); }
  @media (max-width: 1100px) { .repeat-row { grid-template-columns:1fr; } }
</style>
