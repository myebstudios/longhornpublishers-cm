---
import Layout from '../../layouts/Layout.astro';
import PrototypePage from '../../components/PrototypePage.astro';
import { LOCALES, type Locale, useTranslations } from '../../i18n';
export function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
---
<Layout title={t.meta.home.title} description={t.meta.home.description} locale={lang} routeKey="home">
  <PrototypePage file="index" locale={lang} />
</Layout>
