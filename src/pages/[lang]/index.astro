---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Split from '../../components/Split.astro';
import SectionHead from '../../components/SectionHead.astro';
import Carousel from '../../components/Carousel.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import Button from '../../components/Button.astro';
import { LOCALES, path, type Locale, useTranslations } from '../../i18n';
import { SERVICES, PROCESS } from '../../data/site';
import {
  SERVICE_IMG, disciplineLabel,
} from '../../data/presentation';
import { responsive } from '../../lib/images';
import {
  articlePath, categoryIcon, categoryKey, excerpt, getPublishedNews, headline, publishedOn,
} from '../../lib/news';
import { coverImage, getPublishedTitles, titleText } from '../../lib/catalogue';

export function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

// Catalogue showcase, newest/featured first. Omitted entirely when nothing is
// published, like the news teaser below.
const catalogueTitles = await getPublishedTitles(8);

// Service carousel cards are clamp(290px, 32vw, 390px) wide and below the fold,
// so they cap out at a 960w source and load lazily.
const CARD_SIZES = '(max-width: 906px) 290px, (min-width: 1220px) 390px, 32vw';
const cardImg = (id: string) => responsive(SERVICE_IMG[id], { maxWidth: 960 });

// Teaser for the three most recent published articles. When nothing is
// published the whole section is omitted — an empty news band on the homepage
// would read as neglect rather than as a deliberate blank.
const latestNews = await getPublishedNews(3);
---

<Layout title={t.meta.home.title} description={t.meta.home.description} locale={lang} routeKey="home">
  <Hero
    content={t.home.hero}
    img="lh-hero.jpg"
    primaryCtaText={t.common.partnerWithUs}
    primaryCtaHref={path('contact', lang)}
    secondaryCtaText={t.common.exploreServices}
    secondaryCtaHref={path('services', lang)}
  />

  <!-- Trust bar -->
  <section class="trust-bar">
    <div class="wrap trust-bar__inner">
      {t.home.trust.map((item) => (
        <div class="trust-item"><Icon name="check" size={18} /> {item}</div>
      ))}
    </div>
  </section>

  <!-- Marquee -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {Array.from({ length: 2 }).flatMap(() =>
        SERVICES.flatMap((service) => [
          <span class="marquee__item">{service[lang].name}</span>,
          <span class="marquee__item">•</span>,
        ]),
      )}
    </div>
  </div>

  <!-- Who we are -->
  <section class="section section--cream">
    <div class="wrap">
      <Split img="lh-editorial-collaboration.jpg" alt={t.home.whoWeAre.imgAlt}>
        <span class="eyebrow">{t.home.whoWeAre.eyebrow}</span>
        <h2>{t.home.whoWeAre.titleLead} <em class="accent">{t.home.whoWeAre.titleAccent}</em></h2>
        {t.home.whoWeAre.body.map((p) => <p>{p}</p>)}
        <a class="link-arrow" href={path('about', lang)}>{t.home.whoWeAre.link}</a>
      </Split>
    </div>
  </section>

  <!-- Catalogue showcase — omitted entirely while nothing is published -->
  {catalogueTitles.length > 0 && (
  <section class="section section--cream">
    <div class="wrap">
      <Carousel prevLabel={t.common.prev} nextLabel={t.common.next}>
        <div slot="header">
          <SectionHead
            eyebrow={t.home.cataloguePreview.eyebrow}
            titleLead={t.home.cataloguePreview.titleLead}
            titleAccent={t.home.cataloguePreview.titleAccent}
            lede={t.home.cataloguePreview.lede}
          />
        </div>
        {catalogueTitles.map((title) => (
          <article class="book-card book-card--cover-only" data-cover-tilt>
            <a
              class="book-card__link"
              href={`${path('catalogue', lang)}${title.slug}/`}
              aria-label={titleText(title, lang)}
            >
              <div class="book-card__cover">
                {coverImage(title)
                  ? <img
                      {...coverImage(title)!}
                      sizes="(max-width: 906px) 290px, (min-width: 1220px) 390px, 32vw"
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  : <span aria-hidden="true">{titleText(title, lang)}</span>}
              </div>
            </a>
          </article>
        ))}
      </Carousel>
      <div class="mt-lg">
        <Button href={path('catalogue', lang)} variant="dark">{t.common.browseCatalogue}</Button>
      </div>
    </div>
  </section>
  )}

  <!-- Services carousel -->
  <section class="section section--white">
    <div class="wrap">
      <SectionHead
        eyebrow={t.home.services.eyebrow}
        titleLead={t.home.services.titleLead}
        titleAccent={t.home.services.titleAccent}
        lede={t.home.services.lede}
      />
      <Carousel prevLabel={t.common.prev} nextLabel={t.common.next}>
        {SERVICES.map((service) => (
          <article class="media-card">
            <img {...cardImg(service.id)} sizes={CARD_SIZES} alt="" loading="lazy" decoding="async" />
            <span class="pill pill--glass media-card__tag">{disciplineLabel(service.discipline, lang)}</span>
            <h3>{service[lang].name}</h3>
            <p>{service[lang].short}</p>
            <Button href={`${path('services', lang)}#${service.id}`} variant="primary" size="sm">{t.common.learnMore}</Button>
          </article>
        ))}
      </Carousel>
    </div>
  </section>

  <!-- End-to-end banner -->
  <section class="section section--dark">
    <div class="wrap">
      <SectionHead
        center
        eyebrow={t.home.endToEnd.eyebrow}
        titleLead={t.home.endToEnd.titleLead}
        titleAccent={t.home.endToEnd.titleAccent}
        lede={t.home.endToEnd.lede}
      />
      <div class="grid grid--3 reveal">
        {t.home.endToEnd.cards.map((card, i) => (
          <article class="card card--dark">
            <span class="card__icon"><Icon name={['shield', 'globe', 'check'][i] ?? 'check'} size={22} /></span>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section section--white">
    <div class="wrap">
      <SectionHead
        eyebrow={t.home.process.eyebrow}
        titleLead={t.home.process.titleLead}
        titleAccent={t.home.process.titleAccent}
        lede={t.home.process.lede}
      />
      <div class="steps reveal">
        {PROCESS.map((step, i) => (
          <article class:list={['step', i === 0 && 'step--active']}>
            <div class="step__num">{lang === 'fr' ? 'Étape' : 'Step'} {step.num}</div>
            <h3>{step[lang].title}</h3>
            <p>{step[lang].body}</p>
          </article>
        ))}
      </div>
      <div class="mt-lg">
        <Button href={path('services', lang)} variant="dark">{t.home.process.link}</Button>
      </div>
    </div>
  </section>

  <!-- Latest news — omitted entirely while nothing is published -->
  {latestNews.length > 0 && (
    <section class="section section--cream">
      <div class="wrap">
        <SectionHead
          eyebrow={t.home.news.eyebrow}
          titleLead={t.home.news.titleLead}
          titleAccent={t.home.news.titleAccent}
          lede={t.home.news.lede}
        />
        <div class="grid grid--3">
          {latestNews.map((article) => (
            <article class="article-card reveal">
              <div class="article-card__thumb" aria-hidden="true">
                <Icon name={categoryIcon(article.category)} />
              </div>
              <div class="article-card__body">
                <div class="article-card__meta">
                  <span class="pill pill--green">{t.news.categories[categoryKey(article.category)]}</span>
                  {publishedOn(article, lang) && (
                    <time datetime={article.publish_date!}>{publishedOn(article, lang)}</time>
                  )}
                </div>
                <h3><a href={articlePath(article, lang)}>{headline(article, lang)}</a></h3>
                <p>{excerpt(article, lang)}</p>
              </div>
            </article>
          ))}
        </div>
        <div class="mt-lg">
          <Button href={path('news', lang)} variant="dark">{t.common.viewAllNews}</Button>
        </div>
      </div>
    </section>
  )}

  <CtaBand
    content={t.home.cta}
    buttonHref={path('contact', lang)}
  />
</Layout>
