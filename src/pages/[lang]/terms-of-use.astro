---
export const prerender = false;
if (Astro.params.lang !== 'en') return new Response(null, { status: 404 });
import Legal from '../../components/pages/Legal.astro';
import type { Locale } from '../../i18n';

const { lang } = Astro.params as { lang: Locale };
---
<Legal locale={lang} page="terms_of_use" />
