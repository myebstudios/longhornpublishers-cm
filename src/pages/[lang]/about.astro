---
import Layout from '../../layouts/Layout.astro'; import PrototypePage from '../../components/PrototypePage.astro';
import { type Locale, useTranslations } from '../../i18n';
export function getStaticPaths() { return [{ params: { lang: 'en' } }]; }
const { lang } = Astro.params as { lang: Locale }; const t = useTranslations(lang);
---
<Layout title={t.meta.about.title} description={t.meta.about.description} locale={lang} routeKey="about"><PrototypePage file="about" locale={lang} /></Layout>
