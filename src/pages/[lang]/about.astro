---
import Layout from '../../layouts/Layout.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { LOCALES, type Locale, useTranslations, path } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
---

<Layout
  title={t.meta.about.title}
  description={t.meta.about.description}
  locale={lang}
  routeKey="about"
>
  <section class="hero hero--compact">
    <div class="hero__bg"><img src="/img/team.svg" alt="" /></div>
    <div class="wrap">
      <div class="hero__inner">
        <div>
          <span class="eyebrow">{t.about.hero.eyebrow}</span>
          <h1>{t.about.hero.titleLead} <em class="accent">{t.about.hero.titleAccent}</em></h1>
          <p class="hero__lede">{t.about.hero.lede}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Heritage -->
  <section class="section section--cream">
    <div class="wrap split reveal">
      <div class="split__media">
        <img src="/img/hero.svg" alt="Longhorn Publishers Cameroon office in Tsinga, Yaoundé" />
      </div>
      <div>
        <span class="eyebrow">{t.about.heritage.eyebrow}</span>
        <h2>{t.about.heritage.titleLead} <em class="accent">{t.about.heritage.titleAccent}</em></h2>
        {t.about.heritage.body.map((p) => (
          <p>{p}</p>
        ))}
        <a class="link-arrow" href={path('why', lang)}>{t.common.learnMore}</a>
      </div>
    </div>
  </section>

  <!-- Core Identity Pillars -->
  <section class="section section--white">
    <div class="wrap">
      <div class="section-head section-head--center reveal">
        <span class="eyebrow">{t.about.identity.eyebrow}</span>
        <h2>{t.about.identity.titleLead} <em class="accent">{t.about.identity.titleAccent}</em></h2>
      </div>
      <div class="value-grid reveal">
        {t.about.identity.items.map((item, idx) => (
          <article class:list={['card', idx === 1 && 'card--accent-purple', idx === 2 && 'card--accent-mustard']}>
            <span class="card__icon">
              <Icon name={item.icon} />
            </span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Capacity & Teams -->
  <section class="section section--cream">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">{t.about.team.eyebrow}</span>
        <h2>{t.about.team.titleLead} <em class="accent">{t.about.team.titleAccent}</em></h2>
        <p>{t.about.team.lede}</p>
      </div>
      <div class="grid grid--3 reveal">
        {t.about.team.items.map((team, idx) => (
          <article class:list={['card', idx === 1 && 'card--accent-mustard', idx === 2 && 'card--accent-purple']}>
            <span class="card__icon">
              <Icon name={team.icon} />
            </span>
            <h3>{team.title}</h3>
            <p>{team.body}</p>
            {team.tags && (
              <div class="card__foot">
                <div class="pill-row">
                  {team.tags.map((tag) => (
                    <span class:list={['pill', idx === 0 ? 'pill--green' : idx === 1 ? 'pill--mustard' : 'pill--purple']}>{tag}</span>
                  ))}
                </div>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality Commitment -->
  <section class="section section--dark">
    <div class="wrap split split--reverse reveal">
      <div class="split__media">
        <img src="/img/press.svg" alt="Printing and production" />
      </div>
      <div>
        <span class="eyebrow">{t.about.quality.eyebrow}</span>
        <h2>{t.about.quality.titleLead} <em class="accent">{t.about.quality.titleAccent}</em></h2>
        {t.about.quality.body.map((p) => (
          <p>{p}</p>
        ))}
        <a class="btn btn--primary" href={path('services', lang)}>
          {t.common.learnMore}
          <span class="btn__icon" aria-hidden="true"><Icon name="arrow" /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--cream reveal">
    <div class="wrap">
      <CtaBand
        eyebrow={t.about.cta.eyebrow}
        titleLead={t.about.cta.titleLead}
        titleAccent={t.about.cta.titleAccent}
        lede={t.about.cta.lede}
        buttonText={t.about.cta.button}
        buttonHref={path('contact', lang)}
      />
    </div>
  </section>
</Layout>
