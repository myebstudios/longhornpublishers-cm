---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { LOCALES, type Locale, useTranslations, path } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

const sampleBooks = [
  { title: 'Primary Mathematics 1', level: 'primary', subject: 'maths', lang: 'en', meta: 'Cameroon National Curriculum' },
  { title: 'Mathématiques Primaire 1', level: 'primary', subject: 'maths', lang: 'fr', meta: 'Programme National du Cameroun' },
  { title: 'Secondary English Language Form 1', level: 'secondary', subject: 'english', lang: 'en', meta: 'O-Level / Form 1' },
  { title: 'Langue Française 6ème', level: 'secondary', subject: 'french', lang: 'fr', meta: 'Programme Collège' },
  { title: 'Integrated Science Primary 4', level: 'primary', subject: 'science', lang: 'en', meta: 'Primary School Science' },
  { title: 'Sciences d’Observation 4ème Année', level: 'primary', subject: 'science', lang: 'fr', meta: 'Sciences Primaire' },
];
---

<Layout
  title={t.meta.catalogue.title}
  description={t.meta.catalogue.description}
  locale={lang}
  routeKey="catalogue"
>
  <section class="hero hero--compact">
    <div class="hero__bg"><img src="/img/catalogue.svg" alt="" /></div>
    <div class="wrap">
      <div class="hero__inner">
        <div>
          <span class="eyebrow">{t.catalogue.hero.eyebrow}</span>
          <h1>{t.catalogue.hero.titleLead} <em class="accent">{t.catalogue.hero.titleAccent}</em></h1>
          <p class="hero__lede">{t.catalogue.hero.lede}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Filtered Catalogue -->
  <section class="section section--white reveal" data-filter-scope>
    <div class="wrap">
      <div class="filter-bar">
        <div class="filter-group">
          <span class="filter-group__label">{t.catalogue.filters.level}:</span>
          <button class="chip is-active" data-value="all">{t.common.all}</button>
          <button class="chip" data-value="primary">{t.catalogue.levels.primary}</button>
          <button class="chip" data-value="secondary">{t.catalogue.levels.secondary}</button>
        </div>

        <div class="filter-group">
          <span class="filter-group__label">{t.catalogue.filters.subject}:</span>
          <button class="chip is-active" data-value="all">{t.common.all}</button>
          <button class="chip" data-value="maths">{t.catalogue.subjects.maths}</button>
          <button class="chip" data-value="english">{t.catalogue.subjects.english}</button>
          <button class="chip" data-value="french">{t.catalogue.subjects.french}</button>
          <button class="chip" data-value="science">{t.catalogue.subjects.science}</button>
        </div>

        <div class="filter-group">
          <span class="filter-group__label">{t.catalogue.filters.language}:</span>
          <button class="chip is-active" data-value="all">{t.common.all}</button>
          <button class="chip" data-value="en">{t.catalogue.languages.en}</button>
          <button class="chip" data-value="fr">{t.catalogue.languages.fr}</button>
        </div>

        <div class="ml-auto text-sm text-ink-soft font-display font-medium">
          <span data-filter-count>{sampleBooks.length}</span> {t.common.titles}
        </div>
      </div>

      <div class="grid grid--3">
        {sampleBooks.map((book) => (
          <div class="book-card" data-tags={`${book.level} ${book.subject} ${book.lang}`}>
            <div class="book-card__cover">
              <span>{book.title}</span>
            </div>
            <div class="book-card__body">
              <div class="pill-row">
                <span class="pill pill--green">{book.level.toUpperCase()}</span>
                <span class="pill pill--purple">{book.subject.toUpperCase()}</span>
                <span class="pill">{book.lang.toUpperCase()}</span>
              </div>
              <h3>{book.title}</h3>
              <p class="text-sm text-ink-soft">{book.meta}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--cream reveal">
    <div class="wrap">
      <CtaBand
        eyebrow={t.catalogue.cta.eyebrow}
        titleLead={t.catalogue.cta.titleLead}
        titleAccent={t.catalogue.cta.titleAccent}
        lede={t.catalogue.cta.lede}
        buttonText={t.catalogue.cta.button}
        buttonHref={path('contact', lang)}
      />
    </div>
  </section>
</Layout>
