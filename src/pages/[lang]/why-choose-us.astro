---
import Layout from '../../layouts/Layout.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import { LOCALES, type Locale, useTranslations, path } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
---

<Layout
  title={t.meta.why.title}
  description={t.meta.why.description}
  locale={lang}
  routeKey="why"
>
  <section class="hero hero--compact">
    <div class="hero__bg"><img src="/img/team.svg" alt="" /></div>
    <div class="wrap">
      <div class="hero__inner">
        <div>
          <span class="eyebrow">{t.why.hero.eyebrow}</span>
          <h1>{t.why.hero.titleLead} <em class="accent">{t.why.hero.titleAccent}</em></h1>
          <p class="hero__lede">{t.why.hero.lede}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pillars -->
  <section class="section section--white reveal">
    <div class="wrap">
      <div class="stack">
        {t.why.pillars.map((pillar) => (
          <div class="card mb-6">
            <span class="eyebrow">{pillar.eyebrow}</span>
            <h2 class="text-2xl font-bold font-display my-2">
              {pillar.titleLead} <em class="accent text-green-deep">{pillar.titleAccent}</em>
            </h2>
            {pillar.body.map((p) => (
              <p class="text-ink-soft mb-3">{p}</p>
            ))}
            {pillar.tags && (
              <div class="pill-row mt-3">
                {pillar.tags.map((tag) => (
                  <span class="pill pill--green">{tag}</span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section class="section section--cream reveal">
    <div class="wrap">
      <SectionHead
        eyebrow={t.why.compare.eyebrow}
        titleLead={t.why.compare.titleLead}
        titleAccent={t.why.compare.titleAccent}
      />
      <div class="grid grid--2 mt-lg">
        <div class="card card--dark">
          <span class="eyebrow">{lang === 'fr' ? 'Approche Longhorn' : 'Longhorn Full Service'}</span>
          <h3 class="mb-4">{t.why.compare.good.title}</h3>
          <p class="text-cream opacity-80">{t.why.compare.good.body}</p>
        </div>

        <div class="card">
          <span class="eyebrow text-ink-soft">{lang === 'fr' ? 'Approche Fragmentée' : 'Fragmented Vendors'}</span>
          <h3 class="mb-4">{t.why.compare.bad.title}</h3>
          <p class="text-ink-soft">{t.why.compare.bad.body}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--white reveal">
    <div class="wrap">
      <CtaBand
        eyebrow={t.why.cta.eyebrow}
        titleLead={t.why.cta.titleLead}
        titleAccent={t.why.cta.titleAccent}
        lede={t.why.cta.lede}
        buttonText={t.why.cta.button}
        buttonHref={path('contact', lang)}
      />
    </div>
  </section>
</Layout>
