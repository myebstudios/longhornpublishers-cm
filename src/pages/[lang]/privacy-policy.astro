---
export const prerender = false;
if (Astro.params.lang !== 'en') return Astro.rewrite('/404-runtime');
import Legal from '../../components/pages/Legal.astro';
import type { Locale } from '../../i18n';

const { lang } = Astro.params as { lang: Locale };
---
<Legal locale={lang} page="privacy_policy" />
