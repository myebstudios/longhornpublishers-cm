---
import Layout from '../../layouts/Layout.astro';
import { type Locale, useTranslations } from '../../i18n';
export function getStaticPaths() { return [{ params: { lang: 'en' } }]; }
const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
---
<Layout title={t.meta.privacy.title} description={t.meta.privacy.description} locale={lang} routeKey="privacy">
  <section class="section section--cream">
    <div class="wrap" style="max-width: 72ch;">
      <div class="section-head">
        <h1>{t.legal.privacy.heading}</h1>
        <p class="hero__lede">{t.legal.privacy.intro}</p>
      </div>
      <p style="margin-bottom: 2rem; color: var(--ink-soft); font-size: var(--step--1);">
        <strong>{t.legal.lastUpdatedLabel}:</strong> {t.legal.lastUpdatedValue}
      </p>

      <div class="legal-content" style="display: grid; gap: 2rem; line-height: 1.7;">
        {t.legal.privacy.sections.map((section) => (
          <article>
            <h2 style="font-size: var(--step-1); margin-bottom: 0.5rem; color: var(--burgundy-deep);">{section.title}</h2>
            <p>{section.content}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
