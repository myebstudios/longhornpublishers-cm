---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import {
  coverImage, curriculum, description, subjectName, titleText, getPublishedTitles,
} from '../../../lib/catalogue';
import { path, useTranslations, type Locale } from '../../../i18n';



const { lang } = Astro.params as { lang: Locale };
if ((lang !== 'en' && lang !== 'fr') || !Astro.params.slug) return new Response(null, { status: 404 });
const title = (await getPublishedTitles()).find((row) => row.slug === Astro.params.slug);
if (!title) return new Response(null, { status: 404 });
const t = useTranslations(lang);

const name = titleText(title, lang);
const subject = subjectName(title, lang);
const alignment = curriculum(title, lang);
const cover = coverImage(title, [360, 560, 720]);
const inquiry = `${path('contact', lang)}?title=${encodeURIComponent(name)}`;
// The slug is locale-independent, so each locale's detail URL is just the
// localized catalogue path plus that one slug.
const alternates = {
  en: `${path('catalogue', 'en')}${title.slug}/`,
  fr: `${path('catalogue', 'fr')}${title.slug}/`,
};
---

<Layout
  title={`${name} — Longhorn Publishers`}
  description={description(title, lang)}
  locale={lang}
  routeKey="catalogue"
  alternates={alternates}
>
  <section class="section section--cream catalogue-detail">
    <div class="wrap catalogue-detail__grid">
      <div class="book-card__cover catalogue-detail__cover">
        {cover
          ? <img {...cover} sizes="(min-width: 900px) 360px, 60vw" alt={name} loading="eager" decoding="async" />
          : <span aria-hidden="true">{name}</span>}
      </div>
      <div>
        <span class="eyebrow">{lang === 'fr' ? 'Matériel pédagogique' : 'Learning material'}</span>
        <h1>{name}</h1>
        <div class="pill-row catalogue-detail__pills">
          <span class="pill pill--green">{t.catalogue.levels[title.level]}</span>
          {subject && <span class="pill">{subject}</span>}
          {title.languages.map((code) => <span class="pill">{t.catalogue.languages[code]}</span>)}
        </div>
        <p class="catalogue-detail__lede">{description(title, lang)}</p>
        <dl class="catalogue-detail__facts">
          <div>
            <dt>{lang === 'fr' ? 'ISBN / Code produit' : 'ISBN / Product code'}</dt>
            <dd>{title.product_code}</dd>
          </div>
          <div>
            <dt>{lang === 'fr' ? 'Niveau' : 'Level'}</dt>
            <dd>{t.catalogue.levels[title.level]}</dd>
          </div>
          {subject && (
            <div>
              <dt>{lang === 'fr' ? 'Matière' : 'Subject'}</dt>
              <dd>{subject}</dd>
            </div>
          )}
          {alignment && (
            <div>
              <dt>{lang === 'fr' ? 'Programme' : 'Curriculum alignment'}</dt>
              <dd>{alignment}</dd>
            </div>
          )}
          {title.languages.length > 0 && (
            <div>
              <dt>{lang === 'fr' ? 'Langues disponibles' : 'Available languages'}</dt>
              <dd>{title.languages.map((code) => t.catalogue.languages[code]).join(' · ')}</dd>
            </div>
          )}
        </dl>
        <a class="btn btn--primary" href={inquiry}>
          {t.common.requestTitle}
          <span class="btn__icon" aria-hidden="true">↗</span>
        </a>
        <a class="link-arrow catalogue-detail__back" href={path('catalogue', lang)}>
          {lang === 'fr' ? 'Retour au catalogue' : 'Back to catalogue'}
        </a>
      </div>
    </div>
  </section>
</Layout>
