---
import AdminIcon from './AdminIcon.astro';
const { legacyEditor = false } = Astro.props;
---
<dialog id="adminEditorDialog" class="admin-editor-dialog" aria-labelledby="adminEditorTitle">
 <header class="admin-editor-header"><div><h2 id="adminEditorTitle" tabindex="-1">Edit content</h2><p id="adminEditorContext"><span id={legacyEditor ? "editorTitle" : undefined}></span></p></div><button id={legacyEditor ? "closeEditorBtn" : "adminEditorClose"} class="icon-button" type="button" aria-label="Close editor"><AdminIcon name="close" /></button></header>
 <nav id="adminEditorIndex" class="admin-editor-index" aria-label="Editor sections"></nav>
 <div id="adminEditorBody" class="admin-editor-body"><div id="adminEditorErrors" tabindex="-1" hidden></div><div id={legacyEditor ? "editorCard" : undefined}><slot /></div></div>
 <div id="adminDiscardDecision" class="admin-discard-decision" hidden><h3>Discard unsaved changes?</h3><p>Your working changes will be discarded. Uploaded media may already exist.</p><div><button class="button secondary" id="adminKeepEditing" type="button">Keep editing</button><button class="button danger" id="adminDiscardChanges" type="button">Discard changes</button></div></div>
 <footer id="adminEditorFooter" class="admin-editor-footer"><div><p id="adminSaveConsequence"></p><p id="adminEditorStatus" role="status" aria-live="polite"></p></div><div id="adminEditorActions"></div></footer>
</dialog>
