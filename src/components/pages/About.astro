---
import Layout from '../../layouts/Layout.astro';
import Hero from '../Hero.astro';
import Split from '../Split.astro';
import SectionHead from '../SectionHead.astro';
import CtaBand from '../CtaBand.astro';
import Icon from '../Icon.astro';
import Button from '../Button.astro';
import { type Locale, useTranslations, path } from '../../i18n';
import { getAboutContent, localized, paragraphs } from '../../lib/cms-content';

interface Props { locale: Locale }
const { locale: lang } = Astro.props;
const t = useTranslations(lang);
const about = await getAboutContent();
const heritageBody = about ? paragraphs(localized(lang, about.heritage_copy_en, about.heritage_copy_fr)) : t.about.heritage.body;
const identityKeys = ['purpose', 'vision', 'mission', 'values'] as const;
const identityItems = about
  ? t.about.identity.items.map((item, index) => ({
      ...item,
      body: localized(lang, about[`${identityKeys[index]}_en`], about[`${identityKeys[index]}_fr`]),
    }))
  : t.about.identity.items;
/**
 * `title_en`/`title_fr` when present, else the legacy single-language `title`.
 * Without the bilingual pair a French visitor was shown the English team name.
 */
const teamItems = about?.team_capacity_blocks.length
  ? about.team_capacity_blocks.map((item) => {
      const tags = localized(lang, item.tags_en, item.tags_fr);
      return {
        title: localized(lang, item.title_en, item.title_fr) || item.title,
        body: localized(lang, item.description_en, item.description_fr),
        icon: item.icon ?? 'users',
        tags: tags?.length ? tags : undefined,
      };
    })
  : t.about.team.items;

/** Accent rotation for the four identity cards, matching the original design. */
const IDENTITY_ACCENT = ['', 'card--accent-purple', 'card--accent-mustard', ''];
/** Pill colour per team discipline. */
const TEAM_PILL = ['pill--green', 'pill--mustard', 'pill--purple'];
const TEAM_ACCENT = ['', 'card--accent-mustard', 'card--accent-purple'];
const CAPACITY_SVGS = ['capacity-editorial.svg', 'capacity-design.svg', 'capacity-production.svg'];
---

<Layout title={t.meta.about.title} description={t.meta.about.description} locale={lang} routeKey="about">
  <Hero content={t.about.hero} img="lh-editorial-team-wide.jpg" compact />

  <section class="section section--cream">
    <div class="wrap">
      <Split img="lh-client-consultation.jpg" alt={t.about.heritage.imgAlt}>
        <span class="eyebrow">{t.about.heritage.eyebrow}</span>
        <h2>{t.about.heritage.titleLead} <em class="accent">{t.about.heritage.titleAccent}</em></h2>
        {heritageBody.map((paragraph) => <p>{paragraph}</p>)}
        <a class="link-arrow" href={path('why', lang)}>{t.about.heritage.link}</a>
      </Split>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <SectionHead
        center
        eyebrow={t.about.identity.eyebrow}
        titleLead={t.about.identity.titleLead}
        titleAccent={t.about.identity.titleAccent}
      />
      <div class="value-grid reveal">
        {identityItems.map((item, i) => (
          <article class:list={['card', IDENTITY_ACCENT[i]]}>
            <span class="card__icon"><Icon name={item.icon ?? 'check'} /></span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="wrap">
      <SectionHead
        eyebrow={t.about.team.eyebrow}
        titleLead={t.about.team.titleLead}
        titleAccent={t.about.team.titleAccent}
        lede={t.about.team.lede}
      />
      <div class="grid grid--3 reveal">
        {teamItems.map((item, i) => (
          <article class:list={['card', 'card--capacity', TEAM_ACCENT[i]]} tabindex="0">
            <div class="card__illustration">
              <img src={`/img/${CAPACITY_SVGS[i % CAPACITY_SVGS.length]}`} alt="" loading="lazy" width="400" height="240" />
            </div>
            <div class="card__header-inline">
              <span class="card__icon"><Icon name={item.icon ?? 'users'} /></span>
              <h3>{item.title}</h3>
            </div>
            <p>{item.body}</p>
            {item.tags && (
              <div class="card__foot">
                <div class="pill-row">
                  {item.tags.map((tag) => <span class:list={['pill', TEAM_PILL[i]]}>{tag}</span>)}
                </div>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap">
      <Split img="lh-distribution.jpg" alt={t.about.quality.imgAlt} reverse>
        <span class="eyebrow">{t.about.quality.eyebrow}</span>
        <h2>{t.about.quality.titleLead} <em class="accent">{t.about.quality.titleAccent}</em></h2>
        {t.about.quality.body.map((paragraph) => <p>{paragraph}</p>)}
        <div class="mt-lg">
          <Button href={path('services', lang)} variant="white">{t.about.quality.button}</Button>
        </div>
      </Split>
    </div>
  </section>

  <CtaBand content={t.about.cta} buttonHref={path('contact', lang)} />
</Layout>
