---
import Layout from '../../layouts/Layout.astro';
import Hero from '../Hero.astro';
import Split from '../Split.astro';
import SectionHead from '../SectionHead.astro';
import CtaBand from '../CtaBand.astro';
import Icon from '../Icon.astro';
import Button from '../Button.astro';
import { type Locale, useTranslations, path, LOCALES } from '../../i18n';
import { SERVICE_DETAIL_IMG, disciplineLabel, DISCIPLINE_ACCENT } from '../../data/presentation';
import { getPublishingContent } from '../../lib/cms-content';
import { OFFERINGS } from '../../data/offerings';

interface Props { locale: Locale }
const { locale: lang } = Astro.props;
const t = useTranslations(lang);
// "Discuss editing" / "Discuter d’un projet de révision", eliding "de" before a
// vowel or mute h ("d’impression", "d’illustration").
const discussLabel = (name: string) => {
  const noun = name.toLowerCase();
  if (lang !== 'fr') return `${t.services.discussPrefix} ${noun}`;
  return `${t.services.discussPrefix} ${/^[aeiouyhàâéèêëîïôûù]/.test(noun) ? 'd’' : 'de '}${noun}`;
};
const contactHref = path('contact', lang);
const { services, process } = await getPublishingContent();
const categoryImage: Record<string, string> = { editorial: 'lh-student-reading.jpg', creative: 'lh-creative-wall.jpg', production: 'lh-print-inspection-wide.jpg' };
---

<Layout title={t.meta.services.title} description={t.meta.services.description} locale={lang} routeKey="services">
  <Hero
    content={t.services.hero}
    img="lh-library-reading.jpg"
    compact
    primaryCtaText={t.services.hero.button}
    primaryCtaHref={contactHref}
    secondaryCtaText={t.services.hero.link}
    secondaryCtaHref="#process"
  />

  <section class="section section--white">
    <div class="wrap">
      <SectionHead
        eyebrow={t.services.overview.eyebrow}
        titleLead={t.services.overview.titleLead}
        titleAccent={t.services.overview.titleAccent}
      />
      <div class="grid grid--3 reveal">
        {OFFERINGS.map((offering) => (
          offering.comingSoon ? (
            <article class="card">
              <span class="card__icon"><Icon name={offering.icon} /></span>
              <h3>{offering[lang]}</h3>
              <p>{lang === 'fr' ? 'Bientôt disponible' : 'Coming soon'}</p>
            </article>
          ) : (
            <a class="card" href={offering.id === 'publishing' ? '#publishing' : contactHref}>
              <span class="card__icon"><Icon name={offering.icon} /></span>
              <h3>{offering[lang]}</h3>
              {/* Visible link purpose: three of these cards lead to Contact, not to a service page. */}
              <span class="link-arrow">{offering.id === 'publishing' ? t.common.learnMore : t.common.startConversation}</span>
            </a>
          )
        ))}
      </div>
    </div>
  </section>

  <section class="section section--cream" id="publishing" style="scroll-margin-top:120px">
    <div class="wrap zigzag">
      <div>
        <span class="eyebrow">{lang === 'fr' ? 'Édition' : 'Publishing'}</span>
        <h2>{lang === 'fr' ? 'Du manuscrit à l’œuvre achevée' : 'From manuscript to masterpiece'}</h2>
        <p>{lang === 'fr' ? 'Services éditoriaux, créatifs et de production — disponibles individuellement ou dans le cadre d’un accompagnement complet.' : 'Editorial, creative and production services — available individually or as a single end-to-end engagement.'}</p>
      </div>
      {services.map((service, i) => (
        <Split
          id={service.id}
          img={SERVICE_DETAIL_IMG[service.id] ?? categoryImage[service.discipline]}
          alt={service[lang].name}
          reverse={i % 2 === 1}
        >
          <span class="eyebrow">{disciplineLabel(service.discipline, lang)}</span>
          <h2>{service[lang].name}</h2>
          {service.id === 'editing' ? (
            <>
              <p>{service[lang].body[0]}</p>
              <p>{lang === 'fr' ? 'Nous évaluons :' : 'We assess:'}</p>
              <ul>
                {(lang === 'fr'
                  ? ['Précision linguistique', 'Clarté', 'Fluidité', 'Organisation', 'Structure', 'Cohérence', 'Lisibilité globale']
                  : ['Language accuracy', 'Clarity', 'Flow', 'Organisation', 'Structure', 'Consistency', 'Overall readability']).map((item) => <li>{item}</li>)}
              </ul>
              <p><strong>{lang === 'fr' ? 'Notre rôle :' : 'Our role:'}</strong> {lang === 'fr' ? 'Préserver la voix de l’auteur. Renforcer la publication.' : "Preserve the author's voice. Strengthen the publication."}</p>
            </>
          ) : service.id === 'translation' ? (
            <>
              <p>{lang === 'fr' ? 'Anglais ↔ Français · Français ↔ Anglais' : 'English ↔ French · French ↔ English'}</p>
              {service[lang].body.map((paragraph) => <p>{paragraph}</p>)}
            </>
          ) : service[lang].body.map((paragraph) => <p>{paragraph}</p>)}
          <a class="link-arrow" href={contactHref}>{discussLabel(service[lang].name)}</a>
        </Split>
      ))}
    </div>
  </section>

  <section class="section section--white" id="process" style="scroll-margin-top:120px">
    <div class="wrap">
      <SectionHead
        eyebrow={t.services.process.eyebrow}
        titleLead={t.services.process.titleLead}
        titleAccent={t.services.process.titleAccent}
        lede={t.services.process.lede}
      />
      <div class="steps reveal">
        {process.map((step, i) => (
          <article class:list={['step', i === 0 && 'step--active']}>
            <div class="step__num">{lang === 'fr' ? 'Étape' : 'Step'} {step.num}</div>
            <h3>{step[lang].title}</h3>
            <p>{step[lang].body}</p>
          </article>
        ))}
      </div>
      <div class="mt-lg">
        <Button href={contactHref} variant="dark">{t.common.startConversation}</Button>
      </div>
    </div>
  </section>

  <CtaBand content={t.services.cta} buttonHref={contactHref} />
</Layout>
