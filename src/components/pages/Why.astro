---
import Layout from '../../layouts/Layout.astro';
import Hero from '../Hero.astro';
import Split from '../Split.astro';
import SectionHead from '../SectionHead.astro';
import CtaBand from '../CtaBand.astro';
import { type Locale, useTranslations, path } from '../../i18n';
import { getWhyContent, localized, paragraphs } from '../../lib/cms-content';

interface Props { locale: Locale }
const { locale: lang } = Astro.props;
const t = useTranslations(lang);
const why = await getWhyContent();
const localPresence = why ? paragraphs(localized(lang, why.local_presence_copy_en, why.local_presence_copy_fr)) : null;
const firstPillar = localPresence?.length ? { ...t.why.pillars[0], body: localPresence } : t.why.pillars[0];
/**
 * A managed pillar reproduces the full rendered shape when the optional fields
 * are present: numbered eyebrow, split heading with an accented second half,
 * and pill tags. When they are absent the row is an older flat-title record, so
 * fall back to the i18n eyebrow and render the flat title with no accent.
 */
const pillars = why?.quality_commitment_items.length
  ? [firstPillar, ...why.quality_commitment_items.map((item, index) => {
      const base = t.why.pillars[index + 1] ?? t.why.pillars.at(-1)!;
      const lead = localized(lang, item.title_lead_en, item.title_lead_fr);
      const accent = localized(lang, item.title_accent_en, item.title_accent_fr);
      const eyebrow = localized(lang, item.eyebrow_en, item.eyebrow_fr);
      const tags = localized(lang, item.tags_en, item.tags_fr);
      return {
        ...base,
        eyebrow: eyebrow || base.eyebrow,
        titleLead: lead || localized(lang, item.title_en, item.title_fr),
        titleAccent: accent ?? '',
        body: paragraphs(localized(lang, item.description_en, item.description_fr)),
        tags: tags?.length ? tags : undefined,
      };
    })]
  : [firstPillar, ...t.why.pillars.slice(1)];

/** Photograph per pillar, in order. */
const PILLAR_IMG = ['lh-catalogue-shelves.jpg', 'lh-final-inspection.jpg', 'lh-textbook-library.jpg'];
const PILLAR_TONE = ['section--cream', 'section--white', 'section--cream'];
---

<Layout title={t.meta.why.title} description={t.meta.why.description} locale={lang} routeKey="why">
  <Hero content={t.why.hero} img="lh-reading-discussion.jpg" compact />

  {pillars.map((pillar, i) => (
    <section class:list={['section', PILLAR_TONE[i % PILLAR_TONE.length]]}>
      <div class="wrap">
        <Split img={PILLAR_IMG[i % PILLAR_IMG.length]} alt={pillar.imgAlt} reverse={i % 2 === 1}>
          <span class="eyebrow">{pillar.eyebrow}</span>
          <h2>{pillar.titleLead} <em class="accent">{pillar.titleAccent}</em></h2>
          {pillar.body.map((paragraph) => <p>{paragraph}</p>)}
          {pillar.tags && (
            <div class="pill-row mt-lg">
              {pillar.tags.map((tag) => <span class="pill pill--green">{tag}</span>)}
            </div>
          )}
        </Split>
      </div>
    </section>
  ))}

  <!-- Bilingual Manuscript Slider Section -->
  <section class="section section--white">
    <div class="wrap">
      <SectionHead
        center
        eyebrow={t.why.bilingualSlider.eyebrow}
        titleLead={t.why.bilingualSlider.titleLead}
        titleAccent={t.why.bilingualSlider.titleAccent}
      />

      <div class="bilingual-slider reveal" id="bilingualSlider" data-slider-scope>
        <div class="bilingual-slider__head">
          <span class="bilingual-slider__book-title">
            📘 {t.why.bilingualSlider.bookTitle}
          </span>
          <span class="bilingual-slider__hint">
            {t.why.bilingualSlider.hint}
          </span>
        </div>

        <div class="bilingual-slider__container">
          <!-- English Layer (Base) -->
          <div class="bilingual-slider__panel bilingual-slider__panel--en">
            <span class="pill pill--green" style="width:fit-content;margin-bottom:1rem;">{t.why.bilingualSlider.sourceLabel}</span>
            <p class="bilingual-slider__text">
              Matter is defined as anything that has mass and occupies space. In secondary chemistry, understanding the three states of matter—solid, liquid, and gas—forms the foundation of chemical analysis and experimental observation.
            </p>
          </div>

          <!-- French Layer (Overlay) -->
          <div class="bilingual-slider__panel bilingual-slider__panel--fr" id="frPanel">
            <div class="bilingual-slider__content">
              <span class="pill pill--purple" style="width:fit-content;margin-bottom:1rem;">{t.why.bilingualSlider.translationLabel}</span>
              <p class="bilingual-slider__text">
                La matière est définie comme tout ce qui possède une masse et occupe un espace. En chimie secondaire, la compréhension des trois états de la matière — solide, liquide et gazeux — constitue le fondement de l’analyse chimique et de l’observation expérimentale.
              </p>
            </div>
          </div>

          <!-- Slider Handle & Range Control -->
          <div class="bilingual-slider__handle" id="sliderHandle" aria-hidden="true">
            <div class="bilingual-slider__handle-line"></div>
            <div class="bilingual-slider__handle-button">↔</div>
          </div>

          <input
            type="range"
            min="0"
            max="100"
            value="50"
            class="bilingual-slider__range"
            id="bilingualRange"
            role="slider"
            aria-valuenow="50"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-label={t.why.bilingualSlider.ariaLabel}
          />
        </div>

        <p class="bilingual-slider__attribution">
          {t.why.bilingualSlider.attribution}
        </p>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap">
      <SectionHead
        center
        eyebrow={t.why.compare.eyebrow}
        titleLead={t.why.compare.titleLead}
        titleAccent={t.why.compare.titleAccent}
      />
      <div class="grid grid--2 reveal">
        <article class="card card--dark">
          <h3>{t.why.compare.bad.title}</h3>
          <p class="stack">{t.why.compare.bad.body}</p>
        </article>
        <article class="card">
          <h3>{t.why.compare.good.title}</h3>
          <p class="stack">{t.why.compare.good.body}</p>
        </article>
      </div>
    </div>
  </section>

  <CtaBand content={t.why.cta} buttonHref={path('contact', lang)} />
</Layout>

<script>
  function setupBilingualSlider() {
    const range = document.getElementById('bilingualRange') as HTMLInputElement | null;
    const frPanel = document.getElementById('frPanel');
    const handle = document.getElementById('sliderHandle');
    const container = document.querySelector('.bilingual-slider__container') as HTMLElement | null;

    if (!range || !frPanel || !handle) return;

    function updateSlider(val: number) {
      const clamped = Math.max(0, Math.min(100, val));
      range!.value = clamped.toString();
      range!.setAttribute('aria-valuenow', clamped.toString());
      
      frPanel!.style.width = `${clamped}%`;
      handle!.style.left = `${clamped}%`;
      
      const content = frPanel!.querySelector('.bilingual-slider__content') as HTMLElement | null;
      if (content && container) {
        content.style.width = `${container.clientWidth}px`;
      }
    }

    range.addEventListener('input', (e) => {
      updateSlider(Number((e.target as HTMLInputElement).value));
    });

    window.addEventListener('resize', () => {
      updateSlider(Number(range.value));
    });

    updateSlider(50);
  }

  setupBilingualSlider();
</script>
