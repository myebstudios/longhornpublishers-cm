---
/**
 * Article detail view — the `NewsArticle` component named in
 * Docs/technical_architecture.md §61.
 *
 * Shared by the English route and the localized French one, which cannot share
 * a `[lang]` path because ROUTES.news differs per locale (`news` / `actualites`).
 */
import Layout from '../../layouts/Layout.astro';
import Button from '../Button.astro';
import { type Locale, useTranslations, path } from '../../i18n';
import {
  bodyParagraphs, categoryKey, excerpt, headline, newsImage, publishedOn, type NewsArticleDetail,
} from '../../lib/news';

interface Props { locale: Locale; article: NewsArticleDetail }
const { locale: lang, article } = Astro.props;
const t = useTranslations(lang);

const title = headline(article, lang);
const date = publishedOn(article, lang);
const paragraphs = bodyParagraphs(article, lang);
// Parent segment is localized, so alternates are composed per locale.
const alternates = {
  en: `${path('news', 'en')}${article.slug}/`,
  fr: `${path('news', 'fr')}${article.slug}/`,
};
---

<Layout
  title={`${title} — Longhorn Publishers`}
  description={excerpt(article, lang)}
  locale={lang}
  routeKey="news"
  alternates={alternates}
  type="article"
>
  <div
    id="readingProgress"
    class="reading-progress-bar"
    aria-hidden="true"
  ></div>

  <article class="section section--white section--page-top">
    <div class="wrap wrap--narrow article-detail">
      <div class="pill-row article-detail__meta">
        <span class:list={['cat-badge', `cat-badge--${categoryKey(article.category)}`]}>{t.news.categories[categoryKey(article.category)]}</span>
        {date && <time datetime={article.publish_date!}>{date}</time>}
      </div>

      <h1>{title}</h1>
      <p class="article-detail__lede">{excerpt(article, lang)}</p>

      {newsImage(article) && (
        <img class="article-detail__image" src={newsImage(article)!} alt="" width="960" height="540" decoding="async" />
      )}

      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}

      <Button href={path('news', lang)} variant="outline" class="article-detail__back">
        {lang === 'fr' ? 'Retour aux actualités' : 'Back to news'}
      </Button>
    </div>
  </article>
</Layout>

<script>
  function setupReadingProgress() {
    const bar = document.getElementById('readingProgress');
    const article = document.querySelector('.article-detail');
    if (!bar || !article) return;

    function updateProgress() {
      const rect = article.getBoundingClientRect();
      const totalScrollable = rect.height - window.innerHeight;
      const currentScroll = Math.max(0, -rect.top);
      const ratio = totalScrollable > 0 ? Math.min(1, Math.max(0, currentScroll / totalScrollable)) : 0;
      
      bar.style.transform = `scaleX(${ratio})`;
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress, { passive: true });
    updateProgress();
  }

  setupReadingProgress();
</script>

<style>
  .article-detail__meta { align-items: center; gap: .75rem; margin-bottom: 1.25rem; }
  .article-detail__meta time { color: var(--ink-soft); font-size: var(--step--1); }
  .article-detail__lede { margin: 1rem 0 2rem; font-size: var(--step-1); color: var(--ink-soft); }
  .article-detail p + p { margin-top: 1rem; }
  .article-detail__image { display: block; width: 100%; height: auto; border-radius: var(--radius); margin-bottom: 2rem; }
  .article-detail__back { display: inline-block; margin-top: 2.5rem; }
</style>
