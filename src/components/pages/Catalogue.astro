---
import Layout from '../../layouts/Layout.astro';
import Hero from '../Hero.astro';
import Button from '../Button.astro';
import CtaBand from '../CtaBand.astro';
import { type Locale, useTranslations, path } from '../../i18n';
import {
  coverImage, filterTags, getPublishedTitles, subjectFilters, titleText,
} from '../../lib/catalogue';

interface Props { locale: Locale }
const { locale: lang } = Astro.props;
const t = useTranslations(lang);
const cataloguePath = path('catalogue', lang);

/**
 * Titles come from Netlify DB at build time. Until the first one is published —
 * or if the database is unreachable during the build — `titles` is empty and the
 * page shows its "coming soon" state rather than an empty grid under live filters.
 */
const titles = await getPublishedTitles();

const levelFilters = [
  { value: 'all', label: t.common.all },
  { value: 'primary', label: t.catalogue.levels.primary },
  { value: 'secondary', label: t.catalogue.levels.secondary },
];
// Subjects are database rows, not a fixed enum, so the chips come from the data.
const subjects = subjectFilters(titles, lang);
const languageFilters = [
  { value: 'all', label: t.common.all },
  { value: 'en', label: t.catalogue.languages.en },
  { value: 'fr', label: t.catalogue.languages.fr },
];

const filterGroups = [
  { label: t.catalogue.filters.level, options: levelFilters },
  ...(subjects.length
    ? [{ label: t.catalogue.filters.subject, options: [{ value: 'all', label: t.common.all }, ...subjects] }]
    : []),
  { label: t.catalogue.filters.language, options: languageFilters },
];
---

<Layout title={t.meta.catalogue.title} description={t.meta.catalogue.description} locale={lang} routeKey="catalogue">
  <Hero content={t.catalogue.hero} img="lh-maths-classroom.jpg" compact />

  <section class="section section--cream">
    {titles.length === 0 ? (
      <div class="wrap">
        <div class="empty-state reveal">
          <span class="eyebrow">{t.catalogue.hero.eyebrow}</span>
          <h2>{t.catalogue.unpublished.heading}</h2>
          <p>{t.catalogue.unpublished.body}</p>
          <Button href={path('contact', lang)} variant="primary">{t.catalogue.unpublished.cta}</Button>
        </div>
      </div>
    ) : (
      <div class="wrap catalogue-shop" data-filter-scope>
        <button
          class="catalogue-mobile-trigger"
          id="mobileFilterTrigger"
          type="button"
          aria-expanded="false"
          aria-controls="catalogueFilters"
        >
          <span>🔍 {t.catalogue.filters.title}</span>
        </button>

        <div class="catalogue-filters-backdrop" id="filterBackdrop" aria-hidden="true"></div>

        <aside class="catalogue-filters reveal" id="catalogueFilters" aria-label={t.catalogue.filters.title}>
          <div class="catalogue-filters__head">
            <h2>{t.catalogue.filters.title}</h2>
            <div style="display:flex;align-items:center;gap:.75rem;">
              <p aria-live="polite"><strong data-filter-count>{titles.length}</strong> {t.common.titles}</p>
              <button class="catalogue-filters__close" type="button" id="closeFilterBtn" aria-label={lang === 'fr' ? 'Fermer les filtres' : 'Close filters'}>✕</button>
            </div>
          </div>

          <div class="catalogue-search">
            <label for="catalogue-search">{t.catalogue.filters.search}</label>
            <input id="catalogue-search" type="search" autocomplete="off" placeholder={t.catalogue.filters.searchPlaceholder} data-filter-search />
          </div>

          {filterGroups.map((group) => (
            <div class="filter-group" role="radiogroup" aria-label={group.label}>
              <span class="filter-group__label">{group.label}</span>
              <div class="filter-group__options">
                {group.options.map((option, i) => (
                  <button
                    class:list={['chip', i === 0 && 'is-active']}
                    type="button"
                    role="radio"
                    tabindex={i === 0 ? '0' : '-1'}
                    aria-checked={i === 0 ? 'true' : 'false'}
                    aria-pressed={i === 0 ? 'true' : 'false'}
                    data-value={option.value}
                  >{option.label}</button>
                ))}
              </div>
            </div>
          ))}
          <button class="catalogue-filters__reset" type="button" data-filter-reset>{t.catalogue.empty.reset}</button>
        </aside>

        <div class="catalogue-results">
          <div class="filter-empty-state is-hidden" data-filter-empty hidden aria-hidden="true">
            <p>{t.catalogue.empty.message}</p>
            <button class="btn btn--ghost btn--sm" type="button" data-filter-reset>{t.catalogue.empty.reset}</button>
          </div>

          <div class="catalogue-grid reveal">
          {titles.map((title) => (
            <article
              class="book-card"
              data-cover-tilt
              data-tags={filterTags(title)}
              data-search={[titleText(title, lang), title.description_en, title.description_fr, title.product_code, title.subject_en, title.subject_fr].filter(Boolean).join(' ').toLocaleLowerCase()}
            >
              <a
                class="book-card__link"
                href={`${cataloguePath}${title.slug}/`}
                aria-label={titleText(title, lang)}
              >
                <div class="book-card__cover">
                {coverImage(title)
                  ? <img
                      {...coverImage(title)!}
                      sizes="(min-width: 1240px) 280px, (min-width: 640px) 30vw, 45vw"
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  : <span aria-hidden="true">{titleText(title, lang)}</span>}
                </div>
              </a>
              <div class="book-card__body">
                {title.languages && title.languages.includes('en') && title.languages.includes('fr') && (
                  <span class="cat-badge cat-badge--creative" style="font-size:11px;padding:.2rem .6rem;margin-bottom:.35rem;width:fit-content;">EN &amp; FR Edition</span>
                )}
                <h3>{titleText(title, lang)}</h3>
                <Button href={`${path('contact', lang)}?title=${encodeURIComponent(titleText(title, lang))}`} variant="dark" size="sm">
                  {t.common.requestTitle}
                </Button>
              </div>
            </article>
          ))}
          </div>
        </div>
      </div>
    )}
  </section>

  <CtaBand content={t.catalogue.cta} buttonHref={path('contact', lang)} />
</Layout>

<script>
  import { trapFocus } from '../../lib/a11y';

  function setupCatalogueMobileFilters() {
    const trigger = document.getElementById('mobileFilterTrigger');
    const drawer = document.getElementById('catalogueFilters');
    const backdrop = document.getElementById('filterBackdrop');
    const closeBtn = document.getElementById('closeFilterBtn');

    if (!trigger || !drawer) return;

    function openFilters() {
      trigger?.setAttribute('aria-expanded', 'true');
      drawer?.classList.add('is-open');
      document.body.classList.add('nav-open');
      const firstInput = drawer?.querySelector<HTMLElement>('input, button');
      firstInput?.focus();
    }

    function closeFilters(restoreFocus = false) {
      trigger?.setAttribute('aria-expanded', 'false');
      drawer?.classList.remove('is-open');
      document.body.classList.remove('nav-open');
      if (restoreFocus) trigger?.focus();
    }

    trigger.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      if (isOpen) closeFilters();
      else openFilters();
    });

    backdrop?.addEventListener('click', () => closeFilters(true));
    closeBtn?.addEventListener('click', () => closeFilters(true));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
        closeFilters(true);
      }
    });

    // Trap Tab inside the sheet while it is open. Gated on aria-expanded so the
    // desktop sidebar — which is always visible and never opened via the
    // trigger — keeps ordinary tab order.
    trapFocus(drawer, () => trigger.getAttribute('aria-expanded') === 'true');

    // ARIA radiogroup arrow navigation (reconciling 0ef00979)
    const groups = Array.from(document.querySelectorAll<HTMLElement>('[role="radiogroup"]'));
    groups.forEach((group) => {
      const radios = Array.from(group.querySelectorAll<HTMLButtonElement>('[role="radio"]'));
      group.addEventListener('keydown', (e) => {
        if (!['ArrowRight', 'ArrowLeft', 'ArrowDown', 'ArrowUp'].includes(e.key)) return;
        const currentIdx = radios.indexOf(document.activeElement as HTMLButtonElement);
        if (currentIdx === -1) return;

        e.preventDefault();
        let nextIdx = currentIdx;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          nextIdx = (currentIdx + 1) % radios.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          nextIdx = (currentIdx - 1 + radios.length) % radios.length;
        }

        radios[nextIdx]?.click();
        radios[nextIdx]?.focus();
      });
    });
  }

  setupCatalogueMobileFilters();
</script>
