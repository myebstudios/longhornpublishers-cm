---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import type { Locale, RouteKey } from '../i18n';
import { path } from '../i18n';
import { en } from '../i18n/en';
import { fr } from '../i18n/fr';
import { SERVICES, PROCESS, TITLES, ARTICLES, titleSlug } from '../data/site';

interface Props {
  file: 'index' | 'about' | 'services' | 'catalogue' | 'why-choose-us' | 'contact' | 'news';
  locale: Locale;
}

const { file, locale } = Astro.props;
const source = readFileSync(resolve(process.cwd(), 'prototype', `${file}.html`), 'utf8');
const bodyMatch = source.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
if (!bodyMatch) throw new Error(`Prototype page ${file}.html has no body element`);

const pageImages: Record<Props['file'], string[]> = {
  index: [],
  about: ['lh-editorial-team-wide.png', 'lh-client-consultation.jpg', 'lh-distribution.jpg'],
  'why-choose-us': ['lh-reading-discussion.jpg', 'lh-catalogue-shelves.jpg', 'lh-final-inspection.jpg', 'lh-textbook-library.jpg'],
  catalogue: ['lh-maths-classroom.jpg'],
  contact: ['lh-reading-nook.jpg'],
  services: ['lh-library-reading.jpg', 'lh-student-reading.jpg', 'lh-print-quality.jpg', 'lh-bilingual-editor-wide.png', 'lh-creative-wall.jpg', 'lh-illustration-studio.jpg', 'lh-print-inspection-wide.png'],
  news: ['lh-book-delivery.jpg'],
};

let imageIndex = 0;
let markup = bodyMatch[1]
  .replaceAll('assets/img/', '/img/')
  // Every active visual slot receives a distinct local photograph. The old
  // SVG filenames are retained only inside the archived prototype source.
  .replace(/\/img\/(?:hero|team|editorial|creative|catalogue|production|press)\.svg/g, (placeholder) =>
    pageImages[file][imageIndex++] ? `/img/${pageImages[file][imageIndex - 1]}` : placeholder,
  )
  .replace('Prototype only — no data is submitted or stored. In production this posts to a Netlify Function.', 'Your details are submitted securely to the Longhorn Cameroon team.')
  .replace(
    '<form class="form" data-prototype-form>',
    '<form class="form" name="contact" method="POST" action="/__forms.html" data-netlify="true" netlify-honeypot="bot-field"><input type="hidden" name="form-name" value="contact"><p class="visually-hidden"><label>Do not fill this out: <input name="bot-field"></label></p>',
  );

if (file === 'news') {
  const copy = locale === 'fr'
    ? {
        eyebrow: 'Actualités', title: 'Des nouvelles', accent: 'bientôt disponibles',
        lede: 'Les annonces de Longhorn Publishers Cameroun seront publiées ici dès leur validation.',
        heading: 'Restez informé', body: 'Nous préparons les prochaines actualités, parutions et informations de partenariat. Pour toute demande immédiate, notre équipe est à votre écoute.',
        cta: 'Nous contacter',
      }
    : {
        eyebrow: 'News & updates', title: 'Fresh updates', accent: 'are coming soon',
        lede: 'Verified announcements from Longhorn Publishers Cameroon will be published here.',
        heading: 'Stay informed', body: 'We are preparing upcoming news, title releases and partnership updates. For an immediate enquiry, our team is ready to help.',
        cta: 'Contact us',
      };
  markup = `
    <section class="hero hero--compact">
      <div class="hero__bg"><img src="/img/lh-book-delivery.jpg" alt="" /></div>
      <div class="wrap"><div class="hero__inner"><div>
        <span class="eyebrow">${copy.eyebrow}</span>
        <h1>${copy.title} <em class="accent">${copy.accent}</em></h1>
        <p class="hero__lede">${copy.lede}</p>
      </div></div></div>
    </section>
    <section class="section section--cream"><div class="wrap">
      <div class="empty-state reveal">
        <span class="eyebrow">${copy.eyebrow}</span>
        <h2>${copy.heading}</h2>
        <p>${copy.body}</p>
        <a class="button button--primary" href="${path('contact', locale)}">${copy.cta}</a>
      </div>
    </div></section>`;
}

if (file === 'contact') {
  markup = markup.replace('</form>', '<p class="form__status" aria-live="polite"></p></form>');
}

const routeFiles: Array<[string, RouteKey]> = [
  ['why-choose-us.html', 'why'], ['catalogue.html', 'catalogue'],
  ['services.html', 'services'], ['contact.html', 'contact'],
  ['about.html', 'about'], ['news.html', 'news'], ['index.html', 'home'],
];
for (const [htmlFile, routeKey] of routeFiles) {
  const escaped = htmlFile.replace('.', '\\.');
  markup = markup.replace(new RegExp(`${escaped}(#[^\"']*)?`, 'g'), (_match, hash = '') => `${path(routeKey, locale)}${hash}`);
}

if (file === 'catalogue') {
  let titleIndex = 0;
  markup = markup.replace(
    /(<article class="book-card"[\s\S]*?<a class="link-arrow" style="font-size:var\(--step--1\)" href=")[^"]+("?>Request this title)/g,
    (_match, before: string, after: string) => {
      const title = TITLES[titleIndex++];
      return title ? `${before}/${locale}/catalogue/${titleSlug(title, locale)}/${after}` : _match;
    },
  );
}

function collectPairs(sourceValue: unknown, targetValue: unknown, pairs: Array<[string, string]>) {
  if (typeof sourceValue === 'string' && typeof targetValue === 'string' && sourceValue !== targetValue) {
    pairs.push([sourceValue, targetValue]); return;
  }
  if (Array.isArray(sourceValue) && Array.isArray(targetValue)) {
    sourceValue.forEach((value, index) => collectPairs(value, targetValue[index], pairs)); return;
  }
  if (sourceValue && targetValue && typeof sourceValue === 'object' && typeof targetValue === 'object') {
    for (const key of Object.keys(sourceValue)) collectPairs((sourceValue as Record<string, unknown>)[key], (targetValue as Record<string, unknown>)[key], pairs);
  }
}

if (locale === 'fr') {
  const pairs: Array<[string, string]> = [];
  collectPairs(en, fr, pairs);
  SERVICES.forEach((service) => collectPairs(service.en, service.fr, pairs));
  PROCESS.forEach((step) => collectPairs(step.en, step.fr, pairs));
  TITLES.forEach((title) => collectPairs(title.en, title.fr, pairs));
  ARTICLES.forEach((article) => collectPairs(article.en, article.fr, pairs));
  pairs.push(
    ['Structural and line editing that sharpens argument, accuracy and readability before a word reaches layout.', 'Une révision structurelle et stylistique qui renforce l’argumentation, l’exactitude et la lisibilité avant la mise en page.'],
    ['The final quality gate — grammar, consistency, typography and factual detail checked line by line.', 'Le dernier contrôle qualité — grammaire, cohérence, typographie et exactitude vérifiées ligne par ligne.'],
    ['English to French and back, handled by translators who work in the education context daily — not literal, but localised.', 'De l’anglais au français et inversement, par des traducteurs du secteur éducatif — une adaptation locale, jamais littérale.'],
    ['Cover and interior design, typesetting and layout built for legibility in the classroom and on the shelf.', 'Couvertures, intérieurs, composition et mise en page pensés pour la lisibilité en classe comme en rayon.'],
    ['Original artwork and diagrams — culturally grounded imagery that learners recognise as their own.', 'Illustrations et schémas originaux — une imagerie culturellement pertinente dans laquelle les élèves se reconnaissent.'],
    ['Print production and delivery at the quality and volume an institutional rollout demands.', 'Production et livraison imprimées au niveau de qualité et au volume exigés par un déploiement institutionnel.'],
    ['Sample excerpt. Real articles are authored in the admin panel post-launch.', 'Extrait d’exemple. Les articles réels seront rédigés dans l’espace d’administration après le lancement.'],
    ['Step 01', 'Étape 01'], ['Step 02', 'Étape 02'], ['Step 03', 'Étape 03'], ['Step 04', 'Étape 04'], ['Step 05', 'Étape 05'],
    ['We map the scope, audience, curriculum requirements and language needs before quoting.', 'Nous définissons le périmètre, le public, les exigences du programme et les besoins linguistiques avant tout devis.'],
    ['Schedule, team allocation and milestones agreed in writing, with both language tracks planned together.', 'Calendrier, affectation de l’équipe et jalons convenus par écrit, les deux versions linguistiques étant planifiées ensemble.'],
    ['Editorial, design and illustration run in parallel against the agreed brief.', 'La révision, la conception et l’illustration avancent en parallèle selon le cahier des charges convenu.'],
    ['Proofreading, factual checks and curriculum alignment verified before sign-off to print.', 'Correction d’épreuves, vérification des faits et conformité au programme contrôlées avant le bon à tirer.'],
    ['Printing, finishing and distribution to the schedule set at planning.', 'Impression, façonnage et distribution selon le calendrier fixé lors de la planification.'],
    ['Placeholder headline for a company news item', 'Exemple de titre pour une actualité de l’entreprise'],
    ['Placeholder headline for a new title announcement', 'Exemple de titre pour l’annonce d’un nouvel ouvrage'],
    ['Placeholder headline for a partnership update', 'Exemple de titre pour une actualité de partenariat'],
    ["We describe ourselves as content creators and platform business providers — we make the content, and we run the process that gets it into learners' hands.", 'Nous nous définissons comme créateurs de contenus et fournisseurs de solutions éditoriales — nous produisons le contenu et pilotons le processus qui le met entre les mains des élèves.'],
    ['Your details are submitted securely to the Longhorn Cameroon team.', 'Vos coordonnées sont transmises de manière sécurisée à l’équipe de Longhorn Cameroun.'],
    ['Placeholder articles. Whether News ships at launch — and who on the Cameroon team owns posting — is open item 5 in Docs/README.md.', 'Articles d’exemple. La publication des actualités au lancement et leur responsable au sein de l’équipe camerounaise restent à confirmer.'],
    ['Do not fill this out:', 'Ne remplissez pas ce champ :'],
    ['Longhorn Publishers Cameroon Ltd — Yaoundé, Cameroon', 'Longhorn Publishers Cameroun Ltd — Yaoundé, Cameroun'],
    ['Get directions', 'Obtenir l’itinéraire'],
    ['Placeholder articles. Whether News ships at launch — and who on the Cameroon team owns posting —', 'Articles d’exemple. La publication des actualités au lancement et leur responsable au sein de l’équipe camerounaise'],
    ['is open item 5 in', 'restent à confirmer au point 5 dans'],
  );
  pairs.sort((a, b) => b[0].length - a[0].length);
  markup = markup.replace(/>([^<]+)</g, (whole, text: string) => {
    const leading = text.match(/^\s*/)?.[0] ?? '';
    const trailing = text.match(/\s*$/)?.[0] ?? '';
    const normalized = text.replace(/\s+/g, ' ').trim();
    const pair = pairs.findLast(([english]) => normalized === english || normalized === english.replaceAll('&', '&amp;'));
    return pair ? `>${leading}${pair[1]}${trailing}<` : whole;
  });
}
---

<Fragment set:html={markup} />
