---
import type { Locale, RouteKey } from '../i18n';
import { useTranslations, path, NAV_KEYS } from '../i18n';
import Icon from './Icon.astro';
import logo from '../../Assets/Longhorn CM logo.svg';

interface Props {
  locale: Locale;
  currentRouteKey: RouteKey | null;
  /** Per-locale paths for pages nested under a route (e.g. a catalogue detail
   *  page), so switching language keeps the visitor on the same item. */
  alternates?: Record<Locale, string>;
  siteName?: string;
}

const { locale, currentRouteKey, alternates, siteName } = Astro.props;
const t = useTranslations(locale);
/** Where each language button points for the page currently being rendered. */
const localeHref = (target: Locale) =>
  alternates?.[target] ?? path(currentRouteKey ?? 'home', target);
---

<header class="site-header" id="siteHeader">
  <div class="wrap">
    <div class="site-header__inner">
      <a class="brand" href={path('home', locale)} aria-label={`${siteName ?? `${t.brand.name} ${t.brand.sub}`} — ${t.nav.home}`}>
        <img class="brand__logo" src={logo.src} alt="" aria-hidden="true" />
      </a>

      <nav class="nav" id="primaryNav" aria-label={t.nav.primaryNav}>
        {NAV_KEYS.map((key) => {
          const href = path(key, locale);
          const isCurrent = key === currentRouteKey;
          return (
            <a href={href} aria-current={isCurrent ? 'page' : undefined}>
              {t.nav[key]}
            </a>
          );
        })}
        <div class="nav__mobile-cta">
          <a class="btn btn--dark btn--full" href={path('contact', locale)}>
            <span>{t.nav.getInTouch}</span>
            <span class="btn__icon" aria-hidden="true"><Icon name="arrow" /></span>
          </a>
        </div>
      </nav>

      <div class="header__actions">
        <div class="lang-toggle" role="group" aria-label={t.nav.language}>
          <a
            href={localeHref('en')}
            class:list={['lang-btn', { 'is-active': locale === 'en' }]}
            aria-current={locale === 'en' ? 'true' : undefined}
            hreflang="en"
            lang="en"
          >
            EN
          </a>
          <a
            href={localeHref('fr')}
            class:list={['lang-btn', { 'is-active': locale === 'fr' }]}
            aria-current={locale === 'fr' ? 'true' : undefined}
            hreflang="fr"
            lang="fr"
          >
            FR
          </a>
        </div>

        <a class="btn btn--dark btn--sm header__contact" href={path('contact', locale)} aria-label={t.nav.getInTouch}>
          <span class="header__contact-label">{t.nav.getInTouch}</span>
          <span class="btn__icon" aria-hidden="true"><Icon name="arrow" /></span>
        </a>

        <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="primaryNav" aria-label={t.nav.menu}>
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>
  <div class="nav-backdrop" id="navBackdrop" aria-hidden="true"></div>
</header>

<style>
  .lang-btn {
    padding: .35rem .7rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: .8rem;
    font-weight: 600;
    color: var(--ink-soft);
    transition: all .2s ease;
    display: inline-block;
  }
  .lang-btn.is-active {
    background: var(--burgundy);
    color: var(--white);
  }
</style>
