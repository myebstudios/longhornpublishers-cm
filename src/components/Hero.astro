---
import Icon from './Icon.astro';
import Button from './Button.astro';
import { responsive } from '../lib/images';
import type { Titled } from '../i18n/types';

interface Props {
  content?: Titled;
  eyebrow?: string;
  titleLead?: string;
  titleAccent?: string;
  lede?: string;
  img?: string;
  compact?: boolean;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
}

const {
  content,
  eyebrow = content?.eyebrow,
  titleLead = content?.titleLead || '',
  titleAccent = content?.titleAccent || '',
  lede = content?.lede,
  img = 'hero',
  compact = false,
  primaryCtaText,
  primaryCtaHref,
  secondaryCtaText,
  secondaryCtaHref,
} = Astro.props;

// The hero is the LCP element on every page: full-bleed, eager, high priority.
const { src, srcset } = responsive(img);
---

<section class:list={['hero', compact && 'hero--compact']}>
  <div class="hero__bg"><img src={src} srcset={srcset} sizes={srcset ? '100vw' : undefined} alt="" loading="eager" fetchpriority="high" decoding="async" /></div>
  <div class="wrap">
    <div class="hero__inner">
      <div>
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}

        <h1>
          {titleLead} {titleAccent && <em class="accent">{titleAccent}</em>}
        </h1>

        {lede && <p class="hero__lede">{lede}</p>}

        <div class="hero__cta">
          {primaryCtaText && primaryCtaHref && (
            <Button href={primaryCtaHref} variant="primary">
              {primaryCtaText}
            </Button>
          )}
          {secondaryCtaText && secondaryCtaHref && (
            <a href={secondaryCtaHref} class="link-arrow">
              {secondaryCtaText}
            </a>
          )}
          <slot />
        </div>
      </div>
    </div>
  </div>
</section>

