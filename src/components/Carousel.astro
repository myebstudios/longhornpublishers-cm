---
import CarouselNavButton from './CarouselNavButton.astro';
interface Props {
  prevLabel: string;
  nextLabel: string;
  ariaLabel?: string;
  center?: boolean;
  class?: string;
}
const {
  prevLabel,
  nextLabel,
  ariaLabel = prevLabel.includes('précédent') || prevLabel.includes('Précédent') ? 'Carrousel' : 'Carousel',
  center = false,
  class: cls = '',
} = Astro.props;
---
<div class:list={['carousel', 'reveal', cls]}>
  {Astro.slots.has('header') && (
    <div class="carousel__header">
      <div class="carousel__header-main">
        <slot name="header" />
      </div>
      <div class="carousel__controls carousel__controls--header">
        <CarouselNavButton direction="prev" label={prevLabel} />
        <CarouselNavButton direction="next" label={nextLabel} />
      </div>
    </div>
  )}

  <div class="carousel__viewport" tabindex="0" role="region" aria-label={ariaLabel}>
    <div class="carousel__track"><slot /></div>
  </div>

  {!Astro.slots.has('header') && (
    <div class:list={['carousel__controls', center && 'carousel__controls--center']}>
      <CarouselNavButton direction="prev" label={prevLabel} />
      <CarouselNavButton direction="next" label={nextLabel} />
    </div>
  )}
</div>
