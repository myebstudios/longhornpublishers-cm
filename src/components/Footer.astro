---
import type { Locale } from '../i18n';
import { useTranslations, path, NAV_KEYS } from '../i18n';
import Icon from './Icon.astro';
import logo from '../../Assets/Longhorn CM logo.svg';
import type { SiteSettings } from '../lib/cms-content';
import { localized } from '../lib/cms-content';

interface Props {
  locale: Locale;
  settings: SiteSettings;
}

const { locale, settings } = Astro.props;
const t = useTranslations(locale);
const contactInfo = {
  address: settings.address,
  phone1: settings.phone_1,
  phone2: settings.phone_2,
  email: settings.email,
};
const footerTagline = localized(locale, settings.footer_tagline_en, settings.footer_tagline_fr)
  ?? localized(locale, settings.tagline_en, settings.tagline_fr);
const newsletterCopy = localized(locale, settings.newsletter_copy_en, settings.newsletter_copy_fr)
  ?? t.footer.newsletter;

const serviceAnchors = [
  { en: 'Editing', fr: 'Révision', slug: 'editing' },
  { en: 'Proofreading', fr: 'Correction d’épreuves', slug: 'proofreading' },
  { en: 'Translation', fr: 'Traduction', slug: 'translation' },
  { en: 'Designing', fr: 'Conception graphique', slug: 'designing' },
  { en: 'Illustration', fr: 'Illustration', slug: 'illustration' },
  { en: 'Printing', fr: 'Impression', slug: 'printing' },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer__top">
      <div>
        <a class="brand" href={path('home', locale)} aria-label={`${t.brand.name} ${t.brand.sub}`}>
          <img class="brand__logo brand__logo--footer" src={logo.src} alt="" aria-hidden="true" />
        </a>
        <p class="footer__blurb">
          {footerTagline}
        </p>
        <form class="newsletter" name="newsletter" method="POST" action="/__forms.html" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="newsletter" />
          <p class="visually-hidden"><label>{locale === 'fr' ? 'Ne remplissez pas ce champ :' : 'Do not fill this out:'} <input name="bot-field" /></label></p>
          <label class="visually-hidden" for={`footerEmail-${locale}`}>{locale === 'fr' ? 'Adresse e-mail' : 'Email address'}</label>
          <input id={`footerEmail-${locale}`} type="email" name="email" placeholder={newsletterCopy} required />
          <button type="submit" aria-label={locale === 'fr' ? 'S’abonner' : 'Subscribe'}><Icon name="arrow" /></button>
          <p class="form__status" aria-live="polite"></p>
        </form>
      </div>

      <div class="footer__col">
        <h4>{locale === 'fr' ? 'Explorer' : 'Explore'}</h4>
        <ul>
          {NAV_KEYS.map((key) => (
            <li><a href={path(key, locale)}>{t.nav[key]}</a></li>
          ))}
          <li><a href={path('news', locale)}>{t.nav.news}</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h4>{locale === 'fr' ? 'Services' : 'Services'}</h4>
        <ul>
          {serviceAnchors.map((s) => (
            <li><a href={`${path('services', locale)}#${s.slug}`}>{s[locale]}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer__col">
        <h4>{t.nav.getInTouch}</h4>
        <ul>
          {contactInfo.address && <li><p>{contactInfo.address}</p></li>}
          {contactInfo.phone1 && <li><a href={`tel:${contactInfo.phone1.replace(/\s/g, '')}`}>{contactInfo.phone1}</a></li>}
          {contactInfo.phone2 && <li><a href={`tel:${contactInfo.phone2.replace(/\s/g, '')}`}>{contactInfo.phone2}</a></li>}
          {contactInfo.email && <li><a href={`mailto:${contactInfo.email}`}>{contactInfo.email}</a></li>}
          {settings.social_links.map((link) => <li><a href={link.url} target="_blank" rel="noopener noreferrer">{link.platform}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>{t.footer.rights}</p>
      <div class="footer__legal">
        <a href={path('privacy', locale)}>{t.footer.privacy}</a>
        <a href={path('terms', locale)}>{t.footer.terms}</a>
        {settings.parent_company_url && <a href={settings.parent_company_url} target="_blank" rel="noopener">Longhorn Publishers PLC</a>}
      </div>
    </div>
  </div>
</footer>
