{
  "name": "longhorn-publishers-cm",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Bilingual corporate website for Longhorn Publishers Cameroon Ltd",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "build": "npm run typecheck && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --target es2022 --module esnext --moduleResolution bundler src/i18n/en.ts src/i18n/fr.ts src/data/site.ts src/data/presentation.ts",
    "audit:images": "node scripts/image-audit.mjs",
    "gen:image-sizes": "node scripts/gen-image-sizes.mjs",
    "test:product-code": "node --test tests/catalogue-product-code.test.mjs",
    "test:cms": "node --experimental-strip-types --test tests/cms-validation.test.mjs",
    "db:start": "node scripts/local-db.mjs start",
    "db:migrate": "node scripts/local-db.mjs migrate",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:url": "node scripts/local-db.mjs url",
    "verify:cms-parity": "node scripts/verify-cms-parity.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "test:demo-seed": "node --experimental-strip-types --test scripts/demo-seed.test.mjs"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.5",
    "@netlify/blobs": "^10.7.13",
    "@netlify/database": "^2.0.1",
    "@netlify/functions": "^6.0.0",
    "@netlify/identity": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "typescript": "^5.9.3"
  }
}
