{
  "name": "longhorn-publishers-cm",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Bilingual corporate website for Longhorn Publishers Cameroon Ltd",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run typecheck && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --target es2022 --module esnext --moduleResolution bundler src/i18n/en.ts src/i18n/fr.ts src/data/site.ts src/data/presentation.ts",
    "audit:images": "node scripts/image-audit.mjs",
    "gen:image-sizes": "node scripts/gen-image-sizes.mjs"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.5",
    "@netlify/blobs": "^10.7.13",
    "@netlify/database": "^2.0.1",
    "@netlify/functions": "^6.0.0",
    "@netlify/identity": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
